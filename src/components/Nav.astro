---
import { services } from '../data/services';

const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p + '/') ? 'active' : '';

const serviceList = Object.values(services);
---

<header class="nav" id="nav">
  <div class="container nav-inner">
    <a href="/" class="logo" data-cursor="link">
      <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id="lg1" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0" stop-color="#ff2a3c"/>
            <stop offset="1" stop-color="#8b0000"/>
          </linearGradient>
        </defs>
        <g class="shuriken-rotate">
          <path d="M32 4 L38 26 L60 32 L38 38 L32 60 L26 38 L4 32 L26 26 Z" fill="url(#lg1)" stroke="#ffd166" stroke-width="1.2"/>
          <circle cx="32" cy="32" r="4" fill="#0a0a0a" stroke="#ffd166" stroke-width="1"/>
        </g>
      </svg>
      <span class="logo-text"><b>NINJA</b><i>digital</i></span>
    </a>

    <nav class="nav-links" id="navLinks">
      <!-- Services with hover dropdown (click also navigates to /services) -->
      <div class="nav-dd">
        <a href="/services" class={`nav-trigger ${isActive('/services')}`} data-cursor="link">
          שירותים
          <svg class="nav-caret" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M7 10l5 5 5-5z"/></svg>
        </a>
        <div class="dd-panel">
          {serviceList.map((svc) => (
            <a href={`/services/${svc.slug}`} class="dd-item" data-cursor="link">{svc.title}</a>
          ))}
        </div>
      </div>

      <a href="/work" class={isActive('/work')} data-cursor="link">עבודות</a>
      <a href="/about" class={isActive('/about')} data-cursor="link">אודות</a>
      <a href="/blog" class={isActive('/blog')} data-cursor="link">בלוג</a>
      <a href="/portal/login" class="nav-portal" data-cursor="link" aria-label="כניסת לקוחות">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" style="vertical-align:-3px; margin-left:6px;">
          <path fill="currentColor" d="M12 2a5 5 0 00-5 5v3H6a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2v-8a2 2 0 00-2-2h-1V7a5 5 0 00-5-5zm-3 8V7a3 3 0 016 0v3H9z"/>
        </svg>
        כניסת לקוחות
      </a>
      <a href="/contact" class={`cta-mini ${isActive('/contact')}`} data-cursor="link" data-magnetic>דברו איתנו</a>
    </nav>

    <button class="burger" aria-label="פתח תפריט" id="burger">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style is:global>
  .nav-links a.active:not(.cta-mini) { color: var(--ink); }
  .nav-links a.active:not(.cta-mini)::after { width: 100%; }

  .nav-dd { position: relative; }

  /* Invisible hover bridge */
  .nav-dd::after {
    content: '';
    position: absolute;
    top: 100%; right: 0; left: 0;
    height: 18px;
  }

  .dd-panel {
    position: absolute;
    top: calc(100% + 18px);
    right: 50%;
    transform: translateX(50%) translateY(8px);
    min-width: 220px;
    background: linear-gradient(135deg, rgba(15,17,22,0.96), rgba(8,9,12,0.96));
    backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid var(--line-2);
    border-radius: 14px;
    padding: 8px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 0 60px rgba(255,42,60,0.08);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 220ms cubic-bezier(.16,1,.3,1), transform 220ms cubic-bezier(.16,1,.3,1), visibility 220ms;
    z-index: 200;
    display: flex;
    flex-direction: column;
  }
  .nav-dd:hover .dd-panel,
  .nav-dd:focus-within .dd-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(50%) translateY(0);
  }

  /* Decorative arrow on top */
  .dd-panel::before {
    content: '';
    position: absolute;
    top: -5px; right: 50%;
    transform: translateX(50%) rotate(45deg);
    width: 10px; height: 10px;
    background: rgba(15,17,22,0.96);
    border-top: 1px solid var(--line-2);
    border-right: 1px solid var(--line-2);
  }

  .dd-item {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    color: var(--ink-dim);
    font-size: 0.95rem;
    font-weight: 500;
    transition: 180ms cubic-bezier(.4,0,.2,1);
    text-decoration: none;
    white-space: nowrap;
  }
  .dd-item:hover {
    background: rgba(255,42,60,0.08);
    color: var(--ink);
    padding-right: 18px;
  }
  .dd-item::after { display: none !important; }

  /* Caret icon (next to "שירותים" trigger) */
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .nav-caret {
    transition: transform 220ms ease;
    opacity: 0.6;
  }
  .nav-dd:hover .nav-caret { transform: rotate(180deg); opacity: 1; color: var(--red); }

  /* Client portal login link — distinct from main nav, before the contact CTA */
  .nav-portal {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    color: var(--ink-dim);
    font-size: 0.92rem;
    font-weight: 500;
    transition: var(--t-fast);
    text-decoration: none;
  }
  .nav-portal:hover {
    color: var(--gold);
    border-color: var(--gold);
    background: rgba(255,209,102,0.06);
  }
  .nav-portal::after { display: none !important; }
</style>
