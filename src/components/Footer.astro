              <stop offset="0" stop-color="#ff2a3c"/>
              <stop offset="1" stop-color="#8b0000"/>
            </linearGradient>
          </defs>
          <g class="shuriken-rotate">
            <path d="M32 4 L38 26 L60 32 L38 38 L32 60 L26 38 L4 32 L26 26 Z" fill="url(#lg-footer)" stroke="#ffd166" stroke-width="1.2"/>
