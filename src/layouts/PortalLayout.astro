---
import '../styles/global.css';
import '../styles/portal.css';
import type { User } from '@supabase/supabase-js';

interface Props {
  title?: string;
  user?: User | null;
  clientName?: string | null;
  isAdmin?: boolean;
  hideNav?: boolean;
}

const {
  title = 'Client Portal — NINJA Digital',
  user = null,
  clientName = null,
  isAdmin = false,
  hideNav = false,
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p + '/') ? 'active' : '';
---

<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="theme-color" content="#08090c" />
<meta name="robots" content="noindex, nofollow" />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&family=Rubik:wght@400;500;600;700;800;900&family=Noto+Serif+JP:wght@900&display=swap" rel="stylesheet">

<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cpath d='M32 4 L38 26 L60 32 L38 38 L32 60 L26 38 L4 32 L26 26 Z' fill='%23ff2a3c' stroke='%23ffd166' stroke-width='2'/%3E%3Ccircle cx='32' cy='32' r='4' fill='%23000'/%3E%3C/svg%3E">
</head>
<body class="portal-shell">

<div class="noise"></div>
<div class="portal-atmosphere" aria-hidden="true">
  <div class="portal-orb portal-orb-red"></div>
  <div class="portal-orb portal-orb-gold"></div>
  <div class="portal-grid"></div>
</div>

{!hideNav && user && (
  <header class="portal-nav">
    <div class="container portal-nav-inner">
      <a href={isAdmin ? "/portal/admin" : "/portal/dashboard"} class="portal-nav-brand">
        <svg class="logo-mark" viewBox="0 0 64 64" aria-hidden="true">
          <defs>
            <linearGradient id="ploglg" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0" stop-color="#ff2a3c"/>
              <stop offset="1" stop-color="#8b0000"/>
            </linearGradient>
          </defs>
          <g class="shuriken-rotate">
            <path d="M32 4 L38 26 L60 32 L38 38 L32 60 L26 38 L4 32 L26 26 Z" fill="url(#ploglg)" stroke="#ffd166" stroke-width="1.2"/>
            <circle cx="32" cy="32" r="4" fill="#0a0a0a" stroke="#ffd166" stroke-width="1"/>
          </g>
        </svg>
        <div class="brand-text">
          NINJA<small>{clientName ?? 'Client Portal'}</small>
        </div>
      </a>

      <nav class="portal-nav-links" id="portalNavLinks">
        {isAdmin ? (
          <>
            <a href="/portal/admin" class={`portal-nav-link ${isActive('/portal/admin') && !path.includes('/clients/') ? 'active' : ''}`}>סקירה</a>
            <a href="/portal/admin#clients" class="portal-nav-link">לקוחות</a>
          </>
        ) : (
          <>
            <a href="/portal/dashboard" class={`portal-nav-link ${isActive('/portal/dashboard')}`}>סקירה</a>
            <a href="/portal/strategy" class={`portal-nav-link ${isActive('/portal/strategy')}`}>אסטרטגיה</a>
            <a href="/portal/site-audit" class={`portal-nav-link ${isActive('/portal/site-audit')}`}>אבחון אתר</a>
            <a href="/portal/quality-scores" class={`portal-nav-link ${isActive('/portal/quality-scores')}`}>ציוני איכות</a>
            <a href="/portal/reports" class={`portal-nav-link ${isActive('/portal/reports')}`}>דוחות</a>
            <a href="/portal/changes" class={`portal-nav-link ${isActive('/portal/changes')}`}>שינויים</a>
            <a href="/portal/search-terms" class={`portal-nav-link ${isActive('/portal/search-terms')}`}>מילות חיפוש</a>
          </>
        )}
        <form method="POST" action="/portal/auth/signout" class="portal-nav-signout-mobile">
          <button type="submit" class="portal-nav-link portal-nav-link-signout">יציאה</button>
        </form>
      </nav>

      <div class="portal-nav-actions">
        <div class="portal-user">
          <strong>{user.email}</strong>
        </div>
        <form method="POST" action="/portal/auth/signout" class="portal-nav-signout-desktop">
          <button type="submit" class="portal-signout">יציאה</button>
        </form>
        <button
          type="button"
          class="portal-nav-toggle"
          aria-label="פתיחת תפריט"
          aria-controls="portalNavLinks"
          aria-expanded="false"
          id="portalNavToggle"
        >
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
    <div class="portal-nav-backdrop" id="portalNavBackdrop" aria-hidden="true"></div>
  </header>
)}

{!hideNav && user && (
  <script is:inline>
    (() => {
      const btn = document.getElementById('portalNavToggle');
      const links = document.getElementById('portalNavLinks');
      const backdrop = document.getElementById('portalNavBackdrop');
      if (!btn || !links) return;
      const close = () => {
        document.body.classList.remove('portal-nav-open');
        btn.setAttribute('aria-expanded', 'false');
      };
      const toggle = () => {
        const open = document.body.classList.toggle('portal-nav-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      btn.addEventListener('click', toggle);
      backdrop?.addEventListener('click', close);
      links.querySelectorAll('a, button').forEach(el => el.addEventListener('click', close));
      document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
    })();
  </script>
)}

<main>
  <div class="container">
    <slot />
  </div>
</main>

{user && !isAdmin && (
  <a
    href="https://wa.me/972545822451?text=היי%20שרון%2C%20יש%20לי%20שאלה%20לגבי%20הקמפיין"
    class="wa-fab"
    aria-label="WhatsApp - זמין תמיד"
    target="_blank"
    rel="noopener"
  >
    <span class="wa-fab-pulse" aria-hidden="true"></span>
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
      <path fill="currentColor" d="M16 2C8.3 2 2 8.3 2 16c0 2.5.7 4.9 1.9 7L2 30l7.2-1.9c2 1.1 4.3 1.7 6.7 1.7 7.7 0 14-6.3 14-14S23.7 2 16 2zm8.2 19.7c-.3.9-2 1.7-2.7 1.8-.7.1-1.6.1-2.6-.2-.6-.2-1.4-.5-2.4-.9-4.2-1.8-7-6.1-7.2-6.4-.2-.3-1.7-2.3-1.7-4.5s1.1-3.2 1.5-3.6c.4-.5.9-.6 1.2-.6.3 0 .6 0 .9 0s.6-.1.9.7c.3.8 1.1 2.8 1.2 3 .1.2.1.4 0 .7-.1.3-.2.4-.4.6-.2.2-.4.5-.5.6-.2.2-.4.4-.2.7.2.3.9 1.5 2 2.5 1.4 1.2 2.5 1.6 2.9 1.8.3.2.6.1.8-.1.2-.2.9-1 1.1-1.4.2-.4.4-.3.7-.2.3.1 2 .9 2.4 1.1.4.2.6.3.7.4.1.2.1 1-.2 1.9z"/>
    </svg>
    <span class="wa-fab-tooltip">זמין תמיד 💬</span>
  </a>
)}

</body>
</html>

<style>
  /* ============================================================ */
  /* Portal atmosphere — radial gradients, orbs, grid (dim under data) */
  /* ============================================================ */
  .portal-atmosphere {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 40% at 50% -10%, rgba(255,42,60,0.10), transparent 60%),
      radial-gradient(ellipse 60% 40% at 100% 60%, rgba(255,209,102,0.04), transparent 70%);
  }
  .portal-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }
  .portal-orb-red {
    width: 520px; height: 520px;
    top: 8%; right: -200px;
    background: radial-gradient(circle, rgba(255,42,60,0.45), transparent 70%);
    opacity: 0.45;
    animation: portal-float-1 24s ease-in-out infinite;
  }
  .portal-orb-gold {
    width: 380px; height: 380px;
    bottom: 12%; left: -160px;
    background: radial-gradient(circle, rgba(255,209,102,0.30), transparent 70%);
    opacity: 0.35;
    animation: portal-float-2 30s ease-in-out infinite;
  }
  .portal-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.018) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.018) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 30%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 30%, black 30%, transparent 75%);
  }
  @keyframes portal-float-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-50px, 40px) scale(1.08); }
  }
  @keyframes portal-float-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(60px, -50px) scale(0.92); }
  }
  /* Lift content above atmosphere */
  .portal-nav, main { position: relative; z-index: 2; }

  /* ============================================================ */
  /* WhatsApp FAB                                                  */
  /* ============================================================ */
  .wa-fab {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 100;
    width: 58px; height: 58px;
    border-radius: 50%;
    background: linear-gradient(135deg, #25D366, #0e7c54);
    color: white;
    display: flex; align-items: center; justify-content: center;
    box-shadow:
      0 10px 28px rgba(37,211,102,0.40),
      0 0 0 1px rgba(255,255,255,0.04);
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 200ms ease;
    cursor: pointer;
  }
  .wa-fab::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ff2a3c, #ffd166);
    z-index: -1;
    opacity: 0.55;
    filter: blur(6px);
    transition: opacity 200ms;
  }
  .wa-fab:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow:
      0 16px 36px rgba(37,211,102,0.55),
      0 0 0 1px rgba(255,255,255,0.08);
  }
  .wa-fab:hover::before { opacity: 0.85; }

  .wa-fab-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(37,211,102,0.45);
    animation: wa-pulse 2.4s ease-out infinite;
    pointer-events: none;
    z-index: -1;
  }
  @keyframes wa-pulse {
    0%   { transform: scale(1);   opacity: 0.7; }
    80%  { transform: scale(1.7); opacity: 0;   }
    100% { transform: scale(1.7); opacity: 0;   }
  }

  .wa-fab-tooltip {
    position: absolute;
    left: 70px;
    top: 50%;
    transform: translateY(-50%) translateX(-6px);
    background: var(--bg-2, #11141b);
    color: var(--ink, #f5f5f7);
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 0.86rem;
    font-weight: 500;
    white-space: nowrap;
    border: 1px solid rgba(255,255,255,0.10);
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms, transform 180ms;
  }
  .wa-fab-tooltip::before {
    content: '';
    position: absolute;
    right: -5px; top: 50%;
    transform: translateY(-50%) rotate(45deg);
    width: 10px; height: 10px;
    background: var(--bg-2, #11141b);
    border-right: 1px solid rgba(255,255,255,0.10);
    border-top: 1px solid rgba(255,255,255,0.10);
  }
  .wa-fab:hover .wa-fab-tooltip {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (max-width: 540px) {
    .wa-fab { bottom: 16px; left: 16px; width: 52px; height: 52px; }
    .wa-fab-tooltip { display: none; }
  }
</style>
