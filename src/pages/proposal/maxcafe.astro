const findings = [
  {
    n: '01',
    title: 'החשבון המושבת הוא נכס, לא חוב',
    body: 'לחשבון קיים יש ותק, היסטוריית קליקים ואיתותים שגוגל כבר צבר — ובנייה על גביו יוצאת לדרך מהר יותר מאשר חשבון חדש לגמרי. מה שכן צריך בדיקה: מדידת ההמרות, שנוטה להישבר כשחשבון עומד, והמבנה הישן שברוב המקרים כבר לא רלוונטי לפורמטים של היום.',
  },
  {
    n: '02',
    title: 'הקטלוג הוא המנוע — לא הקטגוריה',
    body: 'האתר מחזיק למעלה מ-100 מותגים, עם סינון לפי אחוז ערביקה, גודל אריזה, תאימות קפסולה, סוג משאבה וסוג חימום. זה בדיוק סוג הקטלוג ש-Shopping ו-Performance Max נבנו בשבילו: כל דגם ספציפי הוא מילת חיפוש בפני עצמה, והוא זול בהרבה מהמילה הכללית.',
  },
  {
    n: '03',
    title: 'בראש הפירמידה אי אפשר לנצח בכסף',
    body: '"מכונת קפה" ו"מכונת אספרסו" הן זירה של KSP, Pay&Go, אייבורי וזאפ — שחקנים עם תקציבי מדיה גדולים פי עשרות. תקציב של 3,500 ₪ שנשפך למילים האלה נשרף בלי מכירה. האסטרטגיה כאן היא ההפך: לתפוס את הזנב הארוך של הדגמים, המותגים והצרכים הספציפיים, שם התחרות נמוכה וכוונת הקנייה גבוהה בהרבה.',
