// החלטות שהן של הלקוח
const decisions = [
  {
    title: 'הרשאות גישה',
    body: 'חשבון הגוגל אדס הקיים (קישור ל-MCC שלנו), Google Analytics 4, Merchant Center, ניהול חנות Shopify לצורך הפיד ותגי המדידה, ו-Google Business Profile של החנות בפתח תקווה — לצורך הרחבות מיקום ואיסוף עצמי במודעות המכירה בלבד. בלי אלה חלק מהעבודה הופכת להמלצה במקום לביצוע.',
  },
  {
    title: 'מדיניות משלוחים והחזרות',
    body: 'Merchant Center לא מאשר חשבון בלי מדיניות משלוחים ומדיניות החזרות מוצהרות, נגישות באתר ותואמות למה שמוזן במערכת. אם הן חסרות או לא מדויקות — זה חוסם את כל השופינג, ולכן צריך לסגור את זה לפני העלייה לאוויר.',
  },
  {
    title: 'אמצעי תשלום ובעלות על החשבון',
    body: 'תקציב המדיה משולם על ידי מקס קפה בע״מ ישירות לגוגל, מאמצעי תשלום של החברה שמוזן בחשבון הגוגל אדס של החברה. NINJA Digital אינה גובה, אינה מחזיקה ואינה מעבירה את תקציב המדיה בשום שלב. אנחנו מנהלים, אתם הבעלים — ואם ההתקשרות מסתיימת, החשבון, ההיסטוריה והנתונים נשארים אצלכם במלואם.',
  },
  {
    title: 'מוצרים במחיר 0 ₪ באתר',
    body: 'בסריקה של הקטלוג עלו מוצרים ללא מחיר. אלה נפסלים אוטומטית ב-Merchant Center, ובכמות גדולה יכולים לגרור אזהרה על החשבון. צריך להחליט אם מסירים אותם מהפיד או מתמחרים אותם.',
  },
];

const today = new Date().toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Layout
  title="הצעת מחיר · ניהול גוגל אדס · מקס קפה בע״מ — NINJA Digital"
  description="הצעת מחיר לניהול קמפיין Google Ads לשטרנ׳ס קפה — sterns.co.il. מפת קמפיינים, תוכנית עבודה, מדידה ותמחור."
  noindex={true}
  hideFloatWA={true}
  hideNav={true}
>

<section class="proposal-hero">
  <div class="container">
    <span class="eyebrow">הצעת מחיר · NINJA Digital</span>
    <h1>גוגל אדס ל<em>שטרנ׳ס קפה</em>.</h1>
    <p class="lede">
      <strong>שלושה מנועים: Google Shopping, Performance Max וקמפיין חיפוש.</strong>
      זו כל ההצעה, ואין בה שום דבר אחר. המטרה היא להפוך תקציב מדיה של {MEDIA} ₪ בחודש
      למכירות שאפשר למדוד — ולא לקליקים.
      לשטרנ׳ס יש בדיוק את הצירוף שהמנועים האלה עובדים עליו הכי טוב: קטלוג עמוק עם למעלה מ-100 מותגים,
      סל ממוצע גבוה, ואתר Shopify שמזין פיד מוצרים בלחיצת כפתור.
      ההצעה מפרטת מה בונים, באיזה סדר, איך מודדים ובכמה. תקפה ל-30 יום מתאריך השליחה.
    </p>

    <div class="meta">
      <div><span>לקוח</span><strong>מקס קפה בע״מ</strong></div>
      <div><span>ח.פ</span><strong>516972585</strong></div>
      <div><span>נכס</span><strong>sterns.co.il</strong></div>
      <div><span>שירות</span><strong>Google Ads · ניהול חודשי</strong></div>
      <div><span>תאריך</span><strong>{today}</strong></div>
    </div>
  </div>
</section>

<section class="state">
  <div class="container">
    <span class="eyebrow">נקודת הפתיחה</span>
    <h2>הנכסים כבר קיימים. מה שחסר הוא המנוע.</h2>
    <p class="lede">
      ההצעה הזו נבנתה על סריקה של האתר ועל מפת התחרות בשוק הקפה בישראל — לא על נתוני החשבון,
      שאליו עדיין אין לנו גישה. <strong>זה מכוון, ואנחנו אומרים את זה מראש:</strong> אנחנו לא מציגים
      מספרים שלא ראינו. האודיט של החשבון הקיים הוא הפעולה הראשונה בתוכנית העבודה,
      והממצאים ממנו יוצגו לכם במלואם בסוף השבועיים הראשונים.
    </p>

    <div class="kpis">
      {kpis.map((k) => (
        <div class="kpi">
          <div class="k">{k.k}</div>
          <div class="v">{k.v}</div>
          <div class={`d ${k.tone}`}>{k.d}</div>
        </div>
      ))}
    </div>
    <p class="src">מקור: סריקה של sterns.co.il · ספטמבר 2026 · קטלוג, סייטמאפ, מבנה קטגוריות ומיפוי מתחרים</p>
  </div>
</section>

<section class="findings">
  <div class="container">
    <span class="eyebrow">מה מצאנו</span>
    <h2>שישה דברים שקובעים את האסטרטגיה.</h2>
    <div class="finds">
      {findings.map((f) => (
        <div class="find">
          <div class="fn">{f.n}</div>
          <div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="callout">
      <h4>המשפט שמסכם את כל השאר</h4>
      <p>
        עם {MEDIA} ₪ בחודש אי אפשר לנצח את KSP על "מכונת קפה", ואין טעם לנסות.
        <strong>אפשר בהחלט להיות התוצאה הראשונה על "Lelit Bianca מחיר", על "פולי קפה קלויים טרי",
        ועל "кофемашина для дома"</strong> —
        וזה בדיוק הקהל שקונה, לא מתלבט.
      </p>
    </div>
  </div>
</section>

<section class="engines">
  <div class="container">
    <span class="eyebrow">הליבה</span>
    <h2>שלושה מנועי מכירה. זה כל הסיפור.</h2>
    <p class="lede">
      ההצעה הזו היא <strong>מכירות בלבד</strong>. אין בה קידום אורגני, אין בה תוכן, ואין בה
      קמפיינים שמביאים פניות שירות או תיקונים — חיפושים כאלה נחסמים כמילים שליליות מהיום הראשון,
      כדי שכל שקל מהתקציב ילך לקונה. שלושת המנועים למטה הם מה שמייצר את המכירות,
      וכל השאר בהצעה קיים רק כדי לשרת אותם.
    </p>

    <div class="eng-grid">
      {engines.map((e) => (
        <div class="eng-card">
          <span class="eng-tag">{e.tag}</span>
          <h3>{e.name}</h3>
          <p class="eng-line">{e.line}</p>
          <p>{e.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="gaps">
  <div class="container">
    <span class="eyebrow">מפת הקמפיינים</span>
    <h2>איך זה מתפרק לקמפיינים בחשבון.</h2>
    <p class="lede">
      שלושת המנועים למעלה מתורגמים לשישה קמפיינים נפרדים, כל אחד עם קהל, תקציב ויעד משלו.
      הם נפתחים לפי הסדר שבעמודה האחרונה — כי קמפיין שנפתח לפני שהמדידה שלו מוכנה
      שורף כסף בלי ללמד כלום. <strong>כל שורה כאן מסתיימת ברכישה באתר.</strong>
    </p>

    <div class="tscroll">
      <table>
        <thead>
          <tr>
            <th>סוג קמפיין</th>
            <th>על מה הוא רץ</th>
            <th>למה הוא שם</th>
            <th class="num">שלב</th>
          </tr>
        </thead>
        <tbody>
          {campaigns.map((c) => (
            <tr>
              <td class="kw">{c.type}</td>
              <td class={c.query ? 'url' : 'miss'}>{c.target}</td>
              <td class="miss">{c.why}</td>
              <td class="num accent">{c.prio}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="plan">
  <div class="container">
    <span class="eyebrow">תוכנית עבודה</span>
    <h2>בסדר הזה — לא אחרת.</h2>
    <p class="lede">
      <strong>השבועיים הראשונים לא מוציאים כסף על מדיה.</strong> הם בונים את המדידה,
      את הפיד ואת ה-Merchant Center. זה לא עיכוב — זו הסיבה שהתקציב מחודש שני והלאה
      עובד. קמפיין שרץ בלי מדידת המרות תקינה הוא לא קמפיין, הוא תרומה לגוגל.
    </p>

    {phases.map((p) => (
      <article class="phase">
        <header>
          <span class="pn">{p.n}</span>
          <h3>{p.title}</h3>
          <span class="when">{p.when}</span>
        </header>
        <ul>
          {p.items.map((i) => <li set:html={i} />)}
        </ul>
      </article>
    ))}

    <p class="plan-note">
      מחודש 5 והלאה העבודה עוברת לקצב שוטף: הרחבה עונתית, בדיקות מודעות ונכסים,
      העשרת הפיד, והחלטות תקציב לפי רווחיות בפועל לכל קטגוריה.
    </p>
  </div>
</section>

<section class="included">
  <div class="container">
    <span class="eyebrow">מה נכנס בכל חודש</span>
    <h2>שלושה דברים שקורים תמיד.</h2>
    <div class="inc-grid">
      {monthly.map((m) => (
        <div class="inc-card">
          <div class="inc-icon" aria-hidden="true">
            {m.icon === 'wrench' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.7 6.3a4 4 0 0 1-5 5L4 17v3h3l5.7-5.7a4 4 0 0 1 5-5l2.3-2.3-3-3-2.3 2.3z"/></svg>
            )}
            {m.icon === 'radar' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/><path d="M12 12 19 7"/></svg>
            )}
            {m.icon === 'report' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
            )}
          </div>
          <h3>{m.title}</h3>
          <p>{m.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="metrics">
  <div class="container">
    <span class="eyebrow">איך מודדים</span>
    <h2>שמונה מדדים — ואף אחד מהם הוא לא "קליקים".</h2>
    <p class="lede">
      חלק מהמדדים כאן רשומים היום כ"לא נמדד" בכוונה, כי אין לנו עדיין גישה לחשבון
      ואנחנו לא ממציאים נקודת פתיחה. <strong>בסוף חודש 1 כל שורה בטבלה תקבל מספר,
      וממנו והלאה נמדד מולו כל חודש.</strong> מה שכן נאמר כבר עכשיו: אנחנו לא מבטיחים ROAS.
      אף אחד לא יכול, וכל מי שמבטיח מוכר לכם משהו אחר.
    </p>

    <div class="tscroll">
      <table>
        <thead>
          <tr><th>מדד</th><th class="num">היום</th><th>למה הוא נבחר</th></tr>
        </thead>
        <tbody>
          {metrics.map((m) => (
            <tr>
              <td class="kw">{m.m}</td>
              <td class="num accent">{m.now}</td>
              <td class="miss">{m.why}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="decisions">
  <div class="container">
    <span class="eyebrow">לפני שמתחילים</span>
    <h2>ארבע החלטות שהן שלכם.</h2>
    <div class="dec-grid">
      {decisions.map((d) => (
        <div class="dec-card">
          <h3>{d.title}</h3>
          <p>{d.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="price">
  <div class="container">
    <span class="eyebrow">סיכום עלות</span>
    <h2>דמי ניהול חודשיים. בלי תשלום הקמה.</h2>
    <div class="price-card">
      <div class="price-row">
        <span>ניהול Google Ads — אסטרטגיה, בנייה, אופטימיזציה ומדידה</span>
        <strong>{LIST && <s class="was">{LIST} ₪</s>}{MONTHLY} ₪ / חודש</strong>
      </div>
      <div class="price-row sub"><span>אודיט לחשבון הקיים ותוכנית עבודה</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>הקמת Merchant Center, חיבור הפיד וניקויו</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>הקמת מדידת המרות, GA4 ו-Enhanced Conversions</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>כתיבת מודעות, נכסים ומילות מפתח</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>דוח חודשי ושיחת עבודה</span><strong>כלול</strong></div>
      <div class="price-row sub timeline"><span>תקופת התחייבות</span><strong>ללא — חודש לחודש</strong></div>
      <div class="price-row total">
        <span>סה״כ חודשי, כולל מע״מ</span>
        <strong>{LIST && <s class="was">{LIST} ₪</s>}{MONTHLY} ₪</strong>
      </div>
      <p class="price-note">
        המחיר כולל מע״מ. חיוב חודשי בהוראת קבע או בהעברה בנקאית, בתחילת כל חודש עבודה.
        ההתקשרות היא מחודש לחודש, ללא תקופת התחייבות, וניתנת לסיום בהודעה של 30 יום מראש משני הצדדים.
        <strong>תקציב המדיה אינו כלול בסכום זה</strong> ומחויב ישירות על ידי גוגל — הפירוט בסעיף הבא.
        חשוב לסייג: קמפיין גוגל אדס לומד. החודש-חודשיים הראשונים הם שלב איסוף נתונים,
        והרווחיות מתייצבת אחרי שהאלגוריתם צבר מספיק המרות. עצירה בשלב הזה מאפסת את הלמידה.
      </p>
      {!PRICE_SET && (
        <p class="price-todo">⚠︎ טרם הוזן מחיר. לעדכן את <code>MONTHLY</code> בראש הקובץ לפני שליחה ללקוח.</p>
      )}
    </div>

    <div class="extras">
      <div class="extras-head">
        <span class="extras-tag">הוצאה נפרדת</span>
        <h3>תקציב המדיה — {MEDIA} ₪ בחודש</h3>
      </div>
      <p>
        זהו הכסף שמשולם לגוגל עבור הקליקים עצמם, והוא נפרד לחלוטין מדמי הניהול.
        הוא לא עובר דרכנו ואנחנו לא גובים עליו עמלה.
      </p>
      <ul class="extras-list">
        <li><strong>משולם על ידכם ישירות לגוגל.</strong> אמצעי תשלום של מקס קפה בע״מ מוזן בחשבון הגוגל אדס של החברה, וגוגל מחייבת את החברה ישירות. הכסף לא עובר דרך NINJA Digital בשום שלב — אין תיווך, אין גבייה ואין תוספת מחיר.</li>
        <li><strong>החשבון בבעלותכם המלאה.</strong> אנחנו מקבלים הרשאת ניהול דרך ה-MCC של הסוכנות. בסיום ההתקשרות ההרשאה מוסרת, והחשבון על כל ההיסטוריה שלו נשאר אצלכם.</li>
        <li><strong>ניתן לשינוי בכל חודש.</strong> {MEDIA} ₪ הוא נקודת הפתיחה המומלצת. אם קטגוריה מוכיחה רווחיות — ההמלצה תהיה להגדיל; אם לא — נצמצם. ההחלטה תמיד שלכם ומראש.</li>
        <li><strong>שקוף עד השקל.</strong> בכל דוח חודשי מופיע בדיוק כמה הוצא, על מה, ומה חזר.</li>
      </ul>
    </div>
  </div>
</section>

<section class="sign">
  <div class="container">
    <span class="eyebrow">אישור הצעה</span>
    <h2>אם המחיר ותיאור העבודה מקובלים, חתמו כאן.</h2>
    <p class="lede">אישור ההצעה ישלח התראה במייל ואחזור אליכם לתיאום הקיק-אוף והרשאות הגישה.</p>

    <form id="proposal-sign" class="sign-card">
      <div class="field-row">
        <div class="field">
          <label for="name">שם מלא</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">אימייל</label>
          <input id="email" name="email" type="email" required autocomplete="email" dir="ltr" />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="phone">טלפון</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" dir="ltr" />
        </div>
        <div class="field">
          <label for="title">תפקיד</label>
          <input id="title" name="title" type="text" placeholder="לדוגמה: מנכ״ל, בעלים" />
        </div>
      </div>

      <fieldset class="confirms">
        <label class="check">
          <input type="checkbox" name="confirm_scope" required />
          <span>אני מאשר את היקף העבודה שתואר בהצעה, כולל מפת הקמפיינים, תוכנית העבודה והגבולות שצוינו.</span>
        </label>
        <label class="check">
