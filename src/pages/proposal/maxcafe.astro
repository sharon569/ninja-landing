  { m: 'ROAS לפי קטגוריה', now: 'לא נמדד היום', why: 'מכונות, קפה וקפסולות הם שלושה עסקים שונים עם מרווח שונה. יעד אחד לכולם הוא טעות.' },
  { m: 'עלות לרכישה (CPA)', now: 'לא נמדד היום', why: 'נמדד בנפרד למכונה ולקפה, כי הערך לאורך חיי הלקוח שונה לגמרי.' },
  { m: 'מוצרים מאושרים ב-Merchant Center', now: '0 — לא מוקם', why: 'התנאי הטכני לכל Shopping ו-Performance Max. מוצר פסול הוא מוצר שלא קיים.' },
  { m: 'שיעור התנועה המותגית', now: 'לא נמדד היום', why: 'אם רוב ההמרות מגיעות מהשם שלכם, הקמפיין לא באמת מייצר לקוחות חדשים. זה המדד שמונה אותנו על עצמנו.' },
