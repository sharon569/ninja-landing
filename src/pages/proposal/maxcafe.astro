    ],
  },
  {
    n: 'חודש 4 והלאה',
    title: 'לעבור ממחזור לרווח',
    when: 'אופטימיזציה שוטפת',
    items: [
      '<strong>מעבר לאסטרטגיות הצעה חכמות</strong> (tROAS) ברגע שהצטברו מספיק המרות — לפני זה זה פשוט מזיק.',
