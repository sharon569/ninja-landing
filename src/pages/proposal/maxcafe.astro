---
import Layout from '../../layouts/Layout.astro';

/* ---------------------------------------------------------------------------
 * מחיר — נקבע מול שרון: 1,500 ₪ לחודש כולל מע״מ.
 * MONTHLY הוא המחיר בפועל. LIST הוא מחיר מחירון שמוצג מחוק לידו —
 * להשאיר ריק כדי להסתיר אותו לגמרי, או למלא (למשל '2,500') כדי להציג.
 * MEDIA הוא תקציב המדיה החודשי שהולך ישירות לגוגל — לא עובר דרכנו.
 * ------------------------------------------------------------------------- */
const MONTHLY = '1,500';
const LIST = '';            // ריק = לא מוצג מחיר מחירון מחוק
const MEDIA = '3,500';
const PRICE_SET = !MONTHLY.includes('X');

// מה שנמצא בסריקה של האתר — עובדות, לא הערכות
const kpis = [
  { k: 'מותגים בקטלוג', v: '100+', d: 'מ-Lavazza ועד Rocket', tone: 'flat' },
  { k: 'מוצר יקר ביותר', v: '34,200 ₪', d: 'סל ממוצע גבוה במיוחד', tone: 'up' },
