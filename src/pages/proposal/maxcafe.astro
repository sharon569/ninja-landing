  { m: 'ערך הזמנה ממוצע', now: 'לא נמדד היום', why: 'עם קטלוג שנע עד 34,200 ₪, ממוצע לבדו מטעה. נמדד גם החציון ופילוח לפי טווח מחיר.' },
  { m: 'רכישה חוזרת של קפה', now: 'לא נמדד היום', why: 'זה מה שמצדיק את מחיר רכישת הלקוח. בלי המדד הזה הקמפיין ייראה יקר מכפי שהוא באמת.' },
