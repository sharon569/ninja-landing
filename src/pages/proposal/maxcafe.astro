    tag: 'מנוע 1',
    name: 'Google Shopping',
    line: 'המוצר, התמונה והמחיר — בראש תוצאות החיפוש.',
    body: 'הפורמט שמוכר הכי טוב לחנות אונליין, כי הקונה רואה את המכונה ואת המחיר לפני שהוא בכלל לוחץ. מי שמגיע מכאן כבר יודע מה הוא קונה ובכמה. הדלק שלו הוא הפיד — ולכן ניקוי הפיד וה-Merchant Center הם הפעולה הראשונה בתוכנית.',
  },
  {
    tag: 'מנוע 2',
    name: 'Performance Max',
    line: 'הקטלוג המלא, על כל שטחי הפרסום של גוגל.',
    body: 'לוקח את אותו פיד ופורש אותו על חיפוש, שופינג, יוטיוב, ג׳ימייל ודיספליי, ומוצא בעצמו את הדגם הנכון לחיפוש הנכון. עם 100+ מותגים בקטלוג זה בדיוק המקרה שבו האוטומציה מנצחת ניהול ידני — בתנאי שהיא מפוצלת לקבוצות נכסים לפי קטגוריה, ולא נזרקת כקמפיין אחד.',
  },
  {
    tag: 'מנוע 3',
    name: 'קמפיין חיפוש',
    line: 'הדגם המבוקש, במילים המדויקות של הקונה.',
    body: 'כאן נתפס הזנב הארוך: "Lelit Bianca מחיר", "Jura E8 ביקורת", "פולי קפה קלויים טרי". CPC נמוך, כוונת קנייה מקסימלית, וסל ממוצע גבוה. זה גם המנוע שמגן על השם שלכם מפני מתחרים שקונים אותו בזול.',
  },
];

// מפת הקמפיינים — מה נבנה, למי, ולמה
const campaigns = [
  {
    type: 'Brand · הגנה על השם',
    target: '"שטרנ׳ס", "שטרנס קפה", "sterns coffee"',
    why: 'מי שמחפש אתכם בשם כבר החליט. מתחרים ומשווקי שותפים קונים את המילה הזו בזול, וזו התנועה הזולה והרווחית ביותר שיש.',
    prio: 'ראשון',
  },
  {
    type: 'Performance Max · קטלוג',
    target: 'כל הקטלוג, דרך פיד Shopify המחובר ל-Merchant Center',
    why: 'המנוע המרכזי. גוגל מוצא בעצמו את הדגם הנכון לחיפוש הנכון, על פני חיפוש, שופינג, יוטיוב ודיספליי — בתנאי שהפיד נקי.',
    prio: 'ראשון',
  },
  {
    type: 'Search · דגמים ומותגים',
    target: 'Jura, Delonghi, Lelit, ECM, Rocket, Gaggia + שם דגם',
    why: 'הזנב הארוך. CPC נמוך, כוונת קנייה גבוהה, וסל ממוצע גבוה. כאן נמצא הרווח האמיתי בתקציב הזה.',
    prio: 'ראשון',
  },
  {
    type: 'Search · קפה, פולים וקפסולות',
    target: '"פולי קפה טריים", "קפה קלוי טרי", קפסולות תואמות',
    why: 'סל נמוך אבל חוזר. בית הקלייה הוא היתרון התחרותי, וזה גם מה שמייצר את ההכנסה החוזרת שמצדיקה את מחיר הרכישה של לקוח מכונה.',
    prio: 'שני',
  },
  {
    type: 'Search · רוסית',
    target: 'кофемашина · кофе в зернах · капсулы + מותגים',
    query: true,
    why: 'שוק שכמעט אף אחד לא מפרסם בו בישראל, מול אתר שכבר קיים ברוסית. CPC נמוך מאוד ביחס לעברית.',
    prio: 'שני',
  },
  {
    type: 'Demand Gen / רימרקטינג',
    target: 'נטישות עגלה, צופי מוצר, לקוחות קיימים',
