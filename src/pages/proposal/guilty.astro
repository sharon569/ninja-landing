const fmt = (n: number) => n.toLocaleString('he-IL');

// מה שנמצא בסריקה של האתר — עובדות, לא הערכות
const kpis = [
  { k: 'מוצרים באתר', v: '2,500+', d: 'לפי מפת האתר', tone: 'up' },
  { k: 'מותגים', v: '280+', d: 'מ-K18 ועד Charlotte Tilbury', tone: 'up' },
  { k: 'כתבות מגזין', v: '460+', d: 'תוכן שמחכה להפצה', tone: 'up' },
