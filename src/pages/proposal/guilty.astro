/* =========================== מודול B — FLASHY =========================== */
const flows = [
  { flow: 'Welcome Series', trigger: 'הרשמה לניוזלטר / פתיחת חשבון', why: 'הרגע עם הפתיחות הגבוהות ביותר בכל מחזור החיים. 3–4 הודעות שמציגות את גילטי, את המותגים ואת המועדון — ומובילות לרכישה ראשונה.' },
  { flow: 'נטישת עגלה', trigger: 'מוצר בעגלה, ללא רכישה', why: 'האוטומציה הרווחית ביותר בכל חנות אונליין. מייל + SMS בתזמון מדורג, עם תזכורת לסף המשלוח החינמי.' },
  { flow: 'נטישת גלישה', trigger: 'צפייה במוצר, ללא הוספה לעגלה', why: 'הלקוחה התעניינה ולא החליטה. תזכורת עדינה עם המוצר עצמו ועם מוצרים דומים.' },
  { flow: 'אחרי רכישה', trigger: 'הזמנה הושלמה', why: 'תודה, טיפים לשימוש במוצר, בקשת ביקורת והמלצות משלימות — הלקוחה ממשיכה לשמוע מכם גם כשהיא לא קונה.' },
  { flow: 'חידוש מלאי', trigger: 'X ימים מרכישה, לפי מחזור המוצר', why: 'הלב של המודול. תזכורת בדיוק כשהמוצר עומד להיגמר — רכישה חוזרת בלי שקל של מדיה.' },
  { flow: 'Win-back', trigger: 'לא רכשה 90 / 180 יום', why: 'לקוחה רדומה זולה פי כמה להחזיר מאשר לגייס חדשה. סדרה מדורגת עם הטבה עולה.' },
  { flow: 'יום הולדת', trigger: 'תאריך לידה בפרופיל', why: 'אחוזי הפתיחה וההמרה מהגבוהים שיש. הטבה אישית שנשלחת לבד, כל שנה.' },
  { flow: 'VIP ולקוחות מובילות', trigger: 'סף רכישה מצטבר', why: 'גישה מוקדמת למבצעים ולקולקציות, והכרה בלקוחות שמחזיקות את רוב ההכנסה.' },
  { flow: 'חזרה למלאי / ירידת מחיר', trigger: 'מוצר שאזל חזר / ירד מחיר', why: 'הלקוחה כבר רצתה את המוצר. ההודעה נשלחת ברגע שהוא זמין שוב.' },
];

