---
import Layout from '../../layouts/Layout.astro';

/* ---------------------------------------------------------------------------
 * הצעה מודולרית — הלקוח מסמן אילו מודולים נכנסים, והמחיר מתעדכן בזמן אמת.
 * מחירים לפני מע״מ (נקבע מול שרון): 2,500 ₪ לכל מודול, בלי הנחת חבילה,
 * בלי דמי הקמה, בלי התחייבות. חיוב חודשי בכרטיס אשראי.
 * MEDIA — תקציב המדיה המומלץ לגוגל, משולם ישירות לגוגל ולא עובר דרכנו.
 * VAT — שיעור המע״מ בישראל.
 * ------------------------------------------------------------------------- */
const VAT = 0.18;
const MEDIA = '5,000';

const MODULES = [
  {
    id: 'performance',
    tag: 'מודול A',
    name: 'Google Ads · Performance',
    line: 'מנוע הרכישה: לקוחות חדשות, מכירות מדידות.',
    price: 2500,
    points: [
      'Performance Max · Shopping · Search · Demand Gen',
      'Merchant Center והפיד — הקמה, ניקוי והעשרה',
      'מדידת המרות עם ערך דינמי ו-Enhanced Conversions',
      'לוח קמפיינים עונתי ודוח חודשי',
    ],
