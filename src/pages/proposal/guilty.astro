  { type: 'Search · מותג + מוצר', target: 'שם מותג + שם מוצר / "מחיר" / "קנייה"', why: 'הזנב הארוך. CPC נמוך, כוונת קנייה מקסימלית, ומודעות שמדברות בדיוק על המוצר שחיפשו.', prio: 'ראשון' },
  { type: 'Search · קטגוריות וצרכים', target: '"קוסמטיקה קוריאנית", "טיפוח לשיער פגום", "מכחולי איפור"', why: 'החיפושים שעוד לא בחרו מותג — כאן גילטי מתחרה על הקטגוריה, עם עמודי קטגוריה ותוכן מגזין כנחיתה.', prio: 'שני' },
  { type: 'Demand Gen · ויזואלי', target: 'יוטיוב, Shorts, Discover, ג׳ימייל', why: 'ביקוש חדש: קולקציות משפיעניות, Mikaella ומבצעים עונתיים מול קהלים בעלי עניין ביופי.', prio: 'שני' },
  { type: 'רימרקטינג דינמי', target: 'צופות מוצר, נוטשות עגלה, לקוחות עבר', why: 'מראה ללקוחה בדיוק את המוצר שהיא ראתה — הדרך הזולה ביותר לסגור מכירה שכבר שולם עליה קליק.', prio: 'שני' },
];

const adsPhases = [
  {
    n: 'שבועות 1–2',
    title: 'לבנות את המדידה ואת הפיד',
    when: 'תשתית · אודיט',
    items: [
      '<strong>אודיט לחשבון Google Ads הקיים</strong> (אם יש) — מבנה, היסטוריה, מה עבד ומה נשבר.',
      '<strong>מדידת המרות עם ערך דינמי</strong> — רכישה עם הכנסה בפועל, Enhanced Conversions, ומעבר מסודר מ-Universal Analytics ל-GA4 דרך ה-GTM הקיים.',
      '<strong>Merchant Center</strong> — חיבור הפיד מהאתר, אימות דומיין, מדיניות משלוחים והחזרות, ותיקון מוצרים שנפסלו (GTIN, מותג, תמונות, מחירים).',
