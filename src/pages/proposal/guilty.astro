  { mod: 'performance', m: 'שיעור התנועה המותגית', why: 'אם רוב ההמרות מגיעות מחיפוש "גילטי", הקמפיין לא באמת מייצר לקוחות חדשים.' },
  { mod: 'performance', m: 'מוצרים מאושרים ב-Merchant Center', why: 'התנאי הטכני לכל Shopping ו-Performance Max. מוצר פסול הוא מוצר שלא קיים.' },
  { mod: 'flashy', m: 'הכנסה מדיוור (% מסך ההכנסות)', why: 'המדד הראשי ב-Flashy. כמה מהמחזור מגיע מאוטומציות ומקמפיינים.' },
  { mod: 'flashy', m: 'הכנסה לנמען', why: 'מנרמל את ההכנסה לגודל הרשימה — כדי שרשימה גדלה לא תסתיר ביצועים שיורדים.' },
  { mod: 'flashy', m: 'שיעור רכישה חוזרת', why: 'המדד שאוטומציית חידוש המלאי נבנתה בשבילו.' },
  { mod: 'flashy', m: 'גדילת רשימה נטו ושיעור הסרה', why: 'רשימה שגדלה אבל נשחקת היא לא נכס. שיעור הסרה גבוה אומר ששולחים יותר מדי או לא לסגמנט הנכון.' },
