  },
  {
    tag: 'מנוע 3',
    name: 'Demand Gen · יוטיוב',
    line: 'ויזואלי, לפני שהיא בכלל חיפשה.',
    body: 'יופי הוא קטגוריה ויזואלית. Demand Gen מציג קרוסלות מוצרים וסרטונים קצרים ביוטיוב, ב-Shorts, ב-Discover ובג׳ימייל — עם הקולקציות של המשפיעניות ושל Mikaella כנכס יצירתי מוכן. זה המנוע שמייצר ביקוש חדש, ולא רק קוצר את הקיים.',
  },
];

const campaigns = [
  { type: 'Brand · הגנה על השם', target: '"גילטי", "guilty", "גילטי קוסמטיקס"', why: 'מי שמחפשת אתכם בשם כבר החליטה. זו התנועה הזולה והרווחית ביותר, ומתחרים קונים אותה אם אתם לא שם.', prio: 'ראשון' },
  { type: 'Performance Max · קטלוג', target: 'כל הפיד, מפוצל לקבוצות נכסים לפי קטגוריה ומרווח', why: 'המנוע המרכזי. פיצול לפי קטגוריה הוא מה שמאפשר לשלוט בתקציב לפי רווחיות ולא לפי מה שהאלגוריתם מעדיף.', prio: 'ראשון' },
