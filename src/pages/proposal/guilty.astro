  { mod: 'performance', title: 'הרשאות Google', body: 'חשבון Google Ads (קישור ל-MCC שלנו), Google Analytics 4, Google Tag Manager ו-Merchant Center. בלעדיהן חלק מהעבודה הופכת להמלצה במקום לביצוע.' },
  { mod: 'performance', title: 'פיד מוצרים מהאתר', body: 'האתר בנוי על פלטפורמה ייעודית (IWP). צריך לוודא שהיא מייצאת פיד מוצרים מלא — מחיר, מלאי, GTIN, מותג ותמונות — או לתאם איתה את הפקתו.' },
  { mod: 'flashy', title: 'הרשאות Flashy', body: 'הרשאת משתמש מלאה בחשבון Flashy, וגישה להגדרות ה-DNS של הדומיין לצורך אימות השולח.' },
  { mod: 'flashy', title: 'נכסים ומבצעים', body: 'גישה לתמונות מוצר ולנכסי מותג, ולוח מבצעים חודשי מצד גילטי — כדי שכל ניוזלטר ו-SMS ייצאו מתואמים למה שקורה באתר ובחנויות.' },
