<script is:inline define:vars={{ MODULES, VAT, MEDIA }}>
(() => {
  const nf = (n) => Math.round(n).toLocaleString('he-IL');
  const selected = new Set(MODULES.map((m) => m.id));

  function render() {
    const chosen = MODULES.filter((m) => selected.has(m.id));
    const net = chosen.reduce((s, m) => s + m.price, 0);
    const vat = net * VAT;

    document.querySelectorAll('[data-module-toggle]').forEach((el) => {
      el.checked = selected.has(el.getAttribute('data-module-toggle'));
    });
    document.querySelectorAll('[data-module-card]').forEach((el) => {
      el.classList.toggle('is-on', selected.has(el.getAttribute('data-module-card')));
    });
    document.querySelectorAll('[data-module-section]').forEach((el) => {
      el.classList.toggle('is-off', !selected.has(el.getAttribute('data-module-section')));
    });
    document.querySelectorAll('[data-module-row], [data-price-row]').forEach((el) => {
      const id = el.getAttribute('data-module-row') || el.getAttribute('data-price-row');
      el.classList.toggle('is-off', !selected.has(id));
    });
    document.querySelectorAll('[data-confirm]').forEach((el) => {
      const id = el.getAttribute('data-confirm');
      el.hidden = id === 'both' ? selected.size < 2 : !selected.has(id);
    });

    document.querySelectorAll('[data-total-net]').forEach((el) => { el.textContent = nf(net); });
    document.querySelectorAll('[data-total-vat]').forEach((el) => { el.textContent = nf(vat); });
    document.querySelectorAll('[data-total-gross]').forEach((el) => { el.textContent = nf(net + vat); });
    const names = chosen.map((m) => m.name).join(' + ') || '— לא נבחר מודול —';
    document.querySelectorAll('[data-selected-names]').forEach((el) => { el.textContent = names; });

    const both = selected.size === MODULES.length;
    document.querySelector('[data-synergy]')?.classList.toggle('is-off', !both);
    document.querySelector('[data-synergy-on]')?.toggleAttribute('hidden', !both);
    document.querySelector('[data-synergy-off]')?.toggleAttribute('hidden', both);

    document.querySelector('[data-empty]')?.toggleAttribute('hidden', chosen.length > 0);
    const submit = document.getElementById('sign-submit');
    if (submit) submit.disabled = chosen.length === 0;
  }

  document.querySelectorAll('[data-module-toggle]').forEach((el) => {
    el.addEventListener('change', () => {
      const id = el.getAttribute('data-module-toggle');
      if (el.checked) selected.add(id); else selected.delete(id);
      render();
    });
  });
  render();

  // ---------- חתימה ----------
  const form = document.getElementById('proposal-sign');
  const success = document.getElementById('sign-success');
  const canvas = document.getElementById('signature');
  const ctx = canvas?.getContext('2d');
  let drawing = false;
  let hasInk = false;

  if (canvas && ctx) {
    const dpr = Math.max(1, window.devicePixelRatio || 1);
    function setupCanvas() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineWidth = 2.2;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#1a1a1a';
    }
    setupCanvas();
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const data = canvas.toDataURL();
        setupCanvas();
        const img = new Image();
        img.onload = () => ctx.drawImage(img, 0, 0, canvas.width / dpr, canvas.height / dpr);
        img.src = data;
      }, 150);
    });

    function pos(e) {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }
    function onDown(e) {
      drawing = true;
      canvas.setPointerCapture?.(e.pointerId);
      const { x, y } = pos(e);
      ctx.beginPath();
      ctx.moveTo(x, y);
      e.preventDefault();
    }
    function onMove(e) {
      if (!drawing) return;
      const { x, y } = pos(e);
      ctx.lineTo(x, y);
      ctx.stroke();
      hasInk = true;
      e.preventDefault();
    }
    function onUp(e) {
      if (!drawing) return;
      drawing = false;
      canvas.releasePointerCapture?.(e.pointerId);
    }
    canvas.addEventListener('pointerdown', onDown);
    canvas.addEventListener('pointermove', onMove);
    canvas.addEventListener('pointerup', onUp);
    canvas.addEventListener('pointercancel', onUp);
    canvas.addEventListener('pointerleave', onUp);

    document.getElementById('sig-clear')?.addEventListener('click', () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasInk = false;
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const chosen = MODULES.filter((m) => selected.has(m.id));
    if (!chosen.length) {
      alert('יש לבחור לפחות מודול אחד.');
      return;
    }
    if (!hasInk) {
      alert('נדרשת חתימה לפני האישור.');
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries());
    const signature = canvas?.toDataURL('image/png');
    const net = chosen.reduce((s, m) => s + m.price, 0);
    const vat = net * VAT;
    const extras = [];
    if (selected.has('performance')) extras.push(`תקציב מדיה לגוגל — מומלץ ${MEDIA} ₪ לחודש, משולם ישירות לגוגל`);
    if (selected.has('flashy')) extras.push('מנוי פלטפורמת Flashy — לפי גודל מועדון הלקוחות, משולם ישירות ל-Flashy');

    // סיכום שנכנס כמו שהוא ל-PDF החתום ולמייל
    const summary = {
      title: 'Google Ads + Flashy ל-Guilty',
      client: 'Guilty · גילטי',
      project: chosen.map((m) => m.name).join(' + '),
      lede: 'הצעה מודולרית — המודולים שסומנו ואושרו על ידי החותם.',
      items: chosen.map((m) => ({ label: m.name, detail: m.points.join(' · '), amount: `${nf(m.price)} ₪ / חודש` })),
      totals: [
        { label: 'סה״כ חודשי לפני מע״מ', amount: `${nf(net)} ₪` },
        { label: `מע״מ (${Math.round(VAT * 100)}%)`, amount: `${nf(vat)} ₪` },
      ],
      total: { label: 'סה״כ חודשי כולל מע״מ', amount: `${nf(net + vat)} ₪` },
      extras,
      terms: 'חיוב חודשי בכרטיס אשראי בתחילת כל חודש עבודה. ללא דמי הקמה. התקשרות מחודש לחודש ללא תקופת התחייבות, ניתנת לסיום בהודעה של 30 יום מראש משני הצדדים, לכל מודול בנפרד.',
      confirms: [
        `אישור היקף העבודה עבור: ${chosen.map((m) => m.name).join(' + ')}`,
        `אישור דמי ניהול: ${nf(net)} ₪ לחודש + מע״מ (${nf(net + vat)} ₪ כולל מע״מ)`,
        'אישור תנאי ההתקשרות והעמדת הרשאות הגישה הנדרשות',
      ],
    };

    try {
      const res = await fetch('/api/proposal-sign', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          proposal: 'guilty-modular',
          ...data,
          signature,
          modules: chosen.map((m) => m.id),
          summary,
          signedAt: new Date().toISOString(),
        }),
      });
      if (res.ok || res.status === 202) {
        form.style.display = 'none';
        success.removeAttribute('hidden');
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        alert('משהו השתבש. נסו שוב או שלחו לי במייל ישירות.');
      }
    } catch {
      alert('משהו השתבש בחיבור. נסו שוב.');
    }
  });
})();
