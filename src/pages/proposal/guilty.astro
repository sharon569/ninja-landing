  { title: 'לוח שנה אחד, שני ערוצים', body: 'כל מבצע יוצא בבת אחת במודעות, בניוזלטר וב-SMS — עם אותו מסר, אותו עיצוב ואותו תאריך סיום.' },
  { title: 'מדידה אחת', body: 'הכנסות מאדס ומדיוור נמדדות באותו דוח, כך שרואים את הערך האמיתי של לקוחה לאורך זמן — ולא רק את ההזמנה הראשונה.' },
