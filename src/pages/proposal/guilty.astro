/* ============================ מודול A — ADS ============================ */
const engines = [
  {
    tag: 'מנוע 1',
    name: 'Performance Max',
    line: 'הקטלוג המלא, על כל שטחי הפרסום של גוגל.',
    body: 'פיד של 2,500+ מוצרים פרוש על חיפוש, שופינג, יוטיוב, ג׳ימייל, דיספליי ו-Discover. האלגוריתם מוצא את המוצר הנכון לחיפוש הנכון — בתנאי שהוא מפוצל לקבוצות נכסים לפי קטגוריה (איפור, טיפוח, שיער, בישום) ולפי רמת מרווח, ולא נזרק כקמפיין אחד גדול.',
  },
  {
    tag: 'מנוע 2',
    name: 'Search · מותגים ומוצרים',
    line: 'המותג המבוקש, במילים המדויקות של הקונה.',
