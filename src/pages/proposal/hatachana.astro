---
import Layout from '../../layouts/Layout.astro';

/* ---------------------------------------------------------------------------
 * מחיר — למלא לפני שליחה ללקוח.
 * MONTHLY הוא המחיר בפועל; LIST הוא מחיר המחירון שמוצג מחוק לידו.
 * שניהם זורמים לכרטיס המחיר, לתיבת האישור
 * ולטקסט המשפטי.
 * ------------------------------------------------------------------------- */
const MONTHLY = '1,500';
const LIST = '3,500';   // מחיר מחירון — מוצג מחוק ליד המחיר בפועל
const PRICE_SET = !MONTHLY.includes('X');

// מדדי הפתיחה מתוך "הרדאר האורגני של הטחנה" — Search Console, 27.5–24.8.2026
const kpis = [
  { k: 'חשיפות · 90 יום', v: '361,715', d: '+6.5%', tone: 'up' },
  { k: 'קליקים · 90 יום', v: '12,619', d: '−4.6%', tone: 'down' },
  { k: 'CTR כללי', v: '3.49%', d: 'ירד מ-3.90%', tone: 'down' },
  { k: 'CTR לא־מותגי', v: '1.47%', d: '218,945 חשיפות', tone: 'flat' },
  { k: 'מיקום ממוצע', v: '7.2', d: 'ירד מ-6.3', tone: 'down' },
];

// ששת הממצאים מהדוח — מקוצרים לכדי "למה יש עבודה"
const findings = [
  {
    n: '01',
    title: 'המולטי-סייט אוכל את עצמו',
    body: '8 תתי-אתרים מפרסמים 4,943 כתובות, מתוכן 3,989 עמודי מוצר — 8 עותקים כמעט זהים של אותו קטלוג, כל אחד עם canonical לעצמו. בפועל: "אנטריקוט" (8,040 חשיפות) מדורג עם עמוד מוצר של גבעתיים, ו"פורטרהאוס" עם יהוד — לא עם האתר הראשי.',
  },
  {
    n: '02',
    title: 'וואגיו הוא הנכס — והוא היחיד',
    body: 'עמוד קטגוריית הוואגיו לבדו: 28,950 חשיפות ו-1,909 קליקים — 59% מכל התנועה הלא-מותגית של האתר. הוא היחיד עם טייטל, דסקריפשן ו-H1 שנכתבו באמת. אנגוס, אנטריקוט ומיושן לא קיבלו את אותו טיפול, ורואים את זה בדירוג.',
  },
  {
    n: '03',
    title: 'סיפור המותג לא מקודם בכלל',
    body: 'הטייטל אומר "בשר ישראלי מהגליל". בפועל: "בשר מהגליל" — מיקום 24. "בשר מרמת הגולן" — מיקום 23. "בשר מיושן" — מיקום 54. אין ולו עמוד תוכן אחד שמסביר את מקור הבשר.',
  },
  {
    n: '04',
    title: 'המקומי בטווח השגה — ומפוצל',
    body: '"קצביה קרית אונו" במיקום 4.5, "אטליז רמת השרון" ב-5.5 — אבל "אטליז גבעתיים" ב-23.3 ו"קצביה תל אביב" ב-18.9. לכל עיר שתי כתובות מתחרות: /עיר/ ו-/branch/עיר/. אף אחת לא מנצחת.',
  },
  {
    n: '05',
    title: '43% מהעמודים בלי meta description',
    body: 'בדגימה של 144 כתובות: 62 בלי דסקריפשן, 95 עם טייטל בתבנית האוטומטית "שם — הטחנה", אפס עמודים עם סכמת LocalBusiness ב-96 עמודי סניף, ואפס H1 בכל עשרת עמודי הבית.',
  },
  {
    n: '06',
    title: '241 מתכונים במערכת, 31 באינדקס',
    body: 'נכס התוכן החזק ביותר של הרשת יושב כמעט כולו מחוץ למנוע. במקביל "איך מבשלים" מייצר 3,994 חשיפות במיקום 14.2, ו"מנגל / על האש" — 816 חשיפות במיקום 22.3.',
  },
];

// ההזדמנויות הגדולות — ביקוש שכבר נמדד ב-GSC של האתר עצמו
const gaps = [
  { topic: 'נתחים ספציפיים', impr: '24,120', pos: '9.0', missing: 'אין מדריך נתחים. פיקניה, ראמפ, ניו יורק, שייטל, אונטריב — כולם 7–10' },
  { topic: '"נתח קצבים"', impr: '10,965', pos: '5.3', missing: 'הביקוש הבודד הגדול ביותר אחרי "בשר" — 5 קליקים' },
  { topic: 'מחיר / כמה עולה', impr: '8,243', pos: '9.8', missing: 'אין עמודי מחירון לנתח' },
  { topic: 'עוף והודו', impr: '7,556', pos: '4.8', missing: 'מיקום מצוין, CTR של 1%' },
  { topic: 'טחון / המבורגר / קבב', impr: '6,922', pos: '10.5', missing: 'קטגוריה קיימת ולא מקודמת' },
  { topic: 'טלה וכבש', impr: '6,484', pos: '8.8', missing: '6 מוצרים בלבד מול ביקוש של 6.5K' },
  { topic: 'אווז (חזה / כבד)', impr: '5,492', pos: '6.5', missing: 'שוק כמעט ריק בישראל' },
  { topic: 'איך מבשלים / הכנה', impr: '3,994', pos: '14.2', missing: '241 מתכונים קיימים — 31 באינדקס' },
  { topic: 'כשרות והשגחה', impr: '2,296', pos: '8.4', missing: 'אין עמוד כשרות בכלל' },
  { topic: 'זכיינות', impr: '1,293', pos: '13.9', missing: 'ליד B2B בשווי גבוה — אפס קליקים' },
  { topic: 'מנגל / על האש', impr: '816', pos: '22.3', missing: 'הקטגוריה הכי ישראלית שיש — והאתר לא שם' },
];

// תוכנית העבודה — לפי סדר התלות מהדוח
const phases = [
  {
    n: 'חודש 1',
    title: 'לעצור את הדימום',
    when: 'טכני · יישום ישיר באתר',
    items: [
      '<strong>noindex לכל עמודי המוצר, הקטגוריה והמתכון בתתי-האתרים.</strong> נשאר מאונדקס: עמוד הבית של כל סניף. מוריד כ-3,800 כתובות כפולות מהאינדקס.',
      '<strong>noindex והוצאה ממפת האתר</strong> ל-/cart/, /my-account/, /עמוד-תשלום/, /wishlist/, /היסטוריית-הזמנות/ ו-/product-category/uncategorized/.',
      '<strong>301 מ-/branch/עיר/ לתת-האתר של אותה עיר</strong> — חוץ מחיפה, קריית אונו ודפנה, שנשארים כפי שהם.',
      '<strong>noindex ל-/עיר/סניפים/</strong> בכל תת-אתר — 8 עותקים כפולים של אותו עמוד.',
      'קביעת הכתובת המייצגת לכל עיר, וניקוי הפיצול בין www ל-non-www בתוצאות.',
    ],
  },
  {
    n: 'חודש 2',
    title: 'לגרום למה שכבר מדורג להיקלץ',
    when: 'מטא, סכמה ופיד',
    items: [
      '<strong>Meta description ל-62 העמודים החסרים</strong>, בעדיפות /סניפים/ (14,264 חשיפות), /shop/ (8,811) ואז כל קטגוריות "המזווה שלנו" — מלחים, תבלינים, חמוצים, לחמים, דבש, סלטים.',
      '<strong>טייטל ייחודי לכל 10 עמודי הבית של הסניפים</strong> לפי התבנית שכבר מוכחת בגבעתיים. זו הפעולה עם ה-ROI הגבוה ביותר בכל הדוח.',
      '<strong>H1 בכל עמודי הבית</strong> — היום אין אף אחד, כולל בראשי.',
      '<strong>סכמת LocalBusiness/Store על 96 עמודי הסניף</strong>: שם, כתובת, טלפון, שעות, גיאו, קישור ניווט. אפס כאלה קיימות היום.',
      '<strong>תיקון אי-ההתאמות</strong>: ה-H1 בהולשטיין ובאנגוס, השגיאה "90:00" ברמת השרון, והדסקריפשן של יין איטלקי שמוצג היום ב-/shop/.',
      '<strong>בדיקת פיד המוצרים</strong> — 145,841 חשיפות מגיעות כקרוסלת מוצרים ורק 31 כ-Merchant Listing. מחיר וזמינות תקינים בסכמה הם ההבדל בין CTR של 0.04% ל-3%.',
    ],
  },
  {
    n: 'חודשים 3–4',
    title: 'לתפוס את הפערים הגדולים',
    when: 'תוכן ומבנה',
    items: [
      '<strong>מדריך נתחי בקר</strong> — הנושא הגדול ביותר בדוח (24,120 חשיפות, מיקום 9.0). עמוד hub + עמוד לכל נתח מרכזי: אנטריקוט, סינטה, פיקניה, ראמפ, נתח קצבים, שייטל, אונטריב, אסאדו — כל אחד מקשר לקטגוריה ולמוצר.',
      '<strong>עמוד "מאיפה הבשר שלנו"</strong> — הגליל, רמת הגולן, שישה דורות, ללא אנטיביוטיקה והורמונים. זה העמוד שאמור לדרג על "בשר ישראלי", "בשר מהגליל" ו"בשר מגידול מקומי" — כולם היום במיקום 13–24.',
      '<strong>קטגוריית אנטריקוט אמיתית באתר הראשי</strong> — 11,920 חשיפות שהולכות היום לעמוד מוצר של סניף.',
      '<strong>תיקון ה-slug של אנגוס</strong> מ-"נתחים-עם-עצם" ל-"אנגוס" עם 301. 4,558 חשיפות תקועות במיקום 8.5.',
      '<strong>הכנסת 210 המתכונים החסרים לאינדקס</strong> וקישור פנימי מכל מתכון למוצרים שבו — הקשר כבר קיים במסד הנתונים.',
      '<strong>עמוד כשרות והשגחה</strong> (2,296 חשיפות) ו<strong>עמוד מנגל / על האש</strong> (816 חשיפות במיקום 22), לפני עונת 2027.',
    ],
  },
  {
    n: 'חודשים 5–6',
    title: 'להעמיק את מה שכבר מנצח',
    when: 'הגנה והרחבה',
    items: [
      '<strong>Hub וואגיו</strong> סביב הקטגוריה שכבר מדורגת: ישראלי מול אוסטרלי, מה זה A5, איך מבשלים, טבלת דרגות שיוש. המטרה: להחזיר את "וואגיו ישראלי" ממיקום 4.0 ל-1.2 שהיה, ואת "וואגיו" מ-4.9 ל-2.',
      '<strong>תפיסת שגיאות הכתיב</strong> — "ואסיו" לבד מייצר 1,120 חשיפות במיקום 10.4. שורה אחת בתוכן העמוד פותרת את זה.',
      '<strong>עמודי חג</strong> — ראש השנה, פסח, סוכות. אפריל הכפיל את התנועה בלי שום עמוד ייעודי.',
      '<strong>מהירות עמוד הבית</strong> — LCP של 4.33 שניות ומשקל של 13.4MB. זה בדיוק העמוד שמדורג ל"קצביה", "אטליז" ו"בשר".',
      '<strong>Google Business Profile לכל סניף</strong>, מקושר לעמוד המקומי הנכון. חיפוש "אטליז ב[עיר]" מוכרע ברובו במפה ולא בקישורים הכחולים.',
    ],
  },
];

// שני מסלולי התוכן — לפי חלוקת התפקידים שנקבעה בדוח
const contentTracks = [
  {
    tag: 'אתר ראשי',
    title: 'תוכן שמחזיק סמכות ארצית',
    body: 'כאן נכתב התוכן שנלחם על הכוונות הגדולות. כל פריט נבחר לפי הביקוש שנמדד בפועל ב-Search Console, לא לפי תחושה, ומקושר פנימית לקטגוריה ולמוצרים הרלוונטיים.',
    items: [
      'מדריכי נתחים — אנטריקוט, סינטה, פיקניה, ראמפ, נתח קצבים, שייטל, אונטריב, אסאדו',
      'מחירונים לפי נתח — "כמה עולה" הוא ביקוש של 8,243 חשיפות',
      'תוכן הכנה ובישול, שמחובר ל-241 המתכונים הקיימים',
      'כשרות והשגחה, מקור הבשר, מנגל ועל האש, ותוכן עונתי לחגים',
    ],
  },
  {
    tag: 'עמודי הסניפים',
    title: 'תוכן מקומי שאין לו כפילות',
    body: 'לא בלוג לכל סניף — הדוח ממליץ נגד זה במפורש, כי 10 עותקים של אותו מאמר יתחרו זה בזה בדיוק כמו עמודי המוצר היום. במקום זה, כל סניף מקבל תוכן שרק הוא יכול לכתוב, ולכן רק הוא ידרג עליו.',
    items: [
      'שכונות ואזורי שירות, נגישות וחנייה, ציוני דרך מקומיים',
      'המוצרים והנתחים החזקים של אותו סניף בפועל',
      'שעות, מלאי, מבצעים ואירועים מקומיים',
      'סכמת LocalBusiness מלאה וקישור ל-Google Business Profile של הסניף',
    ],
  },
];

// מה נכנס בכל חודש, בלי קשר לשלב
const monthly = [
  {
    icon: 'wrench',
    title: 'יישום בפועל — לא רשימת המלצות',
    body: 'יש לנו גישת FTP וגישת ניהול לאתר. כל תיקון טכני, כל טייטל, כל סכמה וכל עמוד תוכן נכנסים לאתר על ידינו. אתם לא צריכים מפתח בתווך, ואין שלב שבו ההצעה נתקעת בהמתנה לביצוע.',
  },
  {
    icon: 'radar',
    title: 'ניטור שוטף וזיהוי נפילות',
    body: 'מעקב אחרי סל מילות המפתח המוגדר, אחרי מספר הכתובות באינדקס ואחרי המיקום הממוצע. נפילה כמו "וואגיו ישראלי" שירד ממיקום 1.2 ל-4.0 מזוהה בזמן אמת, לא רבעון אחרי.',
  },
  {
    icon: 'report',
    title: 'דוח חודשי ושיחת עבודה',
    body: 'דוח שמראה מה נעשה החודש, מה זז במספרים, ומה בתור לחודש הבא — באותה רמת פירוט של הדוח הזה. פלוס שיחה חודשית לסגירת עדיפויות.',
  },
];

// המדדים שלפיהם נמדדת ההצלחה
const metrics = [
  { m: 'CTR לא־מותגי', now: '1.47%', why: 'המדד המרכזי. 218,945 חשיפות שכמעט לא נלחצות — כאן נמצא כל הפוטנציאל.' },
  { m: 'קליקים לא־מותגיים · 90 יום', now: '3,226', why: 'תנועה של אנשים שלא הכירו את הטחנה. זה מה שקידום אורגני אמור לייצר.' },
  { m: 'מיקום ממוצע', now: '7.2', why: 'ירד מ-6.3. היעד הראשון הוא לעצור את ההידרדרות, ואז לחזור.' },
  { m: 'כתובות באינדקס', now: '~4,943', why: 'כאן ירידה היא שיפור. פחות עותקים כפולים = יותר סמכות לעמוד אחד.' },
  { m: 'עמודי סניף עם סכמת LocalBusiness', now: '0 / 96', why: 'התנאי לתחרות רצינית בחיפוש המקומי.' },
  { m: 'Merchant Listings', now: '31', why: 'מול 145,841 חשיפות שמגיעות כקרוסלת מוצרים. הפער הזה הוא הפיד.' },
];

// החלטות שדורשות אישור הלקוח לפני שמתחילים
const decisions = [
  {
    title: 'איזו כתובת מייצגת כל עיר',
    body: 'לכל עיר יש היום שתי כתובות מתחרות. ההמלצה לפי הנתונים: לסניפים החיים — /עיר/ הוא העמוד המקומי ו-/branch/עיר/ עושה 301 אליו. לחיפה וקריית אונו, שמוגדרים public=0 — /branch/עיר/ נשאר, כי הוא כבר מייצר 339 קליקים ביניהם.',
  },
  {
    title: 'robots.txt וסריקת מנועי AI',
    body: 'ה-robots.txt חוסם היום את GPTBot, ClaudeBot, CCBot, Google-Extended, meta-externalagent ו-Applebot-Extended. גוגל החיפוש לא מושפע — אבל כשמישהו שואל ChatGPT "איפה קונים וואגיו ישראלי", הטחנה לא בתמונה והמתחרים כן. זו החלטה עסקית שלכם, לא באג, וצריך להכריע בה.',
  },
  {
    title: 'הרשאות גישה',
    body: 'Search Console, ניהול וורדפרס, Cloudflare (שם מנוהל ה-robots.txt) ו-Google Business Profile של כל סניף. בלי אלה חלק מהעבודה הופכת להמלצה במקום לביצוע.',
  },
];

const today = new Date().toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Layout
  title="הצעת מחיר · קידום אורגני · הטחנה ריטייל בע״מ — NINJA Digital"
  description="הצעת מחיר לקידום אורגני של רשת הטחנה — meat-shop.co.il. תוכנית עבודה מבוססת נתוני Search Console, יישום ישיר באתר, וריטיינר חודשי."
  noindex={true}
  hideFloatWA={true}
  hideNav={true}
>

<section class="proposal-hero">
  <div class="container">
    <span class="eyebrow">הצעת מחיר · NINJA Digital</span>
    <h1>קידום אורגני ל<em>הטחנה</em>.</h1>
    <p class="lede">
