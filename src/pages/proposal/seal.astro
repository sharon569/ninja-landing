.extras-head h3 { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.01em; }
.extras-list { list-style: none; padding: 18px 0 0; margin: 18px 0 0; display: grid; gap: 12px; border-top: 1px solid rgba(255,255,255,0.07); }
.extras-list li { position: relative; padding-inline-start: 22px; color: rgba(255,255,255,0.72); line-height: 1.65; font-size: 0.93rem; }
.extras-list li::before { content: ''; position: absolute; inset-inline-start: 0; top: 9px; width: 7px; height: 7px; border-radius: 50%; background: rgba(120,180,255,0.6); }
.extras-list strong { color: #fff; font-weight: 700; }

/* ---------- SIGN ---------- */
.sign-card { margin-top: 32px; padding: 32px; border: 1px solid rgba(255,255,255,0.12); border-radius: 22px; background: rgba(255,255,255,0.03); display: grid; gap: 20px; }
.field-row { display: grid; grid-template-columns: 1fr; gap: 16px; }
@media (min-width: 768px) { .field-row { grid-template-columns: 1fr 1fr; } }
.field { display: flex; flex-direction: column; gap: 6px; }
.field label { font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.55); }
.field input { height: 48px; padding: 0 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: #fff; font-size: 1rem; transition: border-color 0.2s; }
.field input:focus { outline: none; border-color: var(--gold, #ffd166); }
.confirms { display: grid; gap: 8px; padding: 14px 16px; border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; background: rgba(0,0,0,0.2); }
.check { display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: start; cursor: pointer; padding: 10px 8px; border-radius: 10px; transition: background 0.15s; }
.check:hover { background: rgba(255,255,255,0.04); }
.check.optional { border-top: 1px dashed rgba(255,255,255,0.12); border-radius: 0 0 10px 10px; margin-top: 4px; padding-top: 14px; }
.check input[type=checkbox] { width: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--gold, #ffd166); cursor: pointer; flex-shrink: 0; }
.check span { line-height: 1.55; color: rgba(255,255,255,0.88); font-size: 0.95rem; }
.check span strong { color: rgb(170, 200, 255); }

.signature-block { display: grid; gap: 10px; padding: 18px 20px; border: 1px solid rgba(255,255,255,0.12); border-radius: 14px; background: rgba(0,0,0,0.25); }
.signature-block label { font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.65); }
.signature-block .hint { font-size: 0.85rem; color: rgba(255,255,255,0.55); margin: 0; }
.sig-wrap { position: relative; width: 100%; }
canvas#signature { display: block; width: 100%; height: 200px; background: #ffffff; border-radius: 10px; border: 1px solid rgba(255,255,255,0.16); cursor: crosshair; touch-action: none; }
.sig-line { position: absolute; inset-inline: 24px; bottom: 38px; height: 1px; background: rgba(0,0,0,0.18); pointer-events: none; }
.sig-x { position: absolute; inset-inline-start: 24px; bottom: 26px; font-size: 0.85rem; color: rgba(0,0,0,0.45); letter-spacing: 0.05em; pointer-events: none; font-family: 'Rubik', sans-serif; }
.sig-actions { display: flex; justify-content: flex-end; }
.btn-ghost { background: transparent; border: 1px solid rgba(255,255,255,0.18); color: rgba(255,255,255,0.7); padding: 8px 16px; border-radius: 8px; font-size: 0.85rem; cursor: pointer; transition: border-color 0.2s; }
.btn-ghost:hover { border-color: rgba(255,255,255,0.4); color: #fff; }

.sign-actions { margin-top: 12px; display: flex; flex-direction: column; gap: 14px; align-items: stretch; }
.btn-primary { height: 56px; background: linear-gradient(135deg, var(--gold, #ffd166), #d4a534); color: #0a0a0a; border: none; font-size: 1.05rem; font-weight: 700; border-radius: 12px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 10px; transition: transform 0.2s, box-shadow 0.2s; }
.btn-primary:hover { transform: translateY(-1px); box-shadow: 0 14px 30px -10px rgba(255,209,102,0.3); }
.legal { color: rgba(255,255,255,0.5); font-size: 0.82rem; text-align: center; }

.sign-success { margin-top: 32px; padding: 36px; border: 1px solid rgba(74,222,128,0.3); background: rgba(74,222,128,0.06); border-radius: 22px; text-align: center; }
.sign-success h3 { font-size: 1.8rem; font-weight: 700; color: rgb(134, 239, 172); margin-bottom: 10px; }
.sign-success p { color: rgba(255,255,255,0.85); line-height: 1.6; }

@media (max-width: 720px) {
  .proposal-hero { padding: 36px 0 50px; }
  .proposal-hero h1 { font-size: 2.1rem; line-height: 1.15; }
  .proposal-hero .lede { font-size: 0.98rem; }
  .meta { gap: 12px; padding: 16px; margin-top: 24px; }
  .meta strong { font-size: 0.92rem; }
  section { padding: 44px 0; }
  .price-card, .hosting-card, .extras { padding: 22px 20px; }
  .price-row { flex-direction: column; align-items: flex-start; gap: 6px; }
  .sign-card { padding: 22px 18px; }
}
</style>

