<script is:inline define:vars={{ MONTHLY, VIDEO, VIDEO_QTY, CLIENT, SITE }}>
(() => {
  const form = document.getElementById('proposal-sign');
  const success = document.getElementById('sign-success');
  const canvas = /** @type {HTMLCanvasElement} */(document.getElementById('signature'));
  const ctx = canvas?.getContext('2d');
  let drawing = false;
  let hasInk = false;

  if (canvas && ctx) {
    const dpr = Math.max(1, window.devicePixelRatio || 1);
    function setupCanvas() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineWidth = 2.2;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#1a1a1a';
    }
    setupCanvas();
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const data = canvas.toDataURL();
        setupCanvas();
        const img = new Image();
        img.onload = () => ctx.drawImage(img, 0, 0, canvas.width / dpr, canvas.height / dpr);
        img.src = data;
      }, 150);
    });

    function pos(e) {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }
    function onDown(e) {
      drawing = true;
      canvas.setPointerCapture?.(e.pointerId);
      const { x, y } = pos(e);
      ctx.beginPath();
      ctx.moveTo(x, y);
      e.preventDefault();
    }
    function onMove(e) {
      if (!drawing) return;
      const { x, y } = pos(e);
      ctx.lineTo(x, y);
      ctx.stroke();
      hasInk = true;
      e.preventDefault();
    }
    function onUp(e) {
      if (!drawing) return;
      drawing = false;
      canvas.releasePointerCapture?.(e.pointerId);
    }
    canvas.addEventListener('pointerdown', onDown);
    canvas.addEventListener('pointermove', onMove);
    canvas.addEventListener('pointerup', onUp);
    canvas.addEventListener('pointercancel', onUp);
    canvas.addEventListener('pointerleave', onUp);

    document.getElementById('sig-clear')?.addEventListener('click', () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasInk = false;
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!hasInk) {
      alert('נדרשת חתימה לפני האישור.');
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries());
    const signature = canvas?.toDataURL('image/png');
    const withVideos = data.add_videos === 'on';

    // סיכום שנכנס כמו שהוא ל-PDF החתום ולמייל
    const items = [
      { label: 'ניהול קמפיינים בפייסבוק ובאינסטגרם — לידים', detail: 'בדיקת פיקסל ומסלול ליד · שלושה קמפיינים: Backyard, Patio Cover, Pavers · כתיבת מודעות וטפסי לידים · אופטימיזציה שוטפת · דוח חודשי', amount: `$${MONTHLY} / חודש` },
    ];
    if (withVideos) {
      items.push({ label: `חבילת סרטונים — ${VIDEO_QTY} סרטונים`, detail: 'סרטוני מודעה קצרים ל-Reels ול-Stories, בעריכה מחומרי הלקוח', amount: `$${VIDEO} לחבילה` });
    }
    const summary = {
      title: 'קמפיינים בפייסבוק ובאינסטגרם ל-Seal Design & Build',
      client: `${CLIENT} · ${SITE}`,
      project: 'Facebook · Instagram Ads · ניהול חודשי',
      lede: 'ניהול קמפיינים ממומנים בפייסבוק ובאינסטגרם למטרת לידים, בשלושה נושאים: Backyard, Patio Cover ו-Pavers.',
      items,
      totals: withVideos ? [{ label: 'חבילת סרטונים, תשלום נוסף', amount: `$${VIDEO}` }] : [],
      total: { label: 'סה״כ חודשי', amount: `$${MONTHLY}` },
      extras: [withVideos ? `הוזמנה חבילת סרטונים (${VIDEO_QTY} סרטונים)` : 'חבילת סרטונים לא הוזמנה בשלב זה'],
      terms: 'המחירים בדולר ארה״ב. תשלום חודשי בתחילת כל חודש עבודה. תקציב המדיה אינו כלול ומשולם ישירות ל-Meta. צילום בשטח ופיתוח באתר אינם כלולים.',
      confirms: [
        'אישור היקף העבודה כפי שתואר בהצעה',
        `אישור מחיר: $${MONTHLY} לחודש${withVideos ? `, ועוד $${VIDEO} לחבילת סרטונים` : ''}`,
        'התחייבות להעמיד הרשאות גישה וחומרים חזותיים',
      ],
    };

    try {
      const res = await fetch('/api/proposal-sign', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ proposal: 'seal-meta', ...data, signature, summary, modules: withVideos ? ['videos'] : [], signedAt: new Date().toISOString() }),
      });
      if (res.ok || res.status === 202) {
        form.style.display = 'none';
        success.removeAttribute('hidden');
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        alert('משהו השתבש. נסו שוב או שלחו לי במייל ישירות.');
      }
    } catch {
      alert('משהו השתבש בחיבור. נסו שוב.');
    }
  });
})();
</script>

