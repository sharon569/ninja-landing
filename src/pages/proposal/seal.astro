---
import Layout from '../../layouts/Layout.astro';

/* ---------------------------------------------------------------------------
 * מחיר — נקבע מול שרון, בדולר ארה״ב:
 * MONTHLY — דמי ניהול חודשיים לקמפיינים בפייסבוק ובאינסטגרם.
 * VIDEO   — תוספת לחבילת סרטונים (VIDEO_QTY סרטונים), מחויבת לפי חבילה שהוזמנה.
 * תקציב המדיה לא כלול ומשולם ישירות ל-Meta.
 * ------------------------------------------------------------------------- */
const MONTHLY = '450';
const VIDEO = '500';
const VIDEO_QTY = '3–4';

const CLIENT = 'Seal Design & Build Inc.';
const SITE = 'sealdesignandbuild.com';

// מה שנמצא בסריקה של האתר — עובדות, לא הערכות
const kpis = [
  { k: 'אזור שירות', v: 'San Diego County', d: 'מ-Oceanside עד Chula Vista', tone: 'flat' },
  { k: 'ערים באתר', v: '18', d: 'בעמוד Hardscape & Landscape', tone: 'up' },
  { k: 'איסוף לידים', v: 'Free Estimate', d: 'טופס + חיוג בלחיצה', tone: 'up' },
  { k: 'נכסים ב-Meta', v: 'FB + IG', d: 'עמוד ופרופיל קיימים', tone: 'up' },
  { k: 'הוכחה חזותית', v: 'לפני / אחרי', d: 'גלריית פרויקטים באתר', tone: 'up' },
];

// שלושת הנושאים שעלו בפגישה — כל אחד מקבל קמפיין משלו
const topics = [
  {
    tag: 'נושא 1',
    name: 'Backyard',
    line: 'חצר אחורית שלמה — הפרויקט הגדול.',
    body: 'הנושא הרחב מבין השלושה, וזה שנמכר הכי טוב בתמונה: חצר לפני, חצר אחרי. הקמפיין פונה לבעלי בתים שרוצים חצר שאפשר לחיות בה, ומוביל לבקשת הצעת מחיר. מי שמתחיל כאן הוא לרוב גם לקוח פוטנציאלי לריצוף ולקירוי.',
  },
  {
    tag: 'נושא 2',
    name: 'Patio Cover',
    line: 'קירוי פטיו ופרגולות.',
    body: 'מוצר מוגדר, עם החלטה ברורה. באתר מופיעים כמה סוגים — solid, lattice, gable, עץ ו-louvered — וכל אחד מהם הוא מודעה בפני עצמה. הקמפיין מציג את הסוגים בפרויקטים אמיתיים ומזמין לקבל הצעה.',
  },
  {
    tag: 'נושא 3',
    name: 'Pavers',
    line: 'ריצוף אבנים — שבילי גישה, חניות ופטיו.',
    body: 'עבודה שהשינוי בה נראה מיד, ולכן מתאימה במיוחד לסרטוני לפני/אחרי קצרים. הקמפיין מכוון לבעלי בתים עם חניה, שביל או פטיו שדורשים חידוש.',
  },
];

// מבנה הקמפיינים בחשבון
const campaigns = [
  {
    type: 'לידים · Backyard',
    target: 'בעלי בתים ב-San Diego County',
    why: 'הקמפיין הרחב. מביא את הפניות לפרויקטים הגדולים ומזין את שני האחרים.',
    prio: 'ראשון',
  },
  {
    type: 'לידים · Patio Cover',
    target: 'בעלי בתים באזור השירות, עם מודעות לפי סוג קירוי',
    why: 'מוצר ממוקד עם החלטה קצרה יחסית. נמדד בנפרד כדי לדעת מה עולה ליד בקטגוריה הזו.',
    prio: 'ראשון',
  },
  {
    type: 'לידים · Pavers',
    target: 'בעלי בתים באזור השירות, מודעות לפני/אחרי',
    why: 'נושא חזותי שמייצר מעורבות גבוהה. נמדד בנפרד מאותה סיבה.',
    prio: 'ראשון',
  },
  {
    type: 'רימרקטינג',
    target: 'מבקרים באתר, צופי סרטונים, ומי שפתח טופס ולא שלח',
    why: 'שיפוץ חצר לא נסגר בחשיפה אחת. הקמפיין הזה חוזר למי שכבר התעניין.',
    prio: 'שני',
  },
];

// תוכנית עבודה — לפי סדר תלות
const phases = [
  {
    n: 'שלב 1',
    title: 'תשתית ומדידה',
    when: 'לפני העלייה לאוויר',
    items: [
      '<strong>גישה וחיבור נכסים.</strong> חשבון המודעות, עמוד הפייסבוק ופרופיל האינסטגרם מחוברים ל-Business Manager, ואנחנו מקבלים הרשאת ניהול — הבעלות נשארת אצלכם.',
      '<strong>בדיקת Meta Pixel ואירועי המרה.</strong> בסריקה מבחוץ לא יכולנו לאמת אם יש פיקסל פעיל באתר. זו הבדיקה הראשונה: שליחת טופס Free Estimate ולחיצה על חיוג צריכות להירשם כהמרות — אחרת אין לפי מה לייעל.',
      '<strong>מסלול הליד.</strong> מחליטים יחד היכן הליד נאסף — טופס מובנה בתוך פייסבוק ואינסטגרם, טופס באתר, או שניהם — ולאן הוא מגיע בזמן אמת: מייל, טלפון או CRM.',
      '<strong>בדיקת מה שרץ עד היום.</strong> אם יש בחשבון היסטוריית קמפיינים, עוברים עליה: מה עבד, מה לא, ואילו קהלים כבר קיימים.',
    ],
  },
  {
    n: 'שלב 2',
    title: 'בניית הקמפיינים',
    when: 'העלאה לאוויר',
    items: [
      '<strong>שלושה קמפיינים לפי נושא</strong> — Backyard, Patio Cover ו-Pavers — כל אחד עם תקציב ומדידה משלו.',
      '<strong>טירגוט גיאוגרפי</strong> לפי אזורי השירות שלכם ב-San Diego County, עם אפשרות למקד ערים שבהן אתם מעדיפים לעבוד.',
      '<strong>כתיבת מודעות באנגלית</strong> — כותרות, טקסטים וקריאה לפעולה — בכמה גרסאות לכל נושא.',
      '<strong>קריאייטיב מהחומרים שלכם.</strong> תמונות לפני/אחרי ופרויקטים שהושלמו, מותאמים לפורמטים של פיד, Stories ו-Reels.',
      '<strong>טופס ליד עם שאלות סינון</strong> — סוג הפרויקט, עיר ולוח זמנים — כדי שהפניות שמגיעות יהיו רלוונטיות.',
    ],
  },
  {
    n: 'שלב 3',
    title: 'אופטימיזציה שוטפת',
    when: 'כל חודש',
    items: [
      '<strong>מעקב אחרי עלות לליד</strong> לכל נושא בנפרד, והעברת תקציב למה שמביא פניות טובות יותר.',
      '<strong>רענון מודעות.</strong> מודעה נשחקת אחרי שהקהל ראה אותה מספיק פעמים — מחליפים קריאייטיב וטקסטים באופן שוטף.',
      '<strong>רימרקטינג</strong> למבקרים באתר ולצופי סרטונים, ברגע שהצטבר קהל מספיק.',
      '<strong>משוב על איכות הלידים.</strong> אתם מדווחים אילו פניות הפכו לפגישה ולעסקה, ואנחנו מכוונים את הקמפיינים לפי זה — לא רק לפי כמות.',
    ],
  },
];

// מה קורה בכל חודש
const monthly = [
  {
    icon: 'wrench',
    title: 'ניהול בפועל של החשבון',
    body: 'קמפיינים, קהלים, תקציבים, מודעות וטפסי לידים — הכול נבנה ומתוחזק על ידינו בתוך חשבון המודעות שלכם.',
  },
  {
    icon: 'radar',
    title: 'מעקב שוטף',
    body: 'בדיקה שוטפת של ההוצאה, של עלות הליד ושל מודעות שנדחו או נשחקו — כדי שהתקציב לא ירוץ על מה שלא עובד.',
  },
  {
    icon: 'report',
    title: 'דוח חודשי',
    body: 'כמה הוצא, כמה לידים הגיעו, מה עלות הליד בכל נושא, ומה מתוכנן לחודש הבא.',
  },
];

// מה צריך מהלקוח
const decisions = [
  {
    title: 'הרשאות גישה',
    body: 'הרשאת ניהול לחשבון המודעות, לעמוד הפייסבוק ולפרופיל האינסטגרם דרך Business Manager, וגישה לאתר ה-WordPress לצורך בדיקה והתקנה של הפיקסל.',
  },
  {
    title: 'תקציב מדיה ואמצעי תשלום',
    body: 'תקציב המדיה משולם על ידכם ישירות ל-Meta, מאמצעי תשלום שמוזן בחשבון המודעות שלכם. גובה התקציב נקבע יחד לפני העלייה לאוויר — הוא לא חלק מדמי הניהול.',
  },
  {
    title: 'חומרים חזותיים',
    body: 'תמונות וסרטונים מפרויקטים שהושלמו — במיוחד לפני/אחרי — בשלושת הנושאים. ככל שהחומרים טובים ואמיתיים יותר, המודעות עובדות טוב יותר.',
  },
  {
    title: 'מענה מהיר ללידים',
    body: 'ליד שלא מקבל טלפון תוך זמן קצר מתקרר. צריך אדם אחד מטעמכם שמקבל את הפניות וחוזר אליהן, ומעדכן אותנו אילו מהן היו רלוונטיות.',
  },
];

const today = new Date().toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Layout
  title="הצעת מחיר · קמפיינים בפייסבוק ובאינסטגרם · Seal Design & Build — NINJA Digital"
  description="הצעת מחיר לניהול קמפיינים ממומנים בפייסבוק ובאינסטגרם ל-Seal Design & Build — לידים ל-Backyard, Patio Cover ו-Pavers."
  noindex={true}
  hideFloatWA={true}
  hideNav={true}
>

<section class="proposal-hero">
  <div class="container">
    <span class="eyebrow">הצעת מחיר · NINJA Digital</span>
    <h1>לידים מפייסבוק ומאינסטגרם ל-<em>Seal Design &amp; Build</em>.</h1>
    <p class="lede">
      <strong>ניהול קמפיינים ממומנים בפייסבוק ובאינסטגרם, עם מטרה אחת: לידים.</strong>
      שלושה נושאים שעלו בפגישה — Backyard, Patio Cover ו-Pavers — כל אחד כקמפיין נפרד,
      שנמדד לפי פניות ולא לפי לייקים.
      ההצעה מפרטת מה בונים, באיזה סדר, מה נדרש מכם ובכמה. תקפה ל-30 יום מתאריך השליחה.
    </p>

    <div class="meta">
      <div><span>לקוח</span><strong>{CLIENT}</strong></div>
      <div><span>אתר</span><strong>{SITE}</strong></div>
      <div><span>אזור</span><strong>San Diego, CA</strong></div>
      <div><span>שירות</span><strong>Facebook · Instagram Ads</strong></div>
      <div><span>תאריך</span><strong>{today}</strong></div>
    </div>
  </div>
</section>

<section class="state">
  <div class="container">
    <span class="eyebrow">נקודת הפתיחה</span>
    <h2>מה כבר קיים, ומה עוד צריך לבדוק.</h2>
    <p class="lede">
      הנתונים כאן מבוססים על סריקה של האתר בלבד — לא על חשבון המודעות, שאליו עדיין אין לנו גישה.
      <strong>לכן אין בהצעה הזו הבטחה למספר לידים או לעלות לליד.</strong>
      את המספרים האלה נדע אחרי החודש הראשון של הרצה, ומהם והלאה נמדד מולם.
    </p>

    <div class="kpis">
      {kpis.map((k) => (
        <div class="kpi">
          <div class="k">{k.k}</div>
          <div class="v">{k.v}</div>
          <div class={`d ${k.tone}`}>{k.d}</div>
        </div>
      ))}
    </div>
    <p class="src">מקור: סריקה של {SITE} · נובמבר 2026 · עמוד הבית, About, Contact ו-Hardscape &amp; Landscape</p>
  </div>
</section>

<section class="engines">
  <div class="container">
    <span class="eyebrow">הנושאים לקידום</span>
    <h2>שלושה נושאים. שלושה קמפיינים.</h2>
    <p class="lede">
      האתר מציע מגוון רחב של שירותים, משיפוץ מטבחים ועד ADU.
      <strong>ההצעה הזו מתמקדת בשלושת הנושאים שעלו בפגישה</strong> — כולם מתחום ה-Hardscape &amp; Landscape,
      וכולם נמכרים קודם כול בתמונה. ההפרדה לקמפיינים היא מה שמאפשר לדעת כמה עולה ליד בכל נושא.
    </p>

    <div class="eng-grid">
      {topics.map((e) => (
        <div class="eng-card">
          <span class="eng-tag">{e.tag}</span>
          <h3>{e.name}</h3>
          <p class="eng-line">{e.line}</p>
          <p>{e.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="gaps">
  <div class="container">
    <span class="eyebrow">מבנה הקמפיינים</span>
    <h2>איך זה נראה בחשבון המודעות.</h2>
    <p class="lede">
      שלושה קמפייני לידים שעולים יחד, וקמפיין רימרקטינג שמצטרף כשהצטבר קהל.
      <strong>כל שורה כאן מסתיימת בפנייה של בעל בית שמבקש הצעת מחיר.</strong>
    </p>

    <div class="tscroll">
      <table>
        <thead>
          <tr>
            <th>קמפיין</th>
            <th>למי הוא פונה</th>
            <th>למה הוא שם</th>
            <th class="num">שלב</th>
          </tr>
        </thead>
        <tbody>
          {campaigns.map((c) => (
            <tr>
              <td class="kw">{c.type}</td>
              <td class="miss">{c.target}</td>
              <td class="miss">{c.why}</td>
              <td class="num accent">{c.prio}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="plan">
  <div class="container">
    <span class="eyebrow">תוכנית עבודה</span>
    <h2>שלושה שלבים, בסדר הזה.</h2>
    <p class="lede">
      <strong>קודם מדידה, אחר כך מודעות.</strong>
      קמפיין לידים שרץ בלי מעקב תקין אחרי פניות אי אפשר לשפר — ולכן בדיקת הפיקסל ומסלול הליד
      קודמת לעלייה לאוויר.
    </p>

    {phases.map((p) => (
      <article class="phase">
        <header>
          <span class="pn">{p.n}</span>
          <h3>{p.title}</h3>
          <span class="when">{p.when}</span>
        </header>
        <ul>
          {p.items.map((i) => <li set:html={i} />)}
        </ul>
      </article>
    ))}
  </div>
</section>

<section class="included">
  <div class="container">
    <span class="eyebrow">מה נכנס בכל חודש</span>
    <h2>שלושה דברים שקורים תמיד.</h2>
    <div class="inc-grid">
      {monthly.map((m) => (
        <div class="inc-card">
          <div class="inc-icon" aria-hidden="true">
            {m.icon === 'wrench' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.7 6.3a4 4 0 0 1-5 5L4 17v3h3l5.7-5.7a4 4 0 0 1 5-5l2.3-2.3-3-3-2.3 2.3z"/></svg>
            )}
            {m.icon === 'radar' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/><path d="M12 12 19 7"/></svg>
            )}
            {m.icon === 'report' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
            )}
          </div>
          <h3>{m.title}</h3>
          <p>{m.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="decisions">
  <div class="container">
    <span class="eyebrow">לפני שמתחילים</span>
    <h2>ארבעה דברים שאנחנו צריכים מכם.</h2>
    <div class="dec-grid">
      {decisions.map((d) => (
        <div class="dec-card">
          <h3>{d.title}</h3>
          <p>{d.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="price">
  <div class="container">
    <span class="eyebrow">סיכום עלות</span>
    <h2>דמי ניהול חודשיים, ותוספת לסרטונים.</h2>
    <div class="price-card">
      <div class="price-row">
        <span>ניהול קמפיינים בפייסבוק ובאינסטגרם — מטרה: לידים</span>
        <strong>${MONTHLY} / חודש</strong>
      </div>
      <div class="price-row sub"><span>בדיקת פיקסל, אירועי המרה ומסלול הליד</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>בניית שלושה קמפיינים — Backyard, Patio Cover, Pavers</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>כתיבת מודעות באנגלית וטפסי לידים</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>התאמת תמונות קיימות לפורמטים של מודעות</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>אופטימיזציה שוטפת ודוח חודשי</span><strong>כלול</strong></div>
      <div class="price-row total">
        <span>סה״כ חודשי</span>
        <strong>${MONTHLY}</strong>
      </div>
      <p class="price-note">
        המחירים בדולר ארה״ב. תשלום חודשי, בתחילת כל חודש עבודה.
        <strong>תקציב המדיה אינו כלול בסכום זה</strong> ומחויב ישירות על ידי Meta בחשבון המודעות שלכם.
      </p>
    </div>

    <div class="hosting-card">
      <div>
        <span class="extras-tag">תשלום נוסף</span>
