<script is:inline define:vars={{ MONTHLY, PERIOD, CLIENT, CLIENT_ID }}>
(() => {
  const form = document.getElementById('proposal-sign');
  const success = document.getElementById('sign-success');
  const canvas = /** @type {HTMLCanvasElement} */(document.getElementById('signature'));
  const ctx = canvas?.getContext('2d');
  let drawing = false;
  let hasInk = false;

  if (canvas && ctx) {
    const dpr = Math.max(1, window.devicePixelRatio || 1);
    function setupCanvas() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineWidth = 2.2;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#1a1a1a';
    }
    setupCanvas();
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const data = canvas.toDataURL();
        setupCanvas();
        const img = new Image();
        img.onload = () => ctx.drawImage(img, 0, 0, canvas.width / dpr, canvas.height / dpr);
        img.src = data;
      }, 150);
    });

    function pos(e) {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }
    function onDown(e) {
      drawing = true;
      canvas.setPointerCapture?.(e.pointerId);
      const { x, y } = pos(e);
      ctx.beginPath();
      ctx.moveTo(x, y);
      e.preventDefault();
    }
    function onMove(e) {
      if (!drawing) return;
      const { x, y } = pos(e);
      ctx.lineTo(x, y);
      ctx.stroke();
      hasInk = true;
      e.preventDefault();
    }
    function onUp(e) {
      if (!drawing) return;
      drawing = false;
      canvas.releasePointerCapture?.(e.pointerId);
    }
    canvas.addEventListener('pointerdown', onDown);
    canvas.addEventListener('pointermove', onMove);
    canvas.addEventListener('pointerup', onUp);
    canvas.addEventListener('pointercancel', onUp);
    canvas.addEventListener('pointerleave', onUp);

    document.getElementById('sig-clear')?.addEventListener('click', () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasInk = false;
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!hasInk) {
      alert('נדרשת חתימה לפני האישור.');
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries());
    const signature = canvas?.toDataURL('image/png');

    // סיכום שנכנס כמו שהוא ל-PDF החתום ולמייל
    const summary = {
      title: 'ניהול פלאשי ל-ג׳ף מדיה',
      client: `${CLIENT} · ח.פ ${CLIENT_ID}`,
      project: 'פלאשי · WordPress / WooCommerce · ניהול חודשי',
      lede: 'ניהול מלא של פלאשי על גבי WordPress / WooCommerce: בניית קמפיינים, הקמה וניהול של אוטומציות, ועיצוב של כל מה שנשלח.',
      items: [
        { label: 'ניהול פלאשי — קמפיינים, אוטומציות ועיצוב', detail: 'חיבור ל-WordPress / WooCommerce ובדיקת סנכרון · בניית קמפיינים במייל וב-SMS · הקמה וניהול אוטומציות, כולל אוטומציות קאסטום · עיצוב תבנית, קמפיינים ומיילים · דוח חודשי', amount: `${MONTHLY} ₪ / ${PERIOD}` },
      ],
      total: { label: `סה״כ ל${PERIOD} לפני מע״מ`, amount: `${MONTHLY} ₪` },
      extras: ['התקשרות מחודש לחודש, ללא תקופת התחייבות'],
      terms: 'המחיר אינו כולל מע״מ. חיוב חודשי בתחילת כל חודש עבודה. סיום בהודעה של 30 יום מראש. מנוי פלאשי, צילום והפקת חומרים ופיתוח באתר אינם כלולים. עלות שליחת SMS מכוסה בטעינת קרדיטים בחשבון הפלאשי של הלקוח.',
      confirms: [
        'אישור היקף העבודה כפי שתואר בהצעה',
        `אישור מחיר: ${MONTHLY} ₪ + מע״מ ל${PERIOD}`,
        'התחייבות להעמיד הרשאות גישה וחומרי מותג, ואישור שרשימת התפוצה נאספה בהסכמה',
      ],
    };

    try {
      const res = await fetch('/api/proposal-sign', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ proposal: 'jeff-flashy', ...data, signature, summary, signedAt: new Date().toISOString() }),
      });
      if (res.ok || res.status === 202) {
        form.style.display = 'none';
        success.removeAttribute('hidden');
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        alert('משהו השתבש. נסו שוב או שלחו לי במייל ישירות.');
      }
    } catch {
      alert('משהו השתבש בחיבור. נסו שוב.');
    }
  });
})();
</script>

