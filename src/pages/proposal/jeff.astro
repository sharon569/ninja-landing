---
import Layout from '../../layouts/Layout.astro';

/* ---------------------------------------------------------------------------
 * מחיר — נקבע מול שרון: 2,500 ₪ + מע״מ.
 * MONTHLY הוא דמי הניהול החודשיים, לפני מע״מ.
 * PERIOD הוא יחידת החיוב — אם ההצעה חד-פעמית ולא חודשית, לשנות כאן ובכותרת סעיף המחיר.
 * ------------------------------------------------------------------------- */
const MONTHLY = '2,500';
const PERIOD = 'חודש';

const CLIENT = 'ג׳ף מדיה בע״מ';
const CLIENT_ID = '516047347';

// שלושת מרכיבי השירות — זה כל מה שההצעה מכסה
const pillars = [
  {
    tag: 'מרכיב 1',
    name: 'בניית קמפיינים',
    line: 'דיוורים יזומים במייל וב-SMS — מבצע, השקה, חג, תוכן.',
    body: 'כל קמפיין נבנה אצלנו מקצה לקצה, במייל וב-SMS: בחירת קהל וסגמנט, כתיבת המסר, עיצוב, בדיקות תצוגה במובייל ובדסקטופ, תזמון ושליחה. אתם מאשרים לפני שזה יוצא — ומקבלים אחר כך את המספרים.',
  },
  {
    tag: 'מרכיב 2',
    name: 'ניהול אוטומציות',
    line: 'מסעות לקוח שרצים לבד, 24/7.',
    body: 'אוטומציות שמופעלות מההתנהגות של הגולש והלקוח בחנות — הרשמה, נטישת עגלה, רכישה, היעלמות. אנחנו בונים אותן, מחברים אותן לנתוני WooCommerce, ועוקבים אחריהן באופן שוטף כדי לתקן ולשפר. מעבר למסעות הבסיס, גם אוטומציות קאסטום שנתפרות לעסק שלכם כלולות.',
  },
  {
    tag: 'מרכיב 3',
    name: 'עיצוב',
    line: 'כלול במחיר — לא סעיף נפרד.',
    body: 'תבנית מייל ממותגת לפי השפה הגרפית שלכם, ועיצוב של כל קמפיין וכל מייל באוטומציה: באנרים, בלוקים של מוצרים וכפתורים. הכול מותאם למובייל, שם נפתחים רוב המיילים.',
  },
];

// מפת האוטומציות — מה נבנה ובאיזה סדר
const automations = [
  {
    type: 'ברוכים הבאים',
    trigger: 'הרשמה לרשימת התפוצה או למועדון',
    why: 'הרגע שבו הנרשם הכי קשוב. סדרת פתיחה שמציגה את המותג ומובילה לרכישה ראשונה.',
    prio: 'ראשון',
  },
  {
    type: 'עגלה נטושה',
    trigger: 'מוצר נוסף לעגלה ב-WooCommerce והרכישה לא הושלמה',
    why: 'הלקוח כבר בחר מוצר. תזכורת מתוזמנת עם תכולת העגלה מחזירה חלק מהרכישות האלה.',
    prio: 'ראשון',
  },
  {
    type: 'אחרי רכישה',
    trigger: 'הזמנה שהושלמה בחנות',
    why: 'תודה, מידע שימושי על המוצר, ובקשת ביקורת — הבסיס לרכישה השנייה.',
    prio: 'ראשון',
  },
  {
    type: 'נטישת גלישה',
    trigger: 'צפייה במוצר או בקטגוריה בלי הוספה לעגלה',
    why: 'פנייה עדינה למי שהתעניין ולא התקדם, עם המוצרים שבהם צפה.',
    prio: 'שני',
  },
  {
    type: 'רכישה חוזרת',
    trigger: 'פרק זמן שעבר מאז ההזמנה האחרונה, לפי סוג המוצר',
    why: 'תזכורת בזמן שבו הגיוני לקנות שוב, עם המלצות לפי מה שנרכש.',
    prio: 'שני',
  },
  {
    type: 'החזרת לקוחות רדומים',
    trigger: 'לקוח שלא קנה ולא פתח מיילים תקופה ארוכה',
    why: 'ניסיון החזרה אחד מסודר — ומי שלא מגיב יוצא מהדיוור השוטף, כדי לשמור על איכות הרשימה.',
    prio: 'שלישי',
  },
  {
    type: 'אוטומציות קאסטום',
    trigger: 'כל טריגר שהעסק שלכם צריך — קטגוריה, מוצר, סכום הזמנה, תגית, תאריך או אירוע באתר',
    why: 'מסעות שנתפרים לתהליכים שלכם ולא קיימים כתבנית מוכנה. כלולים במחיר, ונבנים לפי סדר עדיפויות שנקבע יחד.',
    prio: 'לפי צורך',
  },
];

// תוכנית עבודה — לפי סדר תלות
const phases = [
  {
    n: 'שלב 1',
    title: 'חיבור ובדיקת המצב הקיים',
    when: 'תשתית',
    items: [
      '<strong>חיבור פלאשי לאתר.</strong> התקנה והגדרה של תוסף פלאשי ב-WordPress / WooCommerce, ובדיקה שקטלוג המוצרים, ההזמנות, העגלות ואנשי הקשר מסתנכרנים כמו שצריך.',
      '<strong>בדיקת מעקב.</strong> וידוא שאירועי הגלישה, ההוספה לעגלה והרכישה נרשמים — בלעדיהם האוטומציות לא מופעלות.',
      '<strong>מיפוי מה שכבר קיים.</strong> רשימות, טפסי הרשמה, פופאפים ואוטומציות שכבר רצים בחשבון — מה נשאר, מה מתוקן ומה מוחלף.',
      '<strong>הגדרות שליחה.</strong> אימות הדומיין השולח, כדי שהמיילים יגיעו לתיבת הדואר ולא לספאם.',
    ],
  },
  {
    n: 'שלב 2',
    title: 'תבנית ממותגת ואוטומציות הבסיס',
    when: 'בנייה',
    items: [
      '<strong>תבנית מייל ממותגת</strong> — לוגו, צבעים, פונטים ובלוקים קבועים, שכל קמפיין ואוטומציה נבנים עליה.',
      '<strong>שלוש אוטומציות הבסיס:</strong> ברוכים הבאים, עגלה נטושה ואחרי רכישה — כולל כתיבה, עיצוב ובדיקה מקצה לקצה לפני הפעלה.',
      '<strong>סגמנטים ראשונים</strong> — לקוחות, נרשמים שעוד לא קנו, ולקוחות חוזרים — כדי שכל קמפיין יישלח למי שהוא רלוונטי עבורו.',
    ],
  },
  {
    n: 'שלב 3',
    title: 'קמפיינים שוטפים',
    when: 'שוטף',
    items: [
      '<strong>לוח דיוור חודשי</strong> שנקבע יחד מראש — מבצעים, השקות, חגים ותוכן.',
      '<strong>בנייה מלאה של כל קמפיין</strong> — קהל, מסר, עיצוב, בדיקות ותזמון. שום דבר לא נשלח בלי אישור שלכם.',
      '<strong>סיכום אחרי כל שליחה</strong> — פתיחות, הקלקות, הזמנות והכנסה שיוחסה לקמפיין.',
    ],
  },
  {
    n: 'שלב 4',
    title: 'הרחבה ושיפור',
    when: 'אופטימיזציה',
    items: [
      '<strong>אוטומציות נוספות</strong> לפי סדר העדיפויות במפה — נטישת גלישה, רכישה חוזרת והחזרת לקוחות רדומים.',
      '<strong>אוטומציות קאסטום</strong> — מסעות שנבנים במיוחד לתהליכים של העסק שלכם, לפי צרכים שעולים תוך כדי עבודה.',
      '<strong>בדיקות A/B</strong> על שורות נושא, תזמונים והצעות — ועדכון האוטומציות לפי מה שעובד בפועל.',
      '<strong>ניקיון רשימה שוטף</strong> — הסרת כתובות לא פעילות, כדי לשמור על שיעורי הגעה לתיבת הדואר.',
    ],
  },
];

// מה קורה בכל חודש
const monthly = [
  {
    icon: 'wrench',
    title: 'ביצוע בפועל — לא המלצות',
    body: 'הקמפיינים, האוטומציות והעיצובים נבנים על ידינו בתוך חשבון הפלאשי שלכם. מה שנדרש מכם הוא אישור — לא עבודה.',
  },
  {
    icon: 'radar',
    title: 'מעקב שוטף אחרי האוטומציות',
    body: 'אוטומציה שהפסיקה לפעול אחרי עדכון באתר לא מודיעה על זה לאף אחד. אנחנו בודקים שהסנכרון עם WooCommerce תקין ושהמסעות ממשיכים לרוץ.',
  },
  {
    icon: 'report',
    title: 'דוח חודשי',
    body: 'מה נשלח, מה נפתח, מה הוקלק, וכמה הכנסה יוחסה לכל קמפיין ולכל אוטומציה — יחד עם התוכנית לחודש הבא.',
  },
];

// מה צריך מהלקוח לפני שמתחילים
const decisions = [
  {
    title: 'הרשאות גישה',
    body: 'משתמש מנהל בחשבון הפלאשי, וגישת ניהול לאתר ה-WordPress לצורך התקנה והגדרה של התוסף. בלי אלה חלק מהעבודה הופכת להנחיות במקום לביצוע.',
  },
  {
    title: 'חומרי מותג',
    body: 'לוגו, צבעים, פונטים ותמונות מוצר באיכות טובה. העיצוב שלנו נבנה על השפה הגרפית הקיימת שלכם — צילום והפקה של חומרים חדשים אינם חלק מההצעה.',
  },
  {
    title: 'רשימת תפוצה והסכמות',
    body: 'דיוור שיווקי נשלח רק למי שאישר לקבל אותו, כנדרש בחוק התקשורת ("חוק הספאם"). האחריות למקור הרשימה ולהסכמות היא שלכם; אנחנו דואגים שבכל הודעה יופיעו פרטי השולח ואפשרות הסרה.',
  },
  {
    title: 'איש קשר לאישורים',
    body: 'אדם אחד מטעמכם שמאשר קמפיינים ולוח דיוור. זמן האישור הוא מה שקובע בפועל את קצב השליחות.',
  },
];

const today = new Date().toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Layout
  title="הצעת מחיר · פלאשי ל-WordPress / WooCommerce · ג׳ף מדיה בע״מ — NINJA Digital"
  description="הצעת מחיר לניהול פלאשי באתר WordPress / WooCommerce — בניית קמפיינים, ניהול אוטומציות ועיצוב."
  noindex={true}
  hideFloatWA={true}
  hideNav={true}
>

<section class="proposal-hero">
  <div class="container">
    <span class="eyebrow">הצעת מחיר · NINJA Digital</span>
    <h1>פלאשי ל<em>ג׳ף מדיה</em> — קמפיינים, אוטומציות ועיצוב.</h1>
    <p class="lede">
      <strong>ניהול מלא של פלאשי על גבי WordPress / WooCommerce.</strong>
      אנחנו בונים את הקמפיינים, מקימים ומנהלים את האוטומציות, ומעצבים את כל מה שנשלח —
      במחיר חודשי אחד, כשהעיצוב כלול בו.
      ההצעה מפרטת מה נכנס, באיזה סדר עובדים, מה נדרש מכם ובכמה.
      תקפה ל-30 יום מתאריך השליחה.
    </p>

    <div class="meta">
      <div><span>לקוח</span><strong>{CLIENT}</strong></div>
      <div><span>ח.פ</span><strong>{CLIENT_ID}</strong></div>
      <div><span>פלטפורמה</span><strong>WordPress · WooCommerce</strong></div>
      <div><span>שירות</span><strong>פלאשי · ניהול חודשי</strong></div>
      <div><span>תאריך</span><strong>{today}</strong></div>
    </div>
  </div>
</section>

<section class="engines">
  <div class="container">
    <span class="eyebrow">מה כלול</span>
    <h2>שלושה מרכיבים. מחיר אחד.</h2>
    <p class="lede">
      פלאשי מחוברת לחנות ויודעת מי נרשם, מי צפה במה, מי נטש עגלה ומי קנה.
      <strong>העבודה שלנו היא להפוך את המידע הזה לפניות שנשלחות בזמן הנכון לאדם הנכון</strong> —
      חלקן יזומות (קמפיינים), חלקן אוטומטיות (מסעות לקוח), וכולן מעוצבות.
    </p>

    <div class="eng-grid">
      {pillars.map((e) => (
        <div class="eng-card">
          <span class="eng-tag">{e.tag}</span>
          <h3>{e.name}</h3>
          <p class="eng-line">{e.line}</p>
          <p>{e.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="gaps">
  <div class="container">
    <span class="eyebrow">מפת האוטומציות</span>
    <h2>שישה מסעות בסיס — ואוטומציות קאסטום.</h2>
    <p class="lede">
      אלה האוטומציות שחנות WooCommerce מרוויחה מהן הכי הרבה. הן נבנות לפי הסדר שבעמודה האחרונה —
      קודם אלה שהכי קרובות לרכישה — ואליהן מצטרפות אוטומציות קאסטום לפי הצרכים שלכם. <strong>הרשימה הסופית והסדר נסגרים יחד אחרי בדיקת החשבון</strong>,
      לפי מה שכבר קיים בו ולפי סוג המוצרים.
    </p>

    <div class="tscroll">
      <table>
        <thead>
          <tr>
            <th>אוטומציה</th>
            <th>מה מפעיל אותה</th>
            <th>למה היא שם</th>
            <th class="num">שלב</th>
          </tr>
        </thead>
        <tbody>
          {automations.map((a) => (
            <tr>
              <td class="kw">{a.type}</td>
              <td class="miss">{a.trigger}</td>
              <td class="miss">{a.why}</td>
              <td class="num accent">{a.prio}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="plan">
  <div class="container">
    <span class="eyebrow">תוכנית עבודה</span>
    <h2>ארבעה שלבים, בסדר הזה.</h2>
    <p class="lede">
      <strong>מתחילים מהחיבור לאתר, לא מהקמפיין הראשון.</strong>
      אוטומציה שנשענת על נתונים שלא מסתנכרנים פשוט לא תופעל — ולכן בדיקת הסנכרון
      עם WooCommerce קודמת לכל השאר.
    </p>

    {phases.map((p) => (
      <article class="phase">
        <header>
          <span class="pn">{p.n}</span>
          <h3>{p.title}</h3>
          <span class="when">{p.when}</span>
        </header>
        <ul>
          {p.items.map((i) => <li set:html={i} />)}
        </ul>
      </article>
    ))}
  </div>
</section>

<section class="included">
  <div class="container">
    <span class="eyebrow">מה נכנס בכל חודש</span>
    <h2>שלושה דברים שקורים תמיד.</h2>
    <div class="inc-grid">
      {monthly.map((m) => (
        <div class="inc-card">
          <div class="inc-icon" aria-hidden="true">
            {m.icon === 'wrench' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.7 6.3a4 4 0 0 1-5 5L4 17v3h3l5.7-5.7a4 4 0 0 1 5-5l2.3-2.3-3-3-2.3 2.3z"/></svg>
            )}
            {m.icon === 'radar' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/><path d="M12 12 19 7"/></svg>
            )}
            {m.icon === 'report' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
            )}
          </div>
          <h3>{m.title}</h3>
          <p>{m.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="decisions">
  <div class="container">
    <span class="eyebrow">לפני שמתחילים</span>
    <h2>ארבעה דברים שאנחנו צריכים מכם.</h2>
    <div class="dec-grid">
      {decisions.map((d) => (
        <div class="dec-card">
          <h3>{d.title}</h3>
          <p>{d.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="price">
  <div class="container">
    <span class="eyebrow">סיכום עלות</span>
    <h2>דמי ניהול חודשיים. העיצוב כלול.</h2>
    <div class="price-card">
      <div class="price-row">
        <span>ניהול פלאשי — קמפיינים, אוטומציות ועיצוב</span>
        <strong>{MONTHLY} ₪ / {PERIOD}</strong>
      </div>
      <div class="price-row sub"><span>חיבור פלאשי ל-WordPress / WooCommerce ובדיקת סנכרון</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>בניית קמפיינים במייל וב-SMS — קהל, כתיבה, בדיקות ותזמון</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>הקמה וניהול שוטף של אוטומציות — כולל אוטומציות קאסטום</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>עיצוב — תבנית ממותגת, קמפיינים ומיילים באוטומציות</span><strong>כלול</strong></div>
      <div class="price-row sub"><span>דוח חודשי</span><strong>כלול</strong></div>
      <div class="price-row sub timeline"><span>תקופת התחייבות</span><strong>ללא — חודש לחודש</strong></div>
      <div class="price-row total">
        <span>סה״כ ל{PERIOD}, לפני מע״מ</span>
        <strong>{MONTHLY} ₪</strong>
      </div>
      <p class="price-note">
