---
import Layout from '../../layouts/Layout.astro';
import { bank } from '../../data/unox-keyword-bank';

/* ---------------------------------------------------------------------------
 * מחיר — למלא לפני שליחה ללקוח.
 * MONTHLY הוא המחיר בפועל; LIST הוא מחיר המחירון שמוצג מחוק לידו.
 * שניהם זורמים לכרטיס המחיר, לתיבת האישור ולטקסט המשפטי.
 * ------------------------------------------------------------------------- */
const MONTHLY = '1,000';
const LIST = '2,500';
const PRICE_SET = !MONTHLY.includes('X');

// סיכומי בנק מילות המפתח — מחושבים מהמקור, לא מוקלדים ידנית
const BANK_KW = bank.reduce((s, c) => s + c.count, 0);
const BANK_VOL = bank.reduce((s, c) => s + c.vol, 0);
const CORE = bank.filter((c) => 'ABCDEF'.includes(c.letter));
const CORE_KW = CORE.reduce((s, c) => s + c.count, 0);
const CORE_VOL = CORE.reduce((s, c) => s + c.vol, 0);
const BRAND_VOL = bank.find((c) => c.letter === 'E')!.vol;
const NONBRAND_VOL = CORE_VOL - BRAND_VOL;
const NONBRAND_PCT = Math.round((NONBRAND_VOL / CORE_VOL) * 100);
const fmt = (n: number) => n.toLocaleString('en-US');

// מדדי הפתיחה — בנק מילות המפתח + מצב האתר + חשבון האדס
const kpis = [
  { k: 'מילות מפתח בבנק', v: fmt(BANK_KW), d: 'Keyword Planner · ישראל', tone: 'flat' },
  { k: 'חיפושים בחודש', v: fmt(BANK_VOL), d: 'סך הביקוש שמופה', tone: 'flat' },
  { k: 'ביקוש לא־מותגי', v: `${NONBRAND_PCT}%`, d: `${fmt(NONBRAND_VOL)} חיפושים/חודש`, tone: 'up' },
  { k: 'עמודי קטגוריה גנריים', v: '0', d: 'מתוך 94 עמודים באתר', tone: 'down' },
  { k: 'CPC שנמדד בחשבון', v: '9.24 ₪', d: 'קמפיין הסרץ׳ · 90 יום', tone: 'down' },
];

// מבנה האתר היום — מה כל קבוצת עמודים מכוונת אליו
const inventory = [
  { group: 'עמודי דגם', n: '45', targets: 'קודי דגם — XENA-04EU-EADV, XEVC-0511-E1RM', demand: 'אפס', tone: 'bad' },
  { group: 'עמודי סדרה', n: '15', targets: 'שמות ליין — BAKERLUX, CHEFTOP, BAKERTOP', demand: `${fmt(BRAND_VOL)} (מותג)`, tone: 'ok' },
  { group: 'עמודי בלוג', n: '24', targets: 'טכנולוגיית UNOX — ADAPTIVE.Cooking, DDC.Cloud', demand: 'לא ממופה לבנק', tone: 'mid' },
  { group: 'עמודי סגמנט', n: '5', targets: 'מסעדות, מאפיות, בתי קפה, דלי, מטבח מרכזי', demand: 'חלקי מתוך 1,050', tone: 'ok' },
  { group: 'עמודי ליבה', n: '5', targets: 'בית, אודות, יצירת קשר, קונפיגורטור, אפליקציה', demand: 'מותגי', tone: 'ok' },
  { group: 'עמודי קטגוריה גנריים', n: '0', targets: '"תנור תעשייתי", "תנור אפייה מקצועי", "קומביסטימר"', demand: `${fmt(NONBRAND_VOL)} — לא מכוסה`, tone: 'bad' },
];

// נתוני הקמפיין הפעיל — 9.6–6.9.2026, חשבון 935-948-3882
const paid = [
  { camp: 'UNOX Pmax — BAKERLUX Shopping', type: 'Performance Max', imp: '12,181', clk: '502', cost: '99 ₪', conv: '0' },
  { camp: 'UNOX Pmax — B2B תעשייתי/מוסדי', type: 'Performance Max', imp: '4,203', clk: '246', cost: '126 ₪', conv: '1' },
  { camp: 'UNOX Shopping — BAKERLUX', type: 'Shopping', imp: '1,899', clk: '18', cost: '57 ₪', conv: '0' },
  { camp: 'תנורים תעשייתים', type: 'Search', imp: '209', clk: '17', cost: '175 ₪', conv: '0' },
];

// עלות הקליק בפועל על ביטויי הליבה — מתוך קמפיין הסרץ׳
const cpc = [
  { kw: 'ציוד למטבח תעשייתי', cpc: '18.93 ₪', imp: '58', clk: '3' },
  { kw: 'תנורים תעשייתיים', cpc: '15.59 ₪', imp: '10', clk: '2' },
  { kw: 'תנור קומבי', cpc: '12.42 ₪', imp: '42', clk: '1' },
  { kw: 'תנור לקונדיטוריה', cpc: '9.32 ₪', imp: '3', clk: '1' },
  { kw: 'תנור תעשייתי', cpc: '7.87 ₪', imp: '31', clk: '6' },
  { kw: 'תנור אפיה תעשייתי', cpc: '7.00 ₪', imp: '19', clk: '1' },
];

// ביקוש אמיתי שגוגל כבר התאים לקמפיין — ואין לו עמוד באתר
const discovered = [
  { term: 'תנור אידוי פיתות', note: 'הביטוי עם הכי הרבה חשיפות בחשבון הישן. אין עמוד.' },
  { term: 'ציוד למאפיות', note: '16 חשיפות, 2 קליקים — ואין עמוד קטגוריה למאפיות.' },
  { term: 'תנור בגטים · תנור לחמניות · תנור לפיתות', note: 'שוק האפייה הישראלי מחפש במונחים שלו, לא במונחי הקטלוג.' },
  { term: 'קומביסטימר · תנור קונבקטומט', note: 'שתי איות חלופיות לאותו מוצר. אף אחת לא מופיעה באתר.' },
  { term: 'רציונל · rational · convotherm', note: 'קונים בהשוואה פעילה. אפס עמודי השוואה באתר.' },
  { term: 'קירוסקאי · מיברסה · גוספר', note: 'מתחרים ישראליים שגוגל כבר מקשר אליכם.' },
  { term: 'י פפר', note: '18 חשיפות — אנשים מחפשים את שם החברה ישירות.' },
  { term: 'فران · пароконвектомат', note: 'ביקוש בערבית וברוסית. פלח אמיתי בשוק הישראלי.' },
];

// הממצאים — למה יש עבודה
const findings = [
  {
    n: '01',
    title: 'האתר מדבר UNOX. השוק מחפש "תנור"',
    body: `60 מתוך 94 העמודים באתר — 45 עמודי דגם ו-15 עמודי סדרה — מכוונים לשמות מותג ולקודי דגם. סך הביקוש על כל מותג UNOX בישראל הוא ${fmt(BRAND_VOL)} חיפושים בחודש. הביקוש הלא-מותגי בליבה הוא ${fmt(NONBRAND_VOL)} חיפושים בחודש. האתר בנוי מצוין — הוא פשוט מכוון ל-${100 - NONBRAND_PCT}% מהשוק.`,
  },
  {
    n: '02',
    title: 'אין ולו עמוד קטגוריה גנרי אחד',
    body: '"תנור תעשייתי" — 320 חיפושים בחודש. "תנור אפייה תעשייתי" על שלוש איותיה — 420. "ציוד למטבח תעשייתי" — 170. "תנור קומביסטימר" — 110. לאף אחד מהם אין עמוד ייעודי באתר. חמשת עמודי הסגמנט הם נקודות הכניסה הלא-מותגיות היחידות שקיימות.',
  },
  {
    n: '03',
    title: '45 מתוך 94 הטייטלים נחתכים באמצע',
    body: 'הסיומת "· UNOX · י.פפר" נוספת ל-100% מהעמודים ואוכלת 14 תווים. התוצאה: 29 עמודי מוצר ו-16 כתבות בלוג עם טייטל שנחתך בשלוש נקודות — "ניקוי תנור מקצועי אוטומטי: למה רחיצה ידנית כבר לא מ… · UNOX · י.פפר". ב-4 עמודים הסיומת אף מוכפלת: "בלוג י.פפר · UNOX · UNOX · י.פפר".',
  },
  {
    n: '04',
    title: 'עמודי הדגם מבזבזים את הטייטל פעמיים',
    body: 'התבנית היום: "BAKERLUX classic XENA-04EU-EADV · XENA-04EU-EADV · UNOX · י.פפר". קוד הדגם מופיע פעמיים, ובאף אחד מ-45 עמודי הדגם אין מילה גנרית אחת בעברית — לא "תנור", לא "קונבקציה", לא "מקצועי". 45 עמודים שאי אפשר למצוא בלי לדעת את קוד הדגם מראש.',
  },
  {
    n: '05',
    title: 'רציונל הוא 1,230 חיפושים בחודש — ואין עמוד',
    body: '"רציונל" (390), "rational" (260), "תנור רציונל" (70), ועוד 74 וריאציות. אלה קונים שנמצאים בדיוק בשלב ההשוואה, עם כוונת רכישה גבוהה ותקציב מוגדר. בקמפיין הפעיל אנחנו כבר רואים אותם — "rational", "convotherm", "rational icombi pro xs". באתר אין ולו עמוד השוואה אחד.',
  },
  {
    n: '06',
    title: 'הבלוג טוב — ולא ממופה לבנק',
    body: '16 כתבות מקצועיות ברמה גבוהה: ADAPTIVE.Cooking, DDC.Cloud, אפיית קרואסון, sous-vide. כולן נכתבו מנקודת המבט של הטכנולוגיה. אף אחת לא מכוונת לביטוי מהבנק. זה נכס קיים שצריך מיפוי מחדש וקישור פנימי — לא כתיבה מאפס.',
  },
];

// תוכנית עבודה
const phases = [
  {
    n: 'חודש 1',
    title: 'לפתוח את המנוע — עמודי הקטגוריה שחסרים',
    when: 'ראש הקטגוריה · טכני',
    items: [
      '<strong>ארבעה עמודי קטגוריה חדשים</strong> מעל שכבת הסדרות הקיימת: <span class="u">תנור תעשייתי</span>, <span class="u">תנור אפייה מקצועי</span>, <span class="u">תנור קומבי / קומביסטימר</span>, <span class="u">ציוד למטבח תעשייתי</span>. כל אחד: מה זה, איך בוחרים גודל, גז מול חשמל, חד-פאזי מול תלת-פאזי, טווחי מחיר — ומשם קישור לסדרות ולדגמים הרלוונטיים. יחד: 2,560 חיפושים בחודש שאין להם היום בית.',
      '<strong>תיקון תבנית הטייטלים בכל 94 העמודים.</strong> קיצור הסיומת, ביטול ההכפלה ב-4 העמודים, וחיתוך חכם שלא מוחק את מילת המפתח. פעולה טכנית אחת שנוגעת בכל עמוד באתר.',
      '<strong>כתיבה מחדש של 45 טייטלי הדגם</strong> לתבנית שכוללת מילה גנרית: "תנור קונבקציה מקצועי 4 מגשים GN — BAKERLUX classic XENA-04EU". קוד הדגם נשאר, אבל מפסיק להיות הדבר היחיד.',
      '<strong>מיפוי 16 כתבות הבלוג הקיימות</strong> לביטויים מהבנק, וקישור פנימי מכל כתבה לעמוד הקטגוריה ולסדרה הרלוונטית.',
      '<strong>חיבור Search Console ומדידת קו הבסיס</strong> על כל 472 מילות הבנק, כדי שלכל מדד בהצעה הזו תהיה נקודת פתיחה מתועדת.',
    ],
  },
  {
    n: 'חודש 2',
    title: 'לפי סוג עסק — שם נמצאת כוונת הקנייה',
    when: 'סגמנטים · שוק ישראלי',
    items: [
      '<strong>העמקת חמשת עמודי הסגמנט הקיימים</strong> כך שיכוונו לביטוי הגנרי ולא רק לשם הסגמנט: <span class="u">/segments/restaurants</span> ל"תנור למסעדה" ו"ציוד למסעדה" (590 חיפושים), <span class="u">/segments/bakeries</span> ל"תנור למאפייה" ו"ציוד למאפיות".',
      '<strong>עמודי סגמנט חדשים</strong> לקונדיטוריה (110), קייטרינג ובית מלון — שלוש קטגוריות עם קטלוג מלא ובלי עמוד.',
      '<strong>עמודי האפייה הישראליים</strong> — פיתות, בגטים, לחמניות, בורקס. הביקוש הזה עלה מהקמפיין הפעיל שלכם, לא ממחקר תיאורטי, ואף מתחרה לא כתב עליו.',
      '<strong>סכמת Product על 45 עמודי הדגם</strong> — מפרט, זמינות, יצרן. התשתית לכרטיסי מוצר בתוצאות החיפוש.',
      '<strong>קישור פנימי מסודר</strong>: קטגוריה ← סגמנט ← סדרה ← דגם, ובחזרה. היום 45 עמודי הדגם כמעט מנותקים.',
    ],
  },
  {
    n: 'חודשים 3–4',
    title: 'לתפוס את קונה ההשוואה',
    when: 'מתחרים · מדריכי רכש',
    items: [
      '<strong>UNOX מול רציונל</strong> — עמוד השוואה ענייני ומבוסס מפרט. 720 חיפושים בחודש רק על צמד הביטויים הזה, וקונה שכבר החליט לקנות קומביסטימר.',
      '<strong>עמודי השוואה נוספים</strong>: Convotherm, Lainox, Eloma, Metos. כל אחד עם נפח קטן, וביחד עוד 510 חיפושים בחודש.',
      '<strong>מדריכי רכש</strong>: "כמה עולה תנור תעשייתי", "איך בוחרים תנור למסעדה", "מה זה קומביסטימר", "ההבדל בין קונבקציה לקומבי". ביטויים שקונה מקליד בדיוק לפני שהוא מרים טלפון.',
      '<strong>עמוד מותג הגנתי</strong> — "טופ שף" (110 חיפושים) הוא שם שהשוק משתמש בו ל-CHEFTOP. היום הוא לא מופיע באתר אפילו פעם אחת.',
      '<strong>סבב ראשון של תיקוני CTR</strong> — לפי מה ש-Search Console כבר יראה אחרי שלושה חודשים: מה מקבל חשיפות ולא נלחץ.',
    ],
  },
  {
    n: 'חודשים 5–6',
    title: 'לתפוס את הקונה לפני שהוא יודע מה הוא רוצה',
    when: 'TOFU · חיפוש AI · הגנה',
    items: [
      '<strong>תוכן פתיחת עסק</strong> — "תכנון מטבח למסעדה", "פתיחת מסעדה", "כמה עולה לפתוח מאפייה". 350 חיפושים בחודש עם ההצעות היקרות בכל הבנק — עד 49.67 ₪ לקליק. זה קונה שנמצא שלושה חודשים לפני הרכישה, ואף מתחרה לא נמצא שם.',
      '<strong>אופטימיזציה לחיפוש AI</strong> — ה-robots.txt כבר מאפשר במפורש ל-GPTBot, ClaudeBot, PerplexityBot ו-Google-Extended. הצעד הבא הוא לבנות את התוכן בפורמט שמנועים כאלה מצטטים: שאלה, תשובה ישירה, טבלת מפרט, מקור.',
      '<strong>הרחבת סכמת FAQ</strong> על עמודי הקטגוריה והסגמנט — הפורמט שגוגל מציג כ-Rich Result וש-AI Overviews שואב ממנו.',
      '<strong>הגנה על מה שכבר עובד</strong> — ניטור המיקומים המותגיים, זיהוי ירידות, ועדכון עמודים שנשחקו.',
      '<strong>סבב תוכן שני</strong> לפי הפערים שייפתחו בפועל — לא לפי רשימה שנכתבה בספטמבר.',
    ],
  },
];

// מה נכנס בכל חודש
const monthly = [
  {
    icon: 'wrench',
    title: 'יישום בפועל — אנחנו בנינו את האתר',
    body: 'הקוד אצלנו, ההרשאות אצלנו, המערכת מוכרת לנו. כל עמוד קטגוריה, כל טייטל, כל סכמה וכל קישור פנימי נכנסים לאתר על ידינו באותו שבוע. אין שלב שבו ההצעה הופכת לרשימת המלצות שמחכה למפתח.',
  },
  {
    icon: 'radar',
    title: 'ניטור על בנק של 472 מילים',
    body: 'הבנק שבהצעה הזו הוא גם רשימת המעקב. כל חודש נמדד המיקום של כל מילה, כמה מהן נכנסו לעשירייה הראשונה, וכמה חשיפות וקליקים הן ייצרו בפועל — מול קו הבסיס שנמדד בחודש הראשון.',
  },
  {
    icon: 'report',
    title: 'דוח חודשי ושיחת עבודה',
    body: 'מה נעשה החודש, מה זז במספרים, ומה בתור לחודש הבא. פלוס שיחה חודשית לסגירת עדיפויות — כי סדר העדיפויות בחודש 4 ייקבע לפי מה שהנתונים יראו, לא לפי מה שכתוב כאן היום.',
  },
];

// המדדים
const metrics = [
  { m: `מילים מהבנק ב-10 התוצאות הראשונות`, now: 'נמדד בחודש 1', why: 'המדד הראשי. מתוך 472 מילים — כמה מהן מדורגות בעמוד הראשון.' },
  { m: 'קליקים אורגניים לא־מותגיים', now: 'נמדד בחודש 1', why: `${fmt(NONBRAND_VOL)} חיפושים בחודש שהאתר כמעט לא נוכח בהם. זה מה שההצעה נועדה לשנות.` },
  { m: 'עמודי קטגוריה גנריים באתר', now: '0', why: 'היעד: 4 בחודש הראשון, 10–12 עד חודש 6. זה המדד שהכי בשליטתנו.' },
  { m: 'טייטלים תקינים', now: '49 / 94', why: '45 עמודים עם טייטל חתוך, 4 עם סיומת כפולה. היעד: 94 מתוך 94 עד סוף חודש 1.' },
  { m: 'חשיפות אורגניות · חודשי', now: 'נמדד בחודש 1', why: 'המדד המקדים. חשיפות זזות לפני קליקים, וקליקים לפני לידים.' },
  { m: 'לידים מהאתר', now: 'נמדד בחודש 1', why: 'טופס יצירת הקשר והקונפיגורטור. המדד היחיד שבאמת נחשב.' },
  { m: 'מיקום ממוצע על ביטויי המתחרים', now: 'לא מדורג', why: '1,230 חיפושים בחודש של קונים בהשוואה פעילה. היום אין להם עמוד לנחות עליו.' },
];

// החלטות הלקוח
const decisions = [
  {
    title: 'יד שנייה — 1,590 חיפושים בחודש',
    body: '"תנור תעשייתי יד 2" (260), "ציוד למסעדה יד 2" (390), "תנור קומביסטימר יד 2" (70) ועוד 31 וריאציות. זה הביקוש השני בגודלו בבנק, והוא רלוונטי רק אם י.פפר מוכרים או מתווכים ציוד משומש. אם כן — זה עמוד אחד שנכנס בחודש 2. אם לא — יש אפשרות שנייה: עמוד שתופס את הביקוש ומסביר למה תנור חדש באחריות יוצא זול יותר לאורך זמן. שתי האפשרויות לגיטימיות, וההחלטה עסקית ולא שיווקית.',
  },
  {
    title: 'פיצה — 4,440 חיפושים, וקטלוג שלא תואם',
    body: 'זה הביקוש הגדול ביותר שמופה: "תנור פיצה" (1,000), "טאבון לפיצה" (390), "תנור לפיצריה" (320). אבל רובו מחפש תנור אבן, טאבון או מסוע — והקטלוג הישראלי שלכם לא כולל אותם. ההמלצה שלנו: לא לרדוף אחרי הנפח הזה. לכוון רק ל"תנור לפיצריה" דרך SPEED.Pro ו-BAKERLUX, ולוותר על השאר. אם יש כוונה להרחיב קטלוג — זה משנה את התמונה, וכדאי שנדע מראש.',
  },
  {
    title: 'מחירים באתר — כן או לא',
    body: '"תנור תעשייתי מחיר", "תנור unox מחיר", "קומביסטימר מחיר", "כמה עולה לפתוח מאפייה" — הביקוש למחיר קיים בכל אשכול בבנק. גוגל מעדיף עמודים שנותנים תשובה, ובלי מספר על העמוד קשה לדרג על הביטויים האלה. הפשרה המקובלת ב-B2B היא טווח מחיר לכל סדרה במקום מחירון מלא. זו החלטה מסחרית שלכם, ולא נעשה בה צעד בלי אישור.',
  },
];

const today = new Date().toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Layout
  title="הצעת מחיר · קידום אורגני · UNOX ישראל — י. פפר בע״מ — NINJA Digital"
  description="הצעת מחיר לקידום אורגני של unox.co.il עבור י. פפר בע״מ. בנק של 472 מילות מפתח, תוכנית עבודה של שישה חודשים, ויישום ישיר באתר."
  noindex={true}
  hideFloatWA={true}
  hideNav={true}
>

<section class="proposal-hero">
  <div class="container">
    <span class="eyebrow">הצעת מחיר · NINJA Digital</span>
    <h1>קידום אורגני ל<em>UNOX ישראל</em>.</h1>
    <p class="lede">
      <strong>האתר שבנינו לכם עובד. הוא פשוט מכוון ל-{100 - NONBRAND_PCT}% מהשוק.</strong>
      מיפינו {fmt(BANK_KW)} מילות מפתח עם {fmt(BANK_VOL)} חיפושים בחודש בישראל.
      {fmt(BRAND_VOL)} מהם מחפשים את UNOX בשם — ולזה יש כבר 60 עמודים.
      {fmt(NONBRAND_VOL)} מחפשים "תנור תעשייתי", "תנור אפייה מקצועי" או "קומביסטימר" — ולזה אין ולו עמוד אחד.
      ההצעה הזו מפרטת בדיוק אילו עמודים נבנים, באיזה סדר, ולפי איזה ביקוש נמדד. תקפה ל-30 יום.
    </p>

    <div class="meta">
      <div><span>לקוח</span><strong>י. פפר בע״מ · ח.פ 511029233</strong></div>
      <div><span>נכס</span><strong>unox.co.il</strong></div>
      <div><span>שירות</span><strong>קידום אורגני · ריטיינר חודשי</strong></div>
      <div><span>תאריך</span><strong>{today}</strong></div>
    </div>
  </div>
</section>

<section class="state">
  <div class="container">
    <span class="eyebrow">נקודת הפתיחה</span>
    <h2>זו לא בעיה טכנית. זו בעיית כיסוי.</h2>
    <p class="lede">
      האתר בנוי היטב: תוכן מוגש מהשרת, סכמת Organization, Brand, FAQPage, BreadcrumbList ו-LocalBusiness
      קיימת ותקינה, ה-robots.txt מאפשר במפורש לכל מנועי ה-AI, ומפת האתר מלאה ומעודכנת.
      <strong>אין כאן חוב טכני לשלם.</strong> מה שאין זה עמודים שמכוונים למילים שהשוק באמת מקליד —
      וזה, במקרה, בדיוק סוג העבודה שקידום אורגני עושה הכי טוב.
    </p>

    <div class="kpis">
      {kpis.map((k) => (
        <div class="kpi">
          <div class="k">{k.k}</div>
          <div class="v">{k.v}</div>
          <div class={`d ${k.tone}`}>{k.d}</div>
        </div>
      ))}
    </div>
    <p class="src">
      מקורות: Google Keyword Planner (ישראל · עברית · Google Search) · חשבון Google Ads 935-948-3882, 9.6–6.9.2026 ·
      סריקת 94 העמודים ב-sitemap.xml של unox.co.il, 7.9.2026
    </p>

    <div class="tscroll">
      <table>
        <thead>
          <tr>
            <th>קבוצת עמודים</th>
            <th class="num">כמות</th>
            <th>למה הם מכוונים היום</th>
            <th class="num">ביקוש חודשי מולם</th>
          </tr>
        </thead>
        <tbody>
          {inventory.map((i) => (
            <tr>
              <td class="kw">{i.group}</td>
              <td class="num">{i.n}</td>
              <td class="miss">{i.targets}</td>
              <td class={`num inv-${i.tone}`}>{i.demand}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="callout">
      <h4>השורה התחתונה של הטבלה</h4>
      <p>
        60 עמודים נלחמים על {fmt(BRAND_VOL)} חיפושים בחודש. אפס עמודים נלחמים על {fmt(NONBRAND_VOL)}.
        <strong>זה לא כשל של האתר — ככה בונים אתר קטלוג, ונכון שכך הוא נבנה.</strong>
        אבל שכבת הקטגוריה שיושבת מעל הקטלוג היא עבודה נפרדת, והיא זו שמביאה את הקונה
        שעדיין לא יודע ש-UNOX קיימת.
      </p>
    </div>
  </div>
</section>

<section class="bankwrap">
  <div class="container">
    <span class="eyebrow">בנק מילות המפתח</span>
    <h2>{fmt(BANK_KW)} מילים. {fmt(BANK_VOL)} חיפושים בחודש.</h2>
    <p class="lede">
      זה לא רשימת רעיונות. כל מילה כאן נשלפה מ-Google Keyword Planner עם נפח חיפוש מדוד בישראל,
      רמת תחרות והצעת מחיר אמיתית לקליק. הבנק מחולק לשמונה אשכולות, כל אשכול ממופה לשלב בתוכנית העבודה,
      וכל אשכול הופך לעמוד או לקבוצת עמודים באתר.
      <strong>הבנק הזה הוא גם רשימת המעקב</strong> — כל חודש נמדד מה זז בתוכו.
    </p>

    <div class="bank-summary">
      {bank.map((c) => (
        <a class={`bs-card ph-${c.phase === '—' ? 'hold' : c.phase}`} href={`#cluster-${c.letter}`}>
          <span class="bs-letter">{c.letter}</span>
          <span class="bs-name">{c.name}</span>
          <span class="bs-vol">{fmt(c.vol)}<small> חיפושים/חודש</small></span>
          <span class="bs-count">{c.count} מילים</span>
          <span class="bs-phase">{c.phase === '—' ? 'דורש החלטה' : `שלב ${c.phase}`}</span>
        </a>
      ))}
    </div>

    {bank.map((c) => (
      <article class="cluster" id={`cluster-${c.letter}`}>
        <header>
          <span class="cl-letter">{c.letter}</span>
          <div class="cl-head">
            <h3>{c.name}</h3>
            <p class="cl-sub">{c.sub}</p>
          </div>
          <div class="cl-stats">
            <span class="cl-vol">{fmt(c.vol)}</span>
            <span class="cl-lbl">חיפושים/חודש · {c.count} מילים</span>
          </div>
        </header>
        <p class="cl-why">{c.why}</p>
        <div class="tscroll">
          <table>
            <thead>
              <tr>
                <th>מילת מפתח</th>
                <th class="num">חיפושים/חודש</th>
                <th class="num">תחרות</th>
                <th class="num">הצעה לקליק (₪)</th>
              </tr>
            </thead>
            <tbody>
              {c.kws.map((k) => (
                <tr>
                  <td class="kw kwterm">{k.t}</td>
                  <td class="num accent">{fmt(k.v)}</td>
                  <td class={`num comp-${k.c.toLowerCase()}`}>{k.c === 'HIGH' ? 'גבוהה' : k.c === 'MEDIUM' ? 'בינונית' : k.c === 'LOW' ? 'נמוכה' : '—'}</td>
                  <td class="num bid">{k.b}</td>
                </tr>
              ))}
            </tbody>
            {c.tail > 0 && (
              <tfoot>
                <tr>
                  <td class="kw">+ {c.tail} מילות זנב ארוך</td>
                  <td class="num">&lt; 10</td>
                  <td colspan="2" class="miss">נכללות בבנק ובמעקב. נפח בודד נמוך, אך ביחד הן משמעותיות ותחרותן כמעט אפסית.</td>
                </tr>
              </tfoot>
            )}
          </table>
        </div>
      </article>
    ))}

    <div class="callout">
      <h4>למה הבנק הזה שווה יותר ממחקר מילים רגיל</h4>
      <p>
        הוא לא נבנה מניחוש. הזרעים למחקר נלקחו מכל ליין מוצרים בקטלוג שלכם, מכל סוג עסק שאתם משרתים,
        משמות כל המתחרים בשוק, ומכתובת האתר עצמה. אחר כך הוא <strong>הוצלב מול מונחי החיפוש
        האמיתיים שכבר רצים בקמפיין הפעיל שלכם</strong> — ושם עלו דברים ששום כלי לא היה מציע לבד:
        "תנור אידוי פיתות", "ציוד למאפיות", "קירוסקאי", וביקוש בערבית וברוסית.
      </p>
    </div>
  </div>
</section>

<section class="paid">
  <div class="container">
    <span class="eyebrow">מה הקמפיין הפעיל כבר הוכיח</span>
    <h2>הביקוש קיים. התקציב לא מספיק כדי לכסות אותו.</h2>
    <p class="lede">
      בתשעים הימים האחרונים החשבון ייצר 783 קליקים ב-457 ₪. הנתון החשוב הוא לא הזה — אלא זה:
      <strong>קמפיין הסרץ׳, היחיד שמכוון לביטויי הליבה, קיבל 209 חשיפות בסך הכול.</strong>
      באותה תקופה היו כ-6,500 חיפושים על אותם ביטויים בדיוק. כלומר נוכחות של כ-3%.
      זה לא כשל ניהולי — זה מה שקורה כשמנסים לכסות ביקוש של {fmt(BANK_VOL)} חיפושים בחודש בתקציב הזה.
    </p>

    <div class="tscroll">
      <table>
        <thead>
          <tr>
            <th>קמפיין</th>
            <th>סוג</th>
            <th class="num">חשיפות</th>
            <th class="num">קליקים</th>
            <th class="num">עלות</th>
            <th class="num">המרות</th>
          </tr>
        </thead>
        <tbody>
          {paid.map((p) => (
            <tr>
              <td class="kw">{p.camp}</td>
              <td class="miss">{p.type}</td>
              <td class="num">{p.imp}</td>
              <td class="num">{p.clk}</td>
              <td class="num">{p.cost}</td>
              <td class={`num ${p.conv === '0' ? 'inv-bad' : 'accent'}`}>{p.conv}</td>
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <td class="kw">סה״כ · 90 יום</td>
            <td class="miss">—</td>
            <td class="num accent">18,492</td>
            <td class="num accent">783</td>
            <td class="num accent">457 ₪</td>
            <td class="num accent">1</td>
          </tr>
        </tfoot>
      </table>
    </div>

    <h3 class="sub-h">וכמה עולה קליק אחד על ביטויי הליבה</h3>
    <div class="tscroll">
      <table>
        <thead>
          <tr>
            <th>מילת מפתח בקמפיין</th>
            <th class="num">עלות ממוצעת לקליק</th>
            <th class="num">חשיפות · 90 יום</th>
            <th class="num">קליקים</th>
          </tr>
        </thead>
        <tbody>
          {cpc.map((c) => (
            <tr>
              <td class="kw">{c.kw}</td>
              <td class="num accent">{c.cpc}</td>
              <td class="num">{c.imp}</td>
              <td class="num">{c.clk}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="callout">
      <h4>ההשוואה שהופכת את ההצעה הזו לפשוטה</h4>
      <p>
        עלות הקליק הממוצעת שנמדדה בחשבון שלכם היא <strong>9.24 ₪</strong>.
        משמעות הדבר: 1,000 ₪ בגוגל אדס קונים כ-108 קליקים בחודש — וברגע שמפסיקים לשלם, הם נעצרים באותו יום.
        אותם 1,000 ₪ בקידום אורגני קונים עמודים שנשארים באתר, מדרגים לאורך שנים,
        ועובדים על כל {fmt(BANK_VOL)} החיפושים במקביל.
        <strong>זה לא במקום הקמפיין — זה מה שהופך אותו לזול יותר,</strong> כי עמוד נחיתה שמדורג
        אורגנית משפר גם את ציון האיכות ומוריד את ה-CPC.
      </p>
    </div>

    <h3 class="sub-h">ביקוש שגוגל כבר מצא אצלכם — ואין לו עמוד</h3>
    <p class="lede narrow">
      אלה מונחי חיפוש אמיתיים שהמערכת התאימה לקמפיין שלכם בתשעים הימים האחרונים.
      כל שורה כאן היא אדם שחיפש, ראה אתכם, ולא מצא עמוד שעונה לו.
    </p>
    <div class="disc-grid">
      {discovered.map((d) => (
        <div class="disc">
          <span class="disc-term">{d.term}</span>
          <p>{d.note}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="findings">
  <div class="container">
    <span class="eyebrow">מה מצאנו באתר</span>
    <h2>שישה ממצאים שמסבירים את הפער.</h2>
    <div class="finds">
      {findings.map((f) => (
        <div class="find">
          <div class="fn">{f.n}</div>
          <div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="plan">
  <div class="container">
    <span class="eyebrow">תוכנית עבודה</span>
    <h2>בסדר הזה — לא אחרת.</h2>
    <p class="lede">
      הסדר הוא תלות אמיתית ולא העדפה. עמודי הקטגוריה נבנים ראשונים כי הם המקום שאליו כל שאר
      הקישורים הפנימיים יצביעו. תיקון הטייטלים נעשה בחודש הראשון כי הוא הפעולה הזולה ביותר עם
      ההשפעה הרחבה ביותר — 94 עמודים בבת אחת. תוכן ההשוואה מחכה לחודש 3 כי אין טעם להביא קונה
      שמשווה מול רציונל לעמוד קטגוריה שעדיין לא נבנה.
    </p>

    {phases.map((p) => (
      <article class="phase">
        <header>
          <span class="pn">{p.n}</span>
          <h3>{p.title}</h3>
          <span class="when">{p.when}</span>
        </header>
        <ul>
          {p.items.map((i) => <li set:html={i} />)}
        </ul>
      </article>
    ))}

    <p class="plan-note">
      מחודש 7 והלאה העבודה עוברת לקצב שוטף: הרחבת אשכולות שהוכיחו את עצמם, תוכן עונתי לקראת
      תקופות הרכש בענף, הגנה על מה שכבר מדורג, והמשך העמקה בזנב הארוך של הבנק —
      151 מילים שכל אחת מהן קטנה, וביחד הן שוק.
    </p>
  </div>
</section>

<section class="included">
  <div class="container">
    <span class="eyebrow">מה נכנס בכל חודש</span>
    <h2>שלושה דברים שקורים תמיד.</h2>
    <div class="inc-grid">
      {monthly.map((m) => (
        <div class="inc-card">
          <div class="inc-icon" aria-hidden="true">
            {m.icon === 'wrench' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.7 6.3a4 4 0 0 1-5 5L4 17v3h3l5.7-5.7a4 4 0 0 1 5-5l2.3-2.3-3-3-2.3 2.3z"/></svg>
            )}
            {m.icon === 'radar' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/><path d="M12 12 19 7"/></svg>
            )}
            {m.icon === 'report' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
            )}
          </div>
          <h3>{m.title}</h3>
