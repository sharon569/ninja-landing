<script is:inline define:vars={{ BUILD, YEARLY, WEEKS, FROM, CLIENT, CLIENT_ID }}>
(() => {
  const form = document.getElementById('proposal-sign');
  const success = document.getElementById('sign-success');
  const canvas = /** @type {HTMLCanvasElement} */(document.getElementById('signature'));
  const ctx = canvas?.getContext('2d');
  let drawing = false;
  let hasInk = false;

  if (canvas && ctx) {
    const dpr = Math.max(1, window.devicePixelRatio || 1);
    function setupCanvas() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineWidth = 2.2;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#1a1a1a';
    }
    setupCanvas();
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        const data = canvas.toDataURL();
        setupCanvas();
        const img = new Image();
        img.onload = () => ctx.drawImage(img, 0, 0, canvas.width / dpr, canvas.height / dpr);
        img.src = data;
      }, 150);
    });

    function pos(e) {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }
    function onDown(e) {
      drawing = true;
      canvas.setPointerCapture?.(e.pointerId);
      const { x, y } = pos(e);
      ctx.beginPath();
      ctx.moveTo(x, y);
      e.preventDefault();
    }
    function onMove(e) {
      if (!drawing) return;
      const { x, y } = pos(e);
      ctx.lineTo(x, y);
      ctx.stroke();
      hasInk = true;
      e.preventDefault();
    }
    function onUp(e) {
      if (!drawing) return;
      drawing = false;
      canvas.releasePointerCapture?.(e.pointerId);
    }
    canvas.addEventListener('pointerdown', onDown);
    canvas.addEventListener('pointermove', onMove);
    canvas.addEventListener('pointerup', onUp);
    canvas.addEventListener('pointercancel', onUp);
    canvas.addEventListener('pointerleave', onUp);

    document.getElementById('sig-clear')?.addEventListener('click', () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasInk = false;
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!hasInk) {
      alert('נדרשת חתימה לפני האישור.');
      return;
    }
    const data = Object.fromEntries(new FormData(form).entries());
    const signature = canvas?.toDataURL('image/png');

    // סיכום שנכנס כמו שהוא ל-PDF החתום ולמייל
    const summary = {
      title: 'אתר חנות ל-כן לחיות',
      client: `${CLIENT} · ע.מ ${CLIENT_ID}`,
      project: 'בניית אתר · WordPress + WooCommerce',
      lede: 'בניית חנות אונליין בוורדפרס ו-WooCommerce לחנות מזון וציוד לבעלי חיים, כולל העברת הקטלוג מהאתר הקיים.',
      items: [
        { label: 'בניית אתר חנות', detail: 'אפיון וסידור הקטלוג · עיצוב · פיתוח · העלאת מוצרים, תוכן ותמונות · סליקה, חשבוניות ומשלוחים · הפניות 301, SEO טכני ומדידה · הדרכה', amount: `${BUILD} ₪` },
        { label: 'אחסון, אבטחה וגיבוי', detail: 'שרתים ברמה הגבוהה ביותר · אבטחה · גיבוי יומי · SSL', amount: `${YEARLY} ₪ / שנה` },
      ],
      totals: [
        { label: 'תשלום שנתי לפני מע״מ', amount: `${YEARLY} ₪` },
      ],
      total: { label: 'סה״כ חד-פעמי לפני מע״מ', amount: `${BUILD} ₪` },
      extras: [`זמן ביצוע: ${WEEKS} בהתחייבות, ${FROM}`],
      terms: 'המחירים אינם כוללים מע״מ. 50% מקדמה עם אישור ההצעה ו-50% במסירה. צילום, כתיבת תוכן חדש, עמלות סליקה, מערכת חשבוניות, שליחויות, דומיין ורישיונות תוספים אינם כלולים.',
      confirms: [
        'אישור היקף העבודה כפי שתואר בהצעה',
        `אישור מחיר: ${BUILD} ₪ + מע״מ חד-פעמי, ו-${YEARLY} ₪ + מע״מ לשנה`,
        'אישור תנאי התשלום והתחייבות לספק גישות, חומרים ואישורים בזמן',
      ],
    };

    try {
      const res = await fetch('/api/proposal-sign', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ proposal: 'kenlahayot-woocommerce', ...data, signature, summary, signedAt: new Date().toISOString() }),
      });
      if (res.ok || res.status === 202) {
        form.style.display = 'none';
        success.removeAttribute('hidden');
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        alert('משהו השתבש. נסו שוב או שלחו לי במייל ישירות.');
      }
    } catch {
      alert('משהו השתבש בחיבור. נסו שוב.');
    }
  });
})();
</script>

