.hosting-card { margin-top: 20px; display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: 30px 36px; border: 1px solid rgba(120,180,255,0.2); border-radius: 22px; background: linear-gradient(180deg, rgba(120,180,255,0.05), rgba(255,255,255,0.01)); flex-wrap: wrap; }
