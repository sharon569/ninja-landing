---
import Layout from '../../layouts/Layout.astro';

/* ---------------------------------------------------------------------------
 * מחיר — נקבע מול שרון: 8,000 ₪ חד-פעמי לבנייה + 1,200 ₪ לשנה לאחסון. לפני מע״מ.
 * WEEKS — התחייבות לסיום. FROM — מאיזו נקודה נספרים השבועיים.
 * ------------------------------------------------------------------------- */
const BUILD = '8,000';
const YEARLY = '1,200';
const WEEKS = 'שבועיים';
const FROM = 'מרגע אישור ההצעה וקבלת הגישות והחומרים';

const CLIENT = 'כן לחיות';
const CLIENT_ID = '043438076';
const CONTACT = 'אלי';
const SITE = 'kenlahayot.com';

const stats = [
  { v: '6', k: 'עולמות מוצר' },
  { v: '200+', k: 'תתי-קטגוריות לסידור מחדש' },
  { v: 'WooCommerce', k: 'חנות מלאה על וורדפרס' },
  { v: '4', k: 'שלבי עבודה' },
  { v: '2', k: 'שבועות — בהתחייבות' },
  { v: '1,200 ₪', k: 'אחסון שנתי, לפני מע״מ' },
];

// מה שעלה בסריקה של האתר הקיים — רק מה שנראה בפועל
const findings = [
  {
    n: '01',
    title: 'טקסטים באנגלית שנשארו מהתבנית',
    body: 'בראש האתר מופיעים "Free Shipping On All Orders Over $100", "Need Help?", "My account" ו-"Wishlist". לקוח ישראלי שנכנס לחנות בעברית פוגש קודם כול אנגלית — וזה נראה כמו אתר שלא הושלם.',
  },
  {
    n: '02',
    title: 'דולר בבאנר, שקל בעגלה',
    body: 'הבאנר מבטיח משלוח חינם מעל 100 דולר, בזמן שהעגלה והמחירים בשקלים. מעבר לבלבול, זו הבטחת משלוח שלא ברור אם היא בכלל המדיניות שלכם.',
  },
  {
    n: '03',
    title: 'קישור מבצעים שמוביל לסביבת בדיקה',
    body: 'הכפתור "Today\'s Deal" בתפריט מפנה לכתובת test.kenlahayot.com — תת-דומיין של סביבת בדיקה, ולא לחנות עצמה. גולש שלוחץ על המבצעים יוצא מהאתר הראשי.',
  },
  {
    n: '04',
    title: 'מעל 200 תתי-קטגוריות בתפריט אחד',
    body: 'רשימת "כל הקטגוריות" ארוכה מאוד. קטלוג עמוק הוא יתרון, אבל כשהוא מוצג כרשימה אחת קשה למצוא בו מוצר — במיוחד במובייל. באתר החדש הוא מתארגן לפי בעל החיים, ובתוכו לפי סוג המוצר.',
  },
];

// מה שנבנה — עמוד אחרי עמוד
const pages = [
  { n: '01', title: 'עמוד הבית', body: 'כניסה ברורה לפי בעל חיים — כלבים, חתולים, מכרסמים, ציפורים, דגים — ולציוד המשלים. מבצעים, מוצרים נבחרים ובאנרים שמתחלפים מממשק הניהול, בלי מפתח.' },
  { n: '02', title: 'קטגוריות עם סינון', body: 'כל עולם מוצר מקבל עמוד משלו, עם סינון לפי סוג מוצר, מותג, משקל או גודל אריזה וטווח מחיר. כך קטלוג גדול נשאר קל לניווט.' },
  { n: '03', title: 'עמוד מוצר', body: 'תמונות, מחיר, בחירת משקל או גודל, מלאי, תיאור ומוצרים משלימים. כפתור ההוספה לעגלה נשאר זמין בגלילה במובייל.' },
  { n: '04', title: 'עגלה וקופה', body: 'מיני-עגלה, קופה קצרה בעמוד אחד, קופוני הנחה, סף משלוח חינם בשקלים לפי המדיניות שלכם, ובחירה בין משלוח לאיסוף עצמי.' },
  { n: '05', title: 'אזור אישי והזמנה חוזרת', body: 'היסטוריית הזמנות, כתובות שמורות ו"הזמנה חוזרת" בלחיצה אחת. מזון וחול נקנים שוב ושוב — ולכן החזרה לאותה הזמנה צריכה להיות הדבר הכי קל באתר.' },
  { n: '06', title: 'חיפוש', body: 'חיפוש עם השלמה אוטומטית ותמונות מוצר כבר תוך כדי הקלדה, כולל שמות מותגים בעברית ובאנגלית.' },
  { n: '07', title: 'אודות, צור קשר ושאלות נפוצות', body: 'פרטי החנות, טלפון, כפתור וואטסאפ, טופס פנייה, ושאלות נפוצות על משלוחים והחזרות.' },
  { n: '08', title: 'עמודים משפטיים ומיילים', body: 'תקנון, מדיניות פרטיות, משלוחים והחזרות והצהרת נגישות במבנה הנכון (נוסח משפטי סופי באחריותכם), ומיילי הזמנה ממותגים בעברית.' },
];

// מה נכנס מתחת למכסה המנוע
const systems = [
  {
    icon: 'card',
    title: 'סליקה ותשלומים',
    body: 'חיבור חברת סליקה ישראלית אחת — זו שאתם עובדים איתה היום או אחת לבחירתכם — כולל כרטיסי אשראי ותשלומים, ו-Bit / Apple Pay / Google Pay בכפוף למה שחברת הסליקה מספקת.',
  },
  {
    icon: 'invoice',
    title: 'חשבוניות אוטומטיות',
    body: 'חיבור למערכת חשבוניות אחת (חשבונית ירוקה, iCount, EZcount וכדומה), כך שכל הזמנה ששולמה מפיקה מסמך ונשלחת ללקוח בלי הקלדה ידנית.',
  },
  {
    icon: 'truck',
    title: 'משלוחים ואיסוף',
    body: 'אזורי משלוח, מחיר לפי אזור או לפי סכום, משלוח חינם מעל סף ואיסוף עצמי מהחנות. אם לחברת השליחויות שלכם יש תוסף WooCommerce מוכן — החיבור כלול.',
  },
  {
    icon: 'search',
    title: 'שמירה על מה שגוגל כבר מכיר',
    body: 'האתר הקיים כבר מופיע בגוגל. כתובות שמשתנות מקבלות הפניות 301, כדי שעמודים שמדורגים היום לא יאבדו את המיקום שלהם. בנוסף: כותרות ותיאורים, Schema של מוצר, sitemap וחיבור ל-Search Console.',
  },
  {
    icon: 'chart',
    title: 'מדידה',
    body: 'GA4 עם אירועי מסחר (צפייה, עגלה, קופה, רכישה עם ערך), Google Tag Manager ופיקסל מטא. ביום שתרצו לפרסם — הכול כבר מודד.',
  },
  {
    icon: 'bolt',
    title: 'מהירות, מובייל ונגישות',
    body: 'אופטימיזציית תמונות ו-caching, התאמה מלאה למובייל, ובנייה לפי הנחיות תקן הנגישות הישראלי 5568.',
  },
];

// שלבי העבודה — בתוך השבועיים
const phases = [
  {
    n: 'ימים 1–2',
    title: 'אפיון ומבנה קטלוג',
    when: 'אפיון',
    items: [
      '<strong>סידור הקטלוג מחדש.</strong> מעל 200 תתי-הקטגוריות מתארגנות לעץ ברור: בעל חיים, ובתוכו סוג מוצר. זו ההחלטה שהכי קשה לשנות אחר כך — ולכן היא ראשונה.',
      '<strong>מיפוי האתר הקיים.</strong> אילו מוצרים, תמונות ועמודים עוברים לאתר החדש, ואילו כתובות צריכות הפניה.',
      '<strong>סגירת ספקים.</strong> סליקה, חשבוניות ושליחויות — עם מי עובדים, ומה פרטי החיבור.',
    ],
  },
  {
    n: 'ימים 3–6',
    title: 'עיצוב והקמה',
    when: 'עיצוב',
    items: [
      '<strong>עיצוב לפי המותג שלכם</strong> — לוגו, צבעים ושפה שמתאימה לחנות חיות: עמוד בית, קטגוריה, מוצר, עגלה וקופה, במובייל ובדסקטופ.',
      '<strong>סבב תיקונים אחד על העיצוב</strong> לפני שממשיכים לפיתוח, כדי לעמוד בלוח הזמנים.',
      '<strong>הקמת וורדפרס ו-WooCommerce</strong> על סביבת בדיקה סגורה, עם קישור שאפשר לעקוב אחריו.',
    ],
  },
  {
    n: 'ימים 7–11',
    title: 'פיתוח, מוצרים וחיבורים',
    when: 'פיתוח',
    items: [
      '<strong>בניית כל העמודים</strong> בעברית מלאה (RTL) — בלי שאריות אנגלית מתבנית.',
      '<strong>העלאת מוצרים, תוכן ותמונות — כלולה.</strong> המוצרים, הקטגוריות, הטקסטים והתמונות מהאתר הקיים ומהחומרים שתספקו עולים לאתר החדש על ידינו, לתוך המבנה המסודר.',
      '<strong>חיבור סליקה, חשבוניות, משלוחים ומדידה</strong>, והרצת הזמנות בדיקה מקצה לקצה.',
    ],
  },
  {
    n: 'ימים 12–14',
    title: 'בדיקות, עלייה לאוויר והדרכה',
    when: 'השקה',
    items: [
      '<strong>בדיקות מלאות:</strong> מובייל, דסקטופ, דפדפנים, מהירות, וכל מסלול רכישה — כולל תשלום שנכשל.',
      '<strong>עלייה לדומיין</strong> {SITE} עם SSL, הפניות 301 מהכתובות הישנות והגשת sitemap לגוגל.',
      '<strong>הדרכה</strong> על ניהול הזמנות, מוצרים, מלאי, קופונים ובאנרים — כך שתוכלו לעדכן את האתר לבד.',
    ],
  },
].map((p) => ({ ...p, items: p.items.map((i) => i.replace('{SITE}', SITE)) }));

// מה בתשלום השנתי
const yearly = [
  'אחסון על שרתים ברמה הגבוהה ביותר',
  'אבטחת האתר',
  'גיבוי יומי',
  'תעודת SSL',
];

// החלטות שהן של הלקוח
const decisions = [
  {
    title: 'גישות לאתר הקיים',
    body: 'גישת ניהול לאתר הנוכחי ולחשבון האחסון שלו, וגישה לניהול הדומיין. בלי אלה אי אפשר להעביר את המוצרים ולהעלות את האתר החדש לכתובת הקיימת.',
  },
  {
    title: 'חברת סליקה וחשבוניות',
    body: 'החשבונות על שם העסק, ועמלות הסליקה משולמות על ידכם ישירות לספק. הכסף מהמכירות עובר ישירות אליכם ולא דרכנו.',
  },
  {
    title: 'מדיניות משלוחים',
    body: 'אזורי חלוקה, מחירים, סף למשלוח חינם ואיסוף עצמי — בשקלים, לפי מה שנכון לעסק. זה מה שיחליף את הבאנר הנוכחי.',
  },
  {
    title: 'חומרים ואישורים בזמן',
    body: 'לוגו, תמונות וטקסטים, ואדם אחד שמאשר את העיצוב תוך יום עסקים. ההתחייבות לשבועיים נשענת על זה — עיכוב באישור או בחומרים דוחה את מועד הסיום בהתאם.',
  },
];

// מה לא כלול — שקיפות מראש
const notIncluded = [
  'צילום מוצרים וכתיבת תוכן חדש (העלאת התוכן והתמונות הקיימים כלולה)',
  'עמלות סליקה, מנוי מערכת החשבוניות ודמי שליחויות',
  'חידוש דומיין ותיבות דואר',
  'רישיונות שנתיים לתוספים בתשלום, אם תבחרו בהם',
  'פיתוח חיבור ייעודי לספק שאין לו תוסף WooCommerce מוכן',
  'גרסה בשפה נוספת',
  'קידום ממומן או אורגני שוטף',
];

const today = new Date().toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Layout
  title="הצעת מחיר · בניית אתר וורדפרס · כן לחיות — NINJA Digital"
  description="הצעת מחיר לבניית אתר חנות בוורדפרס ו-WooCommerce לכן לחיות — חנות מזון וציוד לבעלי חיים."
  noindex={true}
  hideFloatWA={true}
  hideNav={true}
>

<section class="proposal-hero">
  <div class="container">
    <span class="eyebrow">הצעת מחיר · NINJA Digital</span>
    <h1>אתר חדש ל<em>כן לחיות</em> — בתוך שבועיים.</h1>
    <p class="lede">
      <strong>בניית חנות אונליין בוורדפרס ו-WooCommerce</strong> לחנות המזון והציוד לבעלי חיים:
      עיצוב, פיתוח, העלאת מוצרים, תוכן ותמונות, סליקה, חשבוניות, משלוחים, השקה והדרכה.
      ההצעה מפרטת מה נבנה, באיזה סדר ומה כלול במחיר. תקפה ל-30 יום מתאריך השליחה.
    </p>

    <div class="meta">
      <div><span>לקוח</span><strong>{CLIENT}</strong></div>
      <div><span>ע.מ</span><strong>{CLIENT_ID}</strong></div>
      <div><span>איש קשר</span><strong>{CONTACT}</strong></div>
      <div><span>אתר</span><strong>{SITE}</strong></div>
      <div><span>תאריך</span><strong>{today}</strong></div>
    </div>
  </div>
</section>

<section class="overview">
  <div class="container">
    <span class="eyebrow">במבט אחד</span>
    <h2>חנות מסודרת, בעברית מלאה, שמוכנה למכור.</h2>
    <div class="stats">
      {stats.map((s) => (
        <div class="stat"><strong>{s.v}</strong><span>{s.k}</span></div>
      ))}
    </div>
  </div>
</section>

<section class="findings">
  <div class="container">
    <span class="eyebrow">נקודת הפתיחה</span>
    <h2>ארבעה דברים שראינו באתר הקיים.</h2>
    <p class="lede">
      עברנו על {SITE} כפי שגולש רואה אותו. <strong>הקטלוג רחב ומכסה את כל עולמות המוצר</strong> —
      כלבים, חתולים, מכרסמים, ציפורים, דגים וציוד משלים. מה שחסר הוא המעטפת: סדר, שפה ואמינות.
      אלה ארבעת הדברים שהאתר החדש מתקן.
    </p>
    <div class="finds">
      {findings.map((f) => (
        <div class="find">
          <div class="fn">{f.n}</div>
          <div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="src">מקור: סריקה של {SITE} · נובמבר 2026 · עמוד הבית ועמוד קטגוריית הכלבים</p>
  </div>
</section>

<section class="pages">
  <div class="container">
    <span class="eyebrow">מה נבנה</span>
    <h2>עמוד אחרי עמוד.</h2>
    <p class="lede">
      כל העמודים נבנים ברספונסיביות מלאה ובעברית מלאה (RTL).
      הניהול כולו נעשה מממשק וורדפרס — מוצרים, מחירים, מלאי, באנרים ומבצעים מתעדכנים בלי מפתח.
    </p>
    <div class="finds">
      {pages.map((p) => (
        <div class="find">
          <div class="fn">{p.n}</div>
          <div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="callout">
      <h4>למה זה בנוי ככה</h4>
      <p>
        שק מזון נגמר, והלקוח צריך אותו שוב. <strong>בחנות חיות הלקוח הרווחי הוא זה שחוזר</strong> —
        ולכן האתר נמדד בשני מבחנים: כמה קל למצוא מוצר בקטלוג גדול, וכמה קל להזמין אותו שוב.
      </p>
    </div>
  </div>
</section>

<section class="included">
  <div class="container">
    <span class="eyebrow">מתחת למכסה המנוע</span>
    <h2>שישה דברים שאתר יפה לבד לא עושה.</h2>
    <div class="inc-grid">
      {systems.map((m) => (
        <div class="inc-card">
          <div class="inc-icon" aria-hidden="true">
            {m.icon === 'card' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M6 15h4"/></svg>
            )}
            {m.icon === 'invoice' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z"/><path d="M9 8h6M9 12h6"/></svg>
            )}
            {m.icon === 'truck' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 6h12v10H2zM14 10h4l3 3v3h-7"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
            )}
            {m.icon === 'chart' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m3 17 6-6 4 4 8-8"/><path d="M14 7h7v7"/></svg>
            )}
            {m.icon === 'search' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="6"/><path d="m20 20-4.35-4.35"/></svg>
            )}
            {m.icon === 'bolt' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>
            )}
          </div>
          <h3>{m.title}</h3>
          <p>{m.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="plan">
  <div class="container">
