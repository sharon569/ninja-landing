---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="צרו קשר עם NINJA Digital — פגישת אסטרטגיה חינם"
  description="רוצים לדבר על קמפיינים, אתר, SEO או פלאשי? פגישת אסטרטגיה אישית — חינם, ללא התחייבות. WhatsApp 054-582-2451 · sharon@samp.ninja"
  hideFloatWA={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPage",
      "name": "צרו קשר עם NINJA Digital",
      "description": "פגישת אסטרטגיה אישית — חינם, ללא התחייבות. WhatsApp, מייל וטלפון.",
      "url": "https://www.samp.ninja/contact",
      "inLanguage": "he-IL",
      "isPartOf": { "@id": "https://www.samp.ninja/#website" },
      "about": { "@id": "https://www.samp.ninja/#organization" },
      "mainEntity": {
        "@id": "https://www.samp.ninja/#organization"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "בית", "item": "https://www.samp.ninja/" },
        { "@type": "ListItem", "position": 2, "name": "צרו קשר", "item": "https://www.samp.ninja/contact" }
      ]
    })} />
  </Fragment>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow" data-reveal>צרו קשר</span>
    <h1 data-reveal>נתחיל. <em>בשקט.</em></h1>
    <p data-reveal>השאירו פרטים וניצור קשר בתוך 24 שעות עם תוכנית התקפה ראשונית.</p>
  </div>
</section>

<section class="contact" style="padding-top:40px">
  <div class="container contact-inner">
    <div class="contact-text">
      <span class="eyebrow" data-reveal>דרכי התקשרות</span>
      <h2 data-reveal>שלוש דרכים <em>להגיע אלינו.</em></h2>
      <p data-reveal>מענה מהיר תוך שעות העבודה. במקרי חירום — WhatsApp 24/7.</p>

      <address class="contact-direct">
        <a href="mailto:sharon@samp.ninja" class="cd" data-cursor="link">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2zm0 4l-8 5-8-5V6l8 5 8-5z"/></svg>
          <div><span class="cd-l">מייל</span><strong>sharon@samp.ninja</strong></div>
        </a>
        <a href="tel:+972545822451" class="cd" data-cursor="link">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 013 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.3 0 .7-.2 1l-2.3 2.1z"/></svg>
          <div><span class="cd-l">חייגו</span><strong>054-582-2451</strong></div>
        </a>
        <a href="https://wa.me/972545822451" class="cd" data-cursor="link">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.95.5 3.84 1.46 5.51L2 22l4.74-1.55a9.9 9.9 0 005.3 1.45h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.13-2.9-7-1.86-1.87-4.34-2.9-7-2.9z"/></svg>
          <div><span class="cd-l">WhatsApp</span><strong>054-582-2451</strong></div>
        </a>
      </address>
    </div>

    <form class="contact-form" id="leadForm" novalidate aria-labelledby="lead-form-title"
          action="/api/lead" method="POST" data-reveal>
      <h2 id="lead-form-title" class="visually-hidden">טופס יצירת קשר</h2>
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">

      <div class="field">
        <label for="name">שם מלא</label>
        <input type="text" id="name" name="name" required autocomplete="name" placeholder="הקלידו שם מלא" />
      </div>
      <div class="field">
        <label for="phone">טלפון</label>
        <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="050-0000000" />
      </div>
      <div class="field">
        <label for="email">דוא״ל</label>
        <input type="email" id="email" name="email" autocomplete="email" placeholder="name@business.co.il" />
      </div>
      <div class="field">
        <label for="topic">מעוניינים ב—</label>
        <select id="topic" name="topic">
          <option>גוגל אדס</option>
          <option>SEO אורגני</option>
          <option>בניית אתר / התממשקויות</option>
          <option>פלאשי / ניהול לקוחות</option>
          <option>מועדון לקוחות</option>
          <option>חבילה משולבת</option>
        </select>
      </div>
      <div class="field full">
        <label for="msg">פרטים נוספים</label>
        <textarea id="msg" name="msg" rows="4" placeholder="ספרו לנו על העסק שלכם..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary lg full" data-magnetic data-cursor="link">שלחו — נחזור אליכם תוך 24 שעות</button>
      <div class="form-status" id="formStatus" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

</Layout>
