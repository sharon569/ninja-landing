# === Supabase ===
# Get these from your Supabase project: Settings → API
# https://app.supabase.com/project/_/settings/api

# Public (exposed to browser, safe — RLS protects data)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-key

# Server-only (NEVER expose to browser — bypasses RLS)
# Used for admin actions like creating users, posting reports
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...your-service-role-key
