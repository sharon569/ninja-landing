// Agency SEO Analyzer — schema.
//
// Hosted on the shared Supabase Postgres (same DB as the ninja-landing portal).
// All analyzer tables live in the dedicated `analyzer` schema so they don't
// collide with the portal's `public.*` tables.
//
// Storage strategy:
//   - DB holds connection metadata + scan summaries + audit findings index.
//   - Full scan JSON payloads live on disk at data/<clientId>/scan-<id>.json
//     so we can re-run the audit engine against historical scans without
//     re-pulling from the plugin.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["analyzer"]
  // Connection URLs are set in prisma.config.ts (Prisma 7 moved them out of the schema).
}

model Client {
  id         String   @id @default(cuid())
  name       String
  baseUrl    String   @unique
  token      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lastInfo   String?  // JSON blob
  lastInfoAt DateTime?

  lastScanAt DateTime?

  // GSC property assigned to this client (e.g. "sc-domain:example.com" or
  // "https://www.example.com/"). Pulled from the shared agency GscAccount.
  gscPropertyUrl  String?
  gscLastSyncAt   DateTime?

  // =====================================================================
  // SEO Profile (Phase 1) — the "business brain" of the client.
  // All optional so existing rows stay valid. Drives every downstream
  // opportunity / recommendation engine.
  // =====================================================================

  // Business context
  vertical        String?    // service | ecommerce | local_business | medical | legal | home_services | saas | content_site | other
  language        String?    // he | en | ar | multi
  country         String?    // ISO code or free text (e.g. "IL", "US")
  serviceAreas    String[]   @default([])  // cities/regions for local businesses
  seoGoals        String?    // free-text business goals

  // SEO strategy
  targetPages     String[]   @default([])  // URLs of money pages
  competitors     String[]   @default([])  // competitor domains

  // Content & brand
  brandVoice      String?    // tone description
  notes           String?    // internal notes

  // Automation & approval policy
  automationLevel    String    @default("balanced") // strict | balanced | aggressive
  requireApprovalFor String[]  @default(["publish", "title_change", "meta_change", "content_change", "internal_link", "schema_change", "wordpress_update"])

  // Phase 10 — per-client automation toggles
  status                          String  @default("active") // active | paused | archived
  automationEnabled               Boolean @default(true)
  autoGscSyncEnabled              Boolean @default(true)
  autoTechAuditEnabled            Boolean @default(true)
  autoOpportunityAnalysisEnabled  Boolean @default(true)
  autoImpactReviewEnabled         Boolean @default(true)

  scans                   Scan[]
  gscDailyRows            GscDailyRow[]
  targetKeywords          TargetKeyword[]
  opportunities           Opportunity[]
  contentBriefs           ContentBrief[]
  internalLinkSuggestions InternalLinkSuggestion[]
  automationRuns          AutomationRun[]

  @@index([baseUrl])
  @@schema("analyzer")
}

// Phase 10 — log of every automation run (cron + manual). Parent agency
// runs have clientId=null and children inherit a "parentRunId" reference
// via the source field. Failures of one client don't fail siblings.
model AutomationRun {
  id            String   @id @default(cuid())
  runType       String   // agency_auto_sync | gsc_sync | technical_audit | opportunity_analysis | impact_review | full_client_refresh
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  status        String   @default("running") // queued | running | success | partial_success | failed | skipped
  triggeredBy   String?  // 'cron' | 'manual' | actor email
  parentRunId   String?

  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  durationMs    Int?

  summary       String?  // JSON blob with counts / details
  error         String?
  skippedReason String?

  createdAt     DateTime @default(now())

  @@index([clientId, startedAt(sort: Desc)])
  @@index([runType, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([parentRunId])
  @@schema("analyzer")
}

// Phase 3 — SEO opportunities. Generated by detector functions over GSC,
// keyword bank, profile, and audit findings.  Compound uniqueness on
// (clientId, type, keyword, page, query) gives natural dedupe on re-runs.
model Opportunity {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type              String                       // low_ctr | quick_win_position | high_impressions_no_clicks | declining_clicks | declining_position | target_keyword_not_ranking | target_keyword_needs_content | target_keyword_needs_optimization | cannibalization | new_query_growth | technical_seo_issue | content_gap | internal_link_opportunity
  title             String
  description       String
  evidence          String                       // JSON blob — raw metrics that triggered this
  recommendedAction String

  priorityScore     Int      @default(0)         // 0-100
  impact            String   @default("medium")  // low | medium | high
  effort            String   @default("medium")  // low | medium | high
  confidence        String   @default("medium")  // low | medium | high

  status            String   @default("detected") // detected | recommended | needs_human_review | approved | rejected | dismissed | manually_applied | monitoring | impact_reviewed

  // Dedupe identity. Empty strings rather than nulls so the UNIQUE works.
  relatedKeyword    String   @default("")
  relatedPage       String   @default("")
  relatedQuery      String   @default("")

  source            String?                      // detector name / "manual"

  // Phase 4 — approval workflow + manual-apply tracking
  approvedAt          DateTime?
  approvedBy          String?
  approvalNote        String?
  approvedActionType  String?   // title_meta_update | content_update | internal_link_update | new_content | technical_fix | schema_update | manual_review | other
  rejectedAt          DateTime?
  rejectedBy          String?
  manuallyAppliedAt   DateTime?
  manuallyAppliedBy   String?
  manualActionNote    String?
  manualActionUrl     String?
  monitoringStartedAt DateTime?
  impactReviewedAt    DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  detectedAt        DateTime @default(now())

  actionLogs              OpportunityActionLog[]
  baseline                ImpactBaseline?
  impactReviews           ImpactReview[]
  contentBriefs           ContentBrief[]
  internalLinkSuggestions InternalLinkSuggestion[]

  @@unique([clientId, type, relatedKeyword, relatedPage, relatedQuery])
  @@index([clientId, status])
  @@index([clientId, priorityScore(sort: Desc)])
  @@schema("analyzer")
}

// Phase 6 — internal-linking suggestion. Heuristic graph analysis over
// scan + GSC + keyword bank. No edge data from the plugin (counts only),
// so this is a candidate-pair recommender, not a true graph mutator.
model InternalLinkSuggestion {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  sourcePage      String
  sourceTitle     String?
  targetPage      String
  targetTitle     String?
  suggestedAnchor String
  reason          String
  evidence        String   // JSON

  priorityScore   Int      @default(0)
  impact          String   @default("medium")  // low | medium | high
  effort          String   @default("low")     // low | medium | high
  confidence      String   @default("medium")  // low | medium | high
  status          String   @default("suggested") // suggested | needs_human_review | approved | rejected | used | dismissed

  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  source          String?  // detector name

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, sourcePage, targetPage, suggestedAnchor])
  @@index([clientId, status])
  @@index([clientId, priorityScore(sort: Desc)])
  @@index([clientId, targetPage])
  @@schema("analyzer")
}

// Phase 5 — content/optimization brief generated from an Opportunity.
// Pure draft document — no plugin / write side-effects.
model ContentBrief {
  id                       String   @id @default(cuid())
  clientId                 String
  client                   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunityId            String?
  opportunity              Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  targetKeyword            String
  relatedQuery             String?
  relatedPage              String?

  briefType                String   // new_article | new_landing_page | optimize_existing_page | expand_existing_content | faq_section | internal_link_plan | title_meta_update
  searchIntent             String   @default("unknown") // informational | commercial | transactional | local | navigational | mixed | unknown

  recommendedTitle         String?
  recommendedMetaDescription String?
  recommendedH1            String?
  outline                  String?   // H2/H3 structure (markdown-ish or plain text)
  secondaryKeywords        String[]  @default([])
  internalLinks            String[]  @default([])   // ["sourceUrl|anchor|reason", ...]
  recommendedCTA           String?
  recommendedSchema        String?
  contentAngle             String?
  notes                    String?

  status                   String   @default("draft")  // draft | needs_human_review | approved | rejected | used

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([clientId, opportunityId, briefType])
  @@index([clientId, status])
  @@index([clientId, briefType])
  @@schema("analyzer")
}

// Audit trail for every status change / note on an Opportunity.
model OpportunityActionLog {
  id            String   @id @default(cuid())
  clientId      String
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  actionType    String   // status_change | approved | rejected | dismissed | marked_manual_applied | monitoring_started | impact_reviewed | note_added
  fromStatus    String?
  toStatus      String?
  note          String?
  createdBy     String?  // sharon@samp.ninja
  createdAt     DateTime @default(now())

  @@index([opportunityId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@schema("analyzer")
}

// Snapshot of GSC metrics at the moment an opportunity is marked as
// manually applied — the "before" half of impact review.
model ImpactBaseline {
  id              String   @id @default(cuid())
  clientId        String
  opportunityId   String   @unique
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  relatedKeyword  String?
  relatedQuery    String?
  relatedPage     String?

  baselineStartDate String  // YYYY-MM-DD
  baselineEndDate   String  // YYYY-MM-DD

  clicks          Int
  impressions     Int
  ctr             Float
  position        Float

  createdAt       DateTime @default(now())
  @@schema("analyzer")
}

// 7d / 14d / 30d post-action comparison. One row per opportunity per window.
model ImpactReview {
  id                 String   @id @default(cuid())
  clientId           String
  opportunityId      String
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  reviewWindow       String   // 7d | 14d | 30d
  reviewDate         DateTime @default(now())

  clicksBefore       Int
  clicksAfter        Int
  impressionsBefore  Int
  impressionsAfter   Int
  ctrBefore          Float
  ctrAfter           Float
  positionBefore     Float
  positionAfter      Float

  result             String   // improved | neutral | declined | needs_more_time | not_enough_data
  summary            String

  createdAt          DateTime @default(now())

  @@unique([opportunityId, reviewWindow])
  @@index([clientId, reviewDate(sort: Desc)])
  @@schema("analyzer")
}

// Phase 2 — keywords the agency is trying to rank this client for.
// Joined to GSC data on `keyword = query` for performance + opportunity views.
model TargetKeyword {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  keyword   String                                // normalized to lowercase + trimmed at write time
  intent    String?                               // commercial | informational | local | navigational | transactional | unknown
  priority  String   @default("medium")           // low | medium | high | critical
  targetUrl String?                               // the page this keyword should rank
  status    String   @default("active")           // active | paused | won | lost | needs_content | needs_optimization | not_ranking | ranking
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, keyword])
  @@index([clientId, status])
  @@index([clientId, priority])
  @@schema("analyzer")
}

// Singleton — represents the agency's one Google account used to pull GSC
// data for all clients. There's exactly one row in this table.
model GscAccount {
  id           String   @id @default(cuid())
  googleEmail  String
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("analyzer")
}

model GscDailyRow {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  date        String   // YYYY-MM-DD
  query       String
  page        String?  // populated since Phase 3; pre-Phase-3 rows are null

  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  fetchedAt   DateTime @default(now())

  @@unique([clientId, date, query, page])
  @@index([clientId, date])
  @@index([clientId, query])
  @@index([clientId, page])               // Phase 3 — per-page analysis
  @@index([clientId, query, page])        // Phase 3 — cannibalization lookups
  @@schema("analyzer")
}

model Scan {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ranAt     DateTime @default(now())

  filePath  String

  summary   String   // JSON blob

  sizeBytes Int

  durationMs Int

  findings  Finding[]

  @@index([clientId, ranAt])
  @@schema("analyzer")
}

model Finding {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  ruleId    String

  severity  String

  count     Int

  payload   String   // JSON blob

  createdAt DateTime @default(now())

  @@index([scanId, severity])
  @@index([ruleId])
  @@schema("analyzer")
}
