// Agency SEO Analyzer — schema.
//
// Hosted on the shared Supabase Postgres (same DB as the ninja-landing portal).
// All analyzer tables live in the dedicated `analyzer` schema so they don't
// collide with the portal's `public.*` tables.
//
// Storage strategy:
//   - DB holds connection metadata + scan summaries + audit findings index.
//   - Full scan JSON payloads live on disk at data/<clientId>/scan-<id>.json
//     so we can re-run the audit engine against historical scans without
//     re-pulling from the plugin.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["analyzer"]
  // Connection URLs are set in prisma.config.ts (Prisma 7 moved them out of the schema).
}

model Client {
  id         String   @id @default(cuid())
  name       String
  baseUrl    String   @unique
  token      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lastInfo   String?  // JSON blob
  lastInfoAt DateTime?

  lastScanAt DateTime?

  // GSC property assigned to this client (e.g. "sc-domain:example.com" or
  // "https://www.example.com/"). Pulled from the shared agency GscAccount.
  gscPropertyUrl  String?
  gscLastSyncAt   DateTime?

  // =====================================================================
  // SEO Profile (Phase 1) — the "business brain" of the client.
  // All optional so existing rows stay valid. Drives every downstream
  // opportunity / recommendation engine.
  // =====================================================================

  // Business context
  vertical        String?    // service | ecommerce | local_business | medical | legal | home_services | saas | content_site | other
  language        String?    // he | en | ar | multi
  country         String?    // ISO code or free text (e.g. "IL", "US")
  serviceAreas    String[]   @default([])  // cities/regions for local businesses
  seoGoals        String?    // free-text business goals

  // SEO strategy
  targetPages     String[]   @default([])  // URLs of money pages
  competitors     String[]   @default([])  // competitor domains

  // Content & brand
  brandVoice      String?    // tone description
  notes           String?    // internal notes

  // Automation & approval policy
  automationLevel    String    @default("balanced") // strict | balanced | aggressive
  requireApprovalFor String[]  @default(["publish", "title_change", "meta_change", "content_change", "internal_link", "schema_change", "wordpress_update"])

  // Phase 10 — per-client automation toggles
  status                          String  @default("active") // active | paused | archived
  automationEnabled               Boolean @default(true)
  autoGscSyncEnabled              Boolean @default(true)
  autoTechAuditEnabled            Boolean @default(true)
  autoOpportunityAnalysisEnabled  Boolean @default(true)
  autoImpactReviewEnabled         Boolean @default(true)

  // Phase 12 — per-client Execution gates. Pilot Mode is the default: an
  // installed plugin v0.3 is NOT enough to mutate the site; the agency must
  // opt this client in here AND list which actions are allowed.
  executionEnabled         Boolean  @default(false)
  executionPilotMode       Boolean  @default(true)
  allowedExecutionActions  String[] @default([]) // subset of yoast_title_update | yoast_description_update | image_alt_update

  // Phase 15C.2 — SEO Crawl Scope overrides. Per-client extensions of the
  // global defaults in lib/page-scope.ts. Each is a list of either absolute
  // URLs or path patterns (with optional leading "/", optional trailing "$"
  // for exact match). Decide order: forced target > ignored url > ignored
  // pattern > defaults. See classifyPage() for the full precedence.
  seoIgnoredUrls       String[] @default([])
  seoIgnoredPatterns   String[] @default([])
  seoForcedTargetUrls  String[] @default([])

  scans                   Scan[]
  gscDailyRows            GscDailyRow[]
  targetKeywords          TargetKeyword[]
  opportunities           Opportunity[]
  contentBriefs           ContentBrief[]
  internalLinkSuggestions InternalLinkSuggestion[]
  automationRuns          AutomationRun[]
  executionActions        ExecutionAction[]
  executionEvents         ExecutionEvent[]
  keywordStrategies       KeywordStrategy[]
  seoWorkPlans            SeoWorkPlan[]

  @@index([baseUrl])
  @@schema("analyzer")
}

// Phase 15D.0 — SEO Work Plan. A curated, grouped, risk-scored snapshot of
// the recommendation pipeline (opportunities + strategies + briefs + links)
// rolled up into a single plan the operator can approve by group.
// Invariants: only one active plan per client at a time. Building a new plan
// archives the previous one. Approval prepares safe items only — no live
// site writes, no auto Dry Run, no auto Execute.
model SeoWorkPlan {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  planType    String   @default("monthly_seo_work") // monthly_seo_work | quick_wins | technical_cleanup | meta_optimization | content_strategy | internal_links | mixed
  title       String
  status      String   @default("draft")
  // draft | needs_review | approved | preparing | prepared | partially_prepared | completed | cancelled | superseded
  summary     String?  // JSON: { byGroup: {...}, byDecision: {...}, byAutomationMode: {...} }

  totalItems          Int      @default(0)
  safeItemsCount      Int      @default(0)
  reviewItemsCount    Int      @default(0)
  blockedItemsCount   Int      @default(0)
  monitorItemsCount   Int      @default(0)

  estimatedImpact     String?  // low | medium | high — aggregate guess
  estimatedRisk       String?  // low | medium | high | critical

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  approvedAt  DateTime?
  approvedBy  String?
  preparedAt  DateTime?
  completedAt DateTime?

  items       SeoWorkPlanItem[]

  @@index([clientId, status])
  @@index([clientId, createdAt(sort: Desc)])
  @@schema("analyzer")
}

// Each row points to a source (opportunity/strategy/brief/link) and carries
// the classifier's decision so we don't recompute on every page render.
model SeoWorkPlanItem {
  id          String   @id @default(cuid())
  workPlanId  String
  workPlan    SeoWorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  clientId    String

  sourceType  String   // opportunity | keyword_strategy | content_brief | internal_link_suggestion
  sourceId    String

  // Classifier output
  group       String   // safe_meta | quick_wins | content_expansion | internal_linking | human_review | blocked | monitor_only
  decision    String   // auto_prepare | human_review | blocked | monitor_only | skip
  automationMode String  // prepare_only | manual_only

  // What we want to do with this item
  actionType  String?  // yoast_title_update | yoast_description_update | content_brief | internal_link | monitor | ...
  targetUrl   String?
  title       String
  summary     String?

  riskLevel   String   // low | medium | high | critical
  confidence  String   // low | medium | high
  priorityScore Int    @default(0)

  status      String   @default("planned")
  // planned | approved | preparing | prepared | failed | skipped | needs_human_review | completed

  reason          String?  // Hebrew: why we placed it in this group
  blockedReason   String?  // Hebrew: why it's blocked (if blocked)
  // When prepared, point at the downstream artifact for navigation.
  preparedSourceType String?  // execution_action | content_brief
  preparedSourceId   String?
  error           String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  preparedAt  DateTime?

  @@index([workPlanId, group])
  @@index([workPlanId, decision])
  @@index([clientId, status])
  @@index([sourceType, sourceId])
  @@schema("analyzer")
}

// Phase 10 — log of every automation run (cron + manual). Parent agency
// runs have clientId=null and children inherit a "parentRunId" reference
// via the source field. Failures of one client don't fail siblings.
model AutomationRun {
  id            String   @id @default(cuid())
  runType       String   // agency_auto_sync | gsc_sync | technical_audit | opportunity_analysis | impact_review | full_client_refresh
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  status        String   @default("running") // queued | running | success | partial_success | failed | skipped
  triggeredBy   String?  // 'cron' | 'manual' | actor email
  parentRunId   String?

  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  durationMs    Int?

  summary       String?  // JSON blob with counts / details
  error         String?
  skippedReason String?

  createdAt     DateTime @default(now())

  @@index([clientId, startedAt(sort: Desc)])
  @@index([runType, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([parentRunId])
  @@schema("analyzer")
}

// Phase 11 — Execution Engine. Every live change pushed to a client's
// WordPress site is materialised here. Flow is strictly 2-step:
//   1. status = draft → dry_run_ready (after successful plugin dryRun)
//   2. Sharon clicks Execute → status = executing → executed | failed
//
// Nothing executes without dryRunAt and an explicit human click. No bulk,
// no cron, no Agency-Dashboard one-tap. See lib/execution-server.ts.
model ExecutionAction {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  sourceType    String   // opportunity | content_brief | internal_link_suggestion
  sourceId      String

  actionType    String   // yoast_title_update | yoast_description_update | image_alt_update | internal_link_insert | content_snippet_insert

  status        String   @default("draft")
  // draft | dry_run_ready | dry_run_failed | awaiting_execution_approval |
  // preview_only | executing | executed | failed | cancelled |
  // rollback_available | rolled_back

  targetUrl     String?
  targetPostId  Int?
  payload       String   // JSON — proposed values + meta we'll send to the plugin
  dryRunResult  String?  // JSON — full plugin response from dryRun
  diff          String?  // JSON — before/after extracted for UI
  executionResult String? // JSON — full plugin response from execute
  auditLogId    Int?     // FK from plugin audit_log row (informational only)
  error         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  dryRunAt      DateTime?
  executedAt    DateTime?
  executedBy    String?
  cancelledAt   DateTime?
  rolledBackAt  DateTime?
  // Phase 14B — manual "I've reviewed this, no rollback needed" marker.
  // No WP call; status moves to 'finalized' and the action is closed.
  finalizedAt   DateTime?
  finalizedBy   String?
  // Phase 14C — frozen DecisionSummary at the moment Prepare Execution ran.
  // Used by Impact Review to compare actual results to the measurement plan
  // even if the underlying Opportunity has been recomputed since.
  decisionSnapshot String?

  events        ExecutionEvent[]

  @@index([clientId, status, updatedAt(sort: Desc)])
  @@index([sourceType, sourceId])
  @@index([clientId, actionType])
  @@schema("analyzer")
}

// Phase 13 — Execution telemetry feed. One row per noteworthy moment in the
// Execution Engine lifecycle. Designed as an append-only feed for UI display
// + alert dispatch. The Engine itself never reads back from this table; it's
// pure observability + alerting.
model ExecutionEvent {
  id                  String   @id @default(cuid())
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  executionActionId   String?
  executionAction     ExecutionAction? @relation(fields: [executionActionId], references: [id], onDelete: SetNull)

  eventType           String   // dry_run_completed | dry_run_failed | dry_run_stale | execution_started | execution_succeeded | execution_failed | rollback_succeeded | rollback_blocked_drift | execution_stuck | readiness_failed | plugin_unreachable | write_api_disabled | test_alert
  severity            String   @default("info") // info | success | warning | error | critical

  title               String
  message             String?
  metadata            String?  // JSON — short, sanitized

  createdAt           DateTime @default(now())

  // Alerting bookkeeping. notificationStatus values:
  // "skipped_disabled" | "skipped_severity" | "skipped_dedupe" | "sent" |
  // "partial" | "failed" | "no_channel"
  notifiedAt          DateTime?
  notificationStatus  String?
  notificationChannel String?  // 'slack' | 'email' | 'slack,email'

  @@index([clientId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([executionActionId])
  @@index([severity, createdAt(sort: Desc)])
  @@schema("analyzer")
}

// Phase 3 — SEO opportunities. Generated by detector functions over GSC,
// keyword bank, profile, and audit findings.  Compound uniqueness on
// (clientId, type, keyword, page, query) gives natural dedupe on re-runs.
model Opportunity {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type              String                       // low_ctr | quick_win_position | high_impressions_no_clicks | declining_clicks | declining_position | target_keyword_not_ranking | target_keyword_needs_content | target_keyword_needs_optimization | cannibalization | new_query_growth | technical_seo_issue | content_gap | internal_link_opportunity
  title             String
  description       String
  evidence          String                       // JSON blob — raw metrics that triggered this
  recommendedAction String

  priorityScore     Int      @default(0)         // 0-100
  impact            String   @default("medium")  // low | medium | high
  effort            String   @default("medium")  // low | medium | high
  confidence        String   @default("medium")  // low | medium | high

  status            String   @default("detected") // detected | recommended | needs_human_review | approved | rejected | dismissed | manually_applied | monitoring | impact_reviewed

  // Dedupe identity. Empty strings rather than nulls so the UNIQUE works.
  relatedKeyword    String   @default("")
  relatedPage       String   @default("")
  relatedQuery      String   @default("")

  source            String?                      // detector name / "manual"

  // Phase 4 — approval workflow + manual-apply tracking
  approvedAt          DateTime?
  approvedBy          String?
  approvalNote        String?
  approvedActionType  String?   // title_meta_update | content_update | internal_link_update | new_content | technical_fix | schema_update | manual_review | other
  rejectedAt          DateTime?
  rejectedBy          String?
  manuallyAppliedAt   DateTime?
  manuallyAppliedBy   String?
  manualActionNote    String?
  manualActionUrl     String?
  monitoringStartedAt DateTime?
  impactReviewedAt    DateTime?

  // Phase 14C — Human Review tracking. When set, decisions that would
  // otherwise be blocked (high risk / low confidence / human_review) become
  // executable. A reviewedAt without reviewedNote is allowed but discouraged.
  humanReviewedAt     DateTime?
  humanReviewedBy     String?
  humanReviewNote     String?
  // Cached decision fields for fast filtering on the workflow/agency pages
  // without recomputing the full DecisionSummary. Refreshed by the engine.
  decisionRiskCache       String?  // RiskLevel: low|medium|high|critical
  decisionConfidenceCache String?  // Confidence: low|medium|high
  decisionNextStepCache   String?  // RecommendedNextStep
  decisionComputedAt      DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  detectedAt        DateTime @default(now())

  actionLogs              OpportunityActionLog[]
  baseline                ImpactBaseline?
  impactReviews           ImpactReview[]
  contentBriefs           ContentBrief[]
  internalLinkSuggestions InternalLinkSuggestion[]

  @@unique([clientId, type, relatedKeyword, relatedPage, relatedQuery])
  @@index([clientId, status])
  @@index([clientId, priorityScore(sort: Desc)])
  @@schema("analyzer")
}

// Phase 6 — internal-linking suggestion. Heuristic graph analysis over
// scan + GSC + keyword bank. No edge data from the plugin (counts only),
// so this is a candidate-pair recommender, not a true graph mutator.
model InternalLinkSuggestion {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  sourcePage      String
  sourceTitle     String?
  targetPage      String
  targetTitle     String?
  suggestedAnchor String
  reason          String
  evidence        String   // JSON

  priorityScore   Int      @default(0)
  impact          String   @default("medium")  // low | medium | high
  effort          String   @default("low")     // low | medium | high
  confidence      String   @default("medium")  // low | medium | high
  status          String   @default("suggested") // suggested | needs_human_review | approved | rejected | used | dismissed

  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  source          String?  // detector name

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clientId, sourcePage, targetPage, suggestedAnchor])
  @@index([clientId, status])
  @@index([clientId, priorityScore(sort: Desc)])
  @@index([clientId, targetPage])
  @@schema("analyzer")
}

// Phase 5 — content/optimization brief generated from an Opportunity.
// Pure draft document — no plugin / write side-effects.
model ContentBrief {
  id                       String   @id @default(cuid())
  clientId                 String
  client                   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  opportunityId            String?
  opportunity              Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  targetKeyword            String
  relatedQuery             String?
  relatedPage              String?

  briefType                String   // new_article | new_landing_page | optimize_existing_page | expand_existing_content | faq_section | internal_link_plan | title_meta_update
  searchIntent             String   @default("unknown") // informational | commercial | transactional | local | navigational | mixed | unknown

  recommendedTitle         String?
  recommendedMetaDescription String?
  recommendedH1            String?
  outline                  String?   // H2/H3 structure (markdown-ish or plain text)
  secondaryKeywords        String[]  @default([])
  internalLinks            String[]  @default([])   // ["sourceUrl|anchor|reason", ...]
  recommendedCTA           String?
  recommendedSchema        String?
  contentAngle             String?
  notes                    String?

  status                   String   @default("draft")  // draft | needs_human_review | approved | rejected | used

  // Phase 15B — source attribution. Existing briefs (Phase 5) come from
  // Opportunity; new briefs can now come from a KeywordStrategy step.
  // sourceType lets the UI render a different back-link / badge per source.
  sourceType               String   @default("opportunity") // opportunity | keyword_strategy
  keywordStrategyId        String?
  keywordStrategy          KeywordStrategy? @relation(fields: [keywordStrategyId], references: [id], onDelete: SetNull)
  strategyStepIndex        Int?
  strategyContext          String?  // JSON: { why, riskLevel, confidence, measurementPlan, researchNotes }

  // Phase 15D bundle C — operator-level review override. When humanReviewedAt
  // is set AND humanReviewDecision="approved_for_execution", the Decision
  // Guard accepts the brief even when source strategyStep.requiresHumanReview
  // was true. Other gates (scope, plugin readiness, allowed actions, risk
  // critical) remain enforced.
  humanReviewedAt          DateTime?
  humanReviewedBy          String?
  humanReviewedNote        String?
  humanReviewDecision      String?   // approved_for_execution | needs_changes | rejected | keep_as_draft

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([clientId, opportunityId, briefType])
  @@index([clientId, status])
  @@index([clientId, briefType])
  @@index([keywordStrategyId])
  @@schema("analyzer")
}

// Audit trail for every status change / note on an Opportunity.
model OpportunityActionLog {
  id            String   @id @default(cuid())
  clientId      String
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  actionType    String   // status_change | approved | rejected | dismissed | marked_manual_applied | monitoring_started | impact_reviewed | note_added
  fromStatus    String?
  toStatus      String?
  note          String?
  createdBy     String?  // sharon@samp.ninja
  createdAt     DateTime @default(now())

  @@index([opportunityId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@schema("analyzer")
}

// Snapshot of GSC metrics at the moment an opportunity is marked as
// manually applied — the "before" half of impact review.
model ImpactBaseline {
  id              String   @id @default(cuid())
  clientId        String
  opportunityId   String   @unique
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  relatedKeyword  String?
  relatedQuery    String?
  relatedPage     String?

  baselineStartDate String  // YYYY-MM-DD
  baselineEndDate   String  // YYYY-MM-DD

  clicks          Int
  impressions     Int
  ctr             Float
  position        Float

  createdAt       DateTime @default(now())
  @@schema("analyzer")
}

// 7d / 14d / 30d post-action comparison. One row per opportunity per window.
model ImpactReview {
  id                 String   @id @default(cuid())
  clientId           String
  opportunityId      String
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  reviewWindow       String   // 7d | 14d | 30d
  reviewDate         DateTime @default(now())

  clicksBefore       Int
  clicksAfter        Int
  impressionsBefore  Int
  impressionsAfter   Int
  ctrBefore          Float
  ctrAfter           Float
  positionBefore     Float
  positionAfter      Float

  result             String   // improved | neutral | declined | needs_more_time | not_enough_data
  summary            String

  createdAt          DateTime @default(now())

  @@unique([opportunityId, reviewWindow])
  @@index([clientId, reviewDate(sort: Desc)])
  @@schema("analyzer")
}

// Phase 2 — keywords the agency is trying to rank this client for.
// Joined to GSC data on `keyword = query` for performance + opportunity views.
model TargetKeyword {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  keyword   String                                // normalized to lowercase + trimmed at write time
  intent    String?                               // commercial | informational | local | navigational | transactional | unknown
  priority  String   @default("medium")           // low | medium | high | critical
  targetUrl String?                               // the page this keyword should rank
  status    String   @default("active")           // active | paused | won | lost | needs_content | needs_optimization | not_ranking | ranking
  notes     String?
  businessValue String? // low | medium | high — operator-set commercial importance

  // Phase 15D.-1 — Master Page resolver output. Computed by refreshClient
  // (and on demand). The Master Page is the canonical URL we want to rank
  // for this keyword; rankingPage is what Google actually shows today.
  masterPage          String?
  masterPageType      String?   // category | product | service | blog_article | brand_page | homepage | landing_page | unknown
  masterPageConfidence String?  // high | medium | low | unknown
  masterPageReason    String?   // Hebrew explanation of how the resolver picked it
  rankingPage         String?   // from GSC, denormalised here for the keyword bank UI
  rankingPageType     String?   // same enum as masterPageType
  targetPageMatchStatus String? // target_matches_ranking | target_differs_from_ranking | target_missing | ranking_page_not_seo_eligible | master_page_candidate_found | needs_human_review
  recommendedPageAction String? // optimize_master_page | choose_master_page | create_supporting_article | create_new_landing_page | improve_product_page | improve_category_page | no_change | human_review | brand_protection
  pageTypeMismatch    Boolean   @default(false)
  masterPageResolvedAt DateTime?

  // Phase 15E.1 — operator-set strategic goal for this keyword. Drives Brain
  // priority + brief template choice in later phases. Stored as String for
  // consistency with intent/priority/status (no Prisma enums in this schema).
  // Allowed values (validated at write time in zod schema):
  //   improve_rank | defend_top3 | expand_content_coverage | new_landing_page |
  //   informational_authority | cannibalization_resolution | monitor_only
  keywordGoal       String?
  keywordGoalNote   String?
  keywordGoalSetAt  DateTime?
  keywordGoalSetBy  String?

  // Phase 15E.1 — manual override of the Master Page resolver. When operator
  // explicitly picks a masterPage / targetUrl we record it so the resolver
  // never overwrites it on the next refresh.
  masterPageManualOverride Boolean   @default(false)
  masterPageOverrideAt     DateTime?
  masterPageOverrideBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strategies KeywordStrategy[]

  @@unique([clientId, keyword])
  @@index([clientId, status])
  @@index([clientId, priority])
  @@schema("analyzer")
}

// Phase 14D — per-keyword strategic plan. The engine reads GSC + target
// keyword + scan and produces a roadmap of recommended steps with Why per
// step, opportunity score, and measurement plan. The strategy never executes
// anything — it's the layer that decides what *should* happen and in what
// order, then links to Opportunities / Briefs / Internal Links / Execution
// for the operator to act on each step manually.
model KeywordStrategy {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  targetKeywordId String
  targetKeyword   TargetKeyword @relation(fields: [targetKeywordId], references: [id], onDelete: Cascade)

  keyword         String   // denormalised — strategy may outlive a renamed/deleted keyword
  status          String   @default("draft") // draft | needs_human_review | approved | active | monitoring | completed | paused | rejected

  // Classification
  strategyType    String   // protect_position | quick_win | content_boost | internal_link_boost | new_content_needed | cannibalization_fix | technical_blocker | monitor_only | not_worth_targeting_now
  riskLevel       String   // low | medium | high | critical
  confidence      String   // low | medium | high
  opportunityScore Int     @default(0) // 0..100

  // Snapshot at compute time
  rankingPage       String?
  currentPosition   Float?
  currentClicks     Int?
  currentImpressions Int?
  currentCtr        Float?  // 0..1
  trend             String? // up | down | flat | unknown
  targetPageMismatch Boolean @default(false)

  // Full structured payload (JSON) — actionPlan steps, research notes,
  // measurement plan, related items. Kept as JSON so the engine can evolve
  // without migrations every time we add a step kind.
  summary         String   // Hebrew top-line recommendation
  payload         String   // JSON: { snapshot, actionPlan, researchNotes, measurementPlan, ... }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  approvedAt      DateTime?
  approvedBy      String?
  approvalNote    String?
  pausedAt        DateTime?
  completedAt    DateTime?

  contentBriefs   ContentBrief[]

  @@index([clientId, status])
  @@index([clientId, strategyType])
  @@index([clientId, opportunityScore(sort: Desc)])
  @@index([targetKeywordId])
  @@schema("analyzer")
}

// Singleton — represents the agency's one Google account used to pull GSC
// data for all clients. There's exactly one row in this table.
model GscAccount {
  id           String   @id @default(cuid())
  googleEmail  String
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("analyzer")
}

model GscDailyRow {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  date        String   // YYYY-MM-DD
  query       String
  page        String?  // populated since Phase 3; pre-Phase-3 rows are null

  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  fetchedAt   DateTime @default(now())

  @@unique([clientId, date, query, page])
  @@index([clientId, date])
  @@index([clientId, query])
  @@index([clientId, page])               // Phase 3 — per-page analysis
  @@index([clientId, query, page])        // Phase 3 — cannibalization lookups
  @@schema("analyzer")
}

model Scan {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ranAt     DateTime @default(now())

  filePath  String

  summary   String   // JSON blob

  sizeBytes Int

  durationMs Int

  findings  Finding[]

  @@index([clientId, ranAt])
  @@schema("analyzer")
}

model Finding {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  ruleId    String

  severity  String

  count     Int

  payload   String   // JSON blob

  createdAt DateTime @default(now())

  @@index([scanId, severity])
  @@index([ruleId])
  @@schema("analyzer")
}
